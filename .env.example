# Server Environment Configuration
PORT=3000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_secure_db_password
DB_DATABASE=egms_db
# CAUTION: Always keep DB_SYNCHRONIZE=false in production to prevent schema/data loss!
DB_SYNCHRONIZE=true
DB_LOGGING=false
DB_CONNECTION_LIMIT=15

# Database Seeder (Set to false or omit in production to avoid seeding demo accounts)
ALLOW_SEED=false

# Document & File Upload Storage Directory
UPLOAD_DIR=storage/uploads

# JWT Authentication
# In production, generate a secure random string: openssl rand -base64 32
JWT_SECRET=your_super_strong_random_jwt_secret_min_32_chars
JWT_EXPIRES_IN=7d

# HTTPS / Reverse Proxy Configuration
# If running behind Nginx / Cloudflare / AWS ALB, keep HTTPS=false (proxy handles SSL)
# Set HTTPS=true only if terminating SSL directly with local certificate files
HTTPS=false
SSL_KEY_PATH=certs/server.key
SSL_CERT_PATH=certs/server.crt

# Application URL (e.g. https://emgs.shop in production)
APP_URL=https://emgs.shop

# Email / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="EGMS Portal <your_email@gmail.com>"

# Company Registration Approval
# Admin email that receives approval/rejection requests for new company registrations
ADMIN_APPROVAL_EMAIL=kfahim2280@gmail.com
# How many hours the approve/reject link stays valid (default: 48)
APPROVAL_TOKEN_EXPIRY_HOURS=48
