# EGMS Production Nginx Reverse Proxy Configuration
# Place in: /etc/nginx/sites-available/egms.shop.conf
# Enable: ln -s /etc/nginx/sites-available/egms.shop.conf /etc/nginx/sites-enabled/
# Test & Reload: sudo nginx -t && sudo systemctl reload nginx

upstream egms_backend {
    server 127.0.0.1:3000;
    keepalive 64;
}

# Redirect HTTP to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name egms.shop www.egms.shop;
    return 301 https://$host$request_uri;
}

# HTTPS Server Block
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name egms.shop www.egms.shop;

    # SSL Certificate Paths (e.g. Let's Encrypt Certbot)
    # Obtain with: sudo certbot certonly --nginx -d egms.shop -d www.egms.shop
    ssl_certificate /etc/letsencrypt/live/egms.shop/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/egms.shop/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # Maximum file upload size (multi-document / image uploads)
    client_max_body_size 25M;

    # Gzip Compression for Fast Page Loads
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/rss+xml font/truetype font/opentype application/vnd.ms-fontobject image/svg+xml;

    # Static Assets Direct Serving & Browser Caching
    location /public/ {
        alias /var/www/egms/public/;
        expires 30d;
        add_header Cache-Control "public, no-transform";
        access_log off;
    }

    # Node.js NestJS Application Proxy
    location / {
        proxy_pass http://egms_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;

        # Timeouts for heavy uploads
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}

