<div class="page-header">
  <div class="header-content">
    <a href="/customers" style="color: var(--color-text-muted); text-decoration: none; font-size: 0.875rem; display: inline-flex; align-items: center; gap: 0.25rem; margin-bottom: 0.5rem;">
      &larr; {{t 'customers.subtitle'}}
    </a>
    <div style="display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;">
      <div class="user-avatar-wrapper previewable-avatar"
           data-preview-img="{{profilePicUrl customer}}"
           data-preview-name="{{customer.name}}"
           data-preview-code="{{customer.customerCode}}"
           data-preview-badge="{{#if customer.garageName}}🏢 {{customer.garageName}}{{/if}}"
           data-preview-sub="ID: #{{#if customer.cId}}{{bnNum customer.cId}}{{else}}{{customer.id}}{{/if}} • 📞 {{customer.mobileNumber}}"
           title="{{#if (profilePicUrl customer)}}{{t 'profile.clickToEnlarge'}}{{else}}{{customer.name}}{{/if}}"
           style="width: 58px; height: 58px; border-radius: 50%; flex-shrink: 0; box-shadow: var(--shadow-sm); cursor: {{#if (profilePicUrl customer)}}pointer{{else}}default{{/if}};">
        {{#if (profilePicUrl customer)}}
          <img src="{{profilePicUrl customer}}" alt="{{customer.name}}" class="table-avatar-img" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;" />
          <span class="avatar-zoom-badge" style="width: 18px; height: 18px; bottom: 0; right: 0;">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          </span>
        {{else}}
          <div class="table-avatar-initials avatar-gradient-1" style="width: 100%; height: 100%; font-size: 1.4rem; font-weight: 700;">
            {{firstChar customer.name}}
          </div>
        {{/if}}
      </div>
      <div>
        <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
          <h1 class="page-title" style="margin-bottom: 0;">{{customer.name}}</h1>
          {{#if customer.customerCode}}
          <span class="badge" style="background: rgba(20, 184, 166, 0.15); color: #2dd4bf; border: 1px solid rgba(20,184,166,0.3); font-size: 0.9rem; font-weight: 700; padding: 0.25rem 0.65rem; border-radius: 6px; letter-spacing: 0.04em;">{{customer.customerCode}}</span>
          {{/if}}
          {{#if customer.isActive}}
          <span class="badge" style="background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3); font-size: 0.85rem; font-weight: 600; padding: 0.25rem 0.65rem; border-radius: 6px;">
            ● {{t 'customers.active'}}
          </span>
          {{else}}
          <span class="badge" style="background: rgba(239, 68, 68, 0.15); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.3); font-size: 0.85rem; font-weight: 700; padding: 0.25rem 0.65rem; border-radius: 6px;">
            🚫 {{t 'customers.suspended'}}
          </span>
          {{/if}}
        </div>
        <p class="page-subtitle" style="margin-top: 0.35rem;">
          {{#if customer.customerCode}}
            Customer ID: <strong style="color: #2dd4bf;">{{customer.customerCode}}</strong> &bull;
          {{/if}}
          System #{{#if customer.cId}}{{bnNum customer.cId}}{{else}}{{bnNum customer.id}}{{/if}} &bull; {{t 'common.registered'}}: {{tDate customer.createdDate}}
        </p>
      </div>
    </div>
  </div>
  <div class="header-actions">
    {{#if isSuperAdmin}}
      {{#if customer.isActive}}
      <form id="suspendCustomerHeaderForm" action="/customers/{{customer.id}}/toggle-status" method="POST" style="display: inline; margin: 0;">
        <button type="button" class="btn" style="background: rgba(245, 158, 11, 0.15); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.35); font-weight: 600;" onclick="triggerCustomerSuspendModal('suspendCustomerHeaderForm')">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 0.35rem;"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
          {{t 'customers.suspendAction'}}
        </button>
      </form>
      {{else}}
      <form id="reactivateCustomerHeaderForm" action="/customers/{{customer.id}}/toggle-status" method="POST" style="display: inline; margin: 0;">
        <button type="button" class="btn" style="background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.35); font-weight: 600;" onclick="triggerCustomerReactivateModal('reactivateCustomerHeaderForm')">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 0.35rem;"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          {{t 'customers.reactivateAction'}}
        </button>
      </form>
      {{/if}}
    {{/if}}
    {{#if (or isSuperAdmin currentUser.canCreate)}}
      {{#if (and customer.isActive (not customer.isGarageSuspended))}}
      <a href="/bills/new?customerId={{customer.id}}" class="btn btn-primary" style="background: #10b981; border-color: #10b981;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="12" y1="5" x2="12" y2="19"/>
          <line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        {{t 'bills.newBill'}}
      </a>
      {{else if customer.isGarageSuspended}}
      <button type="button" class="btn btn-secondary" style="opacity: 0.5; cursor: not-allowed;" title="{{t 'bills.garageSuspendedNotice'}}" disabled>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="12" y1="5" x2="12" y2="19"/>
          <line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        {{t 'bills.newBill'}} ({{t 'bills.garageSuspendedNoticeShort'}})
      </button>
      {{else}}
      <button type="button" class="btn btn-secondary" style="opacity: 0.5; cursor: not-allowed;" title="{{t 'customers.suspendedNoticeShort'}}" disabled>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="12" y1="5" x2="12" y2="19"/>
          <line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        {{t 'bills.newBill'}} ({{t 'customers.suspended'}})
      </button>
      {{/if}}
    {{/if}}
    {{#if (or isSuperAdmin currentUser.canEdit)}}
    <a href="/customers/{{customer.id}}/edit" class="btn btn-secondary">
      {{t 'customers.updateProfile'}}
    </a>
    {{/if}}
  </div>
</div>

{{#unless customer.isActive}}
<div class="card" style="margin-bottom: 1.5rem; background: rgba(239, 68, 68, 0.08); border: 1px solid rgba(239, 68, 68, 0.25); border-left: 4px solid #ef4444; padding: 1rem 1.25rem;">
  <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
    <div style="display: flex; align-items: center; gap: 0.75rem;">
      <div style="font-size: 1.75rem; line-height: 1;">🚫</div>
      <div>
        <div style="font-weight: 700; color: #ef4444; font-size: 1.05rem;">{{t 'customers.suspendedNoticeShort'}}</div>
        <div style="color: var(--color-text-secondary); font-size: 0.9rem; margin-top: 0.15rem;">{{t 'customers.suspendedNotice'}}</div>
      </div>
    </div>
    {{#if isSuperAdmin}}
    <form id="bannerReactivateCustomerForm" action="/customers/{{customer.id}}/toggle-status" method="POST" style="margin: 0;">
      <button type="button" class="btn btn-success" style="background: #10b981; border-color: #10b981; font-weight: 600;" onclick="triggerCustomerReactivateModal('bannerReactivateCustomerForm')">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="margin-right: 0.35rem;"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        {{t 'customers.reactivateAction'}}
      </button>
    </form>
    {{/if}}
  </div>
</div>
{{/unless}}

{{#if customer.isGarageSuspended}}
<div class="card" style="margin-bottom: 1.5rem; background: rgba(239, 68, 68, 0.08); border: 1px solid rgba(239, 68, 68, 0.25); border-left: 4px solid #ef4444; padding: 1rem 1.25rem;">
  <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
    <div style="display: flex; align-items: center; gap: 0.75rem;">
      <div style="font-size: 1.75rem; line-height: 1;">🏪🚫</div>
      <div>
        <div style="font-weight: 700; color: #ef4444; font-size: 1.05rem;">{{t 'bills.garageSuspendedNoticeShort'}}</div>
        <div style="color: var(--color-text-secondary); font-size: 0.9rem; margin-top: 0.15rem;">{{t 'bills.garageSuspendedNotice'}}</div>
      </div>
    </div>
    {{#if customer.garageId}}
    <a href="/garages/{{customer.garageId}}" class="btn btn-secondary" style="font-size: 0.85rem; padding: 0.4rem 0.75rem;">
      {{t 'garages.viewGarage'}}
    </a>
    {{/if}}
  </div>
</div>
{{/if}}

<!-- Profile Info Grid -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
  <div class="card" style="padding: 1.25rem;">
    <div style="font-size: 0.8rem; text-transform: uppercase; color: var(--color-text-muted); letter-spacing: 0.05em; margin-bottom: 0.5rem;">Customer ID &amp; {{t 'phones.title'}}</div>
    <div style="font-size: 1.05rem; font-weight: 700; color: var(--color-text-primary); margin-bottom: 0.35rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem;">
      {{#if customer.customerCode}}
        <span style="color: #2dd4bf; background: rgba(45, 212, 191, 0.1); padding: 0.15rem 0.5rem; border-radius: 4px; font-size: 0.9rem;">{{customer.customerCode}}</span>
      {{/if}}
      <a href="tel:{{customer.mobileNumber}}" style="color: #38bdf8; text-decoration: none; display: inline-flex; align-items: center; gap: 0.35rem;">
        📞 {{customer.mobileNumber}}
      </a>
      <span class="badge" style="background: rgba(16, 185, 129, 0.15); color: #34d399; font-size: 0.72rem; padding: 2px 6px; border-radius: 12px;">{{t 'phones.primary'}}</span>
    </div>

    {{#if customer.phoneNumbers}}
      {{#if (gt customer.phoneNumbers.length 1)}}
        <div style="display: flex; flex-direction: column; gap: 0.35rem; margin-top: 0.4rem; padding-top: 0.4rem; border-top: 1px solid rgba(255, 255, 255, 0.08);">
          {{#each customer.phoneNumbers}}
            {{#unless this.isPrimary}}
              <div style="display: flex; align-items: center; justify-content: space-between; font-size: 0.82rem; background: rgba(255, 255, 255, 0.03); padding: 0.25rem 0.5rem; border-radius: 4px;">
                <span style="display: flex; align-items: center; gap: 0.35rem;">
                  <a href="tel:{{this.number}}" style="color: var(--color-text-secondary); text-decoration: none;">📞 {{this.number}}</a>
                  <span style="font-size: 0.68rem; color: var(--color-text-muted); background: rgba(255, 255, 255, 0.08); padding: 1px 5px; border-radius: 10px;">{{this.type}}</span>
                </span>
                {{#if (eq this.type 'WHATSAPP')}}
                  <a href="https://wa.me/88{{this.number}}" target="_blank" rel="noopener" style="color: #22c55e; font-size: 0.75rem; text-decoration: none; font-weight: 600;">WhatsApp 💬</a>
                {{/if}}
              </div>
            {{/unless}}
          {{/each}}
        </div>
      {{/if}}
    {{/if}}

    <div style="color: var(--color-text-muted); font-size: 0.85rem; margin-top: 0.5rem;">NID: <code style="color: var(--color-text-secondary);">{{customer.nidNumber}}</code></div>
  </div>

  <div class="card" style="padding: 1.25rem;">
    <div style="font-size: 0.8rem; text-transform: uppercase; color: var(--color-text-muted); letter-spacing: 0.05em; margin-bottom: 0.5rem;">{{t 'customers.fatherName'}} &amp; {{t 'customers.motherName'}}</div>
    <div style="font-size: 0.95rem; color: var(--color-text-primary); margin-bottom: 0.25rem;"><strong>{{t 'customers.fatherName'}}:</strong> {{#if customer.fatherName}}{{customer.fatherName}}{{else}}{{t 'common.na'}}{{/if}}</div>
    <div style="font-size: 0.95rem; color: var(--color-text-primary);"><strong>{{t 'customers.motherName'}}:</strong> {{#if customer.motherName}}{{customer.motherName}}{{else}}{{t 'common.na'}}{{/if}}</div>
  </div>

  <div class="card" style="padding: 1.25rem;">
    <div style="font-size: 0.8rem; text-transform: uppercase; color: var(--color-text-muted); letter-spacing: 0.05em; margin-bottom: 0.5rem;">{{t 'customers.garage'}}</div>
    {{#if customer.garageId}}
      <div style="font-size: 1.1rem; font-weight: 700; color: #60a5fa; margin-bottom: 0.25rem;">
        🏢 {{customer.garageName}}
      </div>
      <div>
        <a href="/garages/{{customer.garageId}}" class="btn btn-secondary btn-sm" style="font-size: 0.75rem; padding: 2px 8px; margin-top: 0.25rem;">
          {{t 'garages.viewDashboard'}} &rarr;
        </a>
      </div>
    {{else}}
      <div style="color: var(--color-text-muted); font-size: 0.95rem;">{{t 'common.na'}}</div>
    {{/if}}
  </div>

  <div class="card" style="padding: 1.25rem;">
    <div style="font-size: 0.8rem; text-transform: uppercase; color: var(--color-text-muted); letter-spacing: 0.05em; margin-bottom: 0.5rem;">{{t 'customers.baselineMeter'}}</div>
    <div style="font-size: 1.25rem; font-weight: 700; color: #38bdf8; margin-bottom: 0.25rem;">{{bnNum customer.previousUnit}} {{t 'common.units'}}</div>
    <div style="color: var(--color-text-muted); font-size: 0.85rem;">{{t 'customers.initialMeter'}}</div>
  </div>

  <div class="card" style="padding: 1.25rem;">
    <div style="font-size: 0.8rem; text-transform: uppercase; color: var(--color-text-muted); letter-spacing: 0.05em; margin-bottom: 0.5rem;">{{t 'customers.advanceMoney'}}</div>
    <div style="font-size: 1.25rem; font-weight: 700; color: #10b981; margin-bottom: 0.25rem;">{{t 'common.currency'}}{{bnNum customer.advanceMoney}}</div>
    <div style="color: var(--color-text-muted); font-size: 0.85rem;">{{t 'customers.presentDues'}}: {{t 'common.currency'}}{{bnNum customer.presentDues}}</div>
  </div>
</div>

<div class="card" style="margin-bottom: 2rem; padding: 1.25rem;">
  <div style="font-size: 0.8rem; text-transform: uppercase; color: var(--color-text-muted); letter-spacing: 0.05em; margin-bottom: 0.25rem;">{{t 'customers.address'}}</div>
  <div style="font-size: 1rem; color: var(--color-text-primary);">{{customer.address}}</div>
</div>

<style>
  .doc-section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 1.15rem 1.4rem;
  }
  .doc-header-info {
    min-width: 0;
    flex: 1 1 auto;
  }
  .doc-header-title {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.35;
  }
  .doc-header-icon {
    font-size: 1.2rem;
    line-height: 1;
    display: inline-flex;
    align-items: center;
  }
  .doc-header-text {
    color: var(--color-text-primary, #ffffff);
  }
  .doc-header-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(99, 102, 241, 0.15);
    border: 1px solid rgba(99, 102, 241, 0.35);
    color: #818cf8;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 1px 7px;
    border-radius: 9999px;
    line-height: 1.2;
  }
  .doc-header-subtitle {
    color: var(--color-text-muted, #94a3b8);
    font-size: 0.82rem;
    margin: 0.25rem 0 0 0;
    line-height: 1.35;
  }
  .doc-header-upload-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    font-weight: 600;
    white-space: nowrap;
    transition: all 0.2s ease;
  }
  .doc-section-body {
    padding: 1.25rem;
    box-sizing: border-box;
  }

  @media (max-width: 576px) {
    .doc-section-header {
      padding: 0.85rem 0.85rem !important;
      flex-direction: column;
      align-items: stretch !important;
      gap: 0.75rem !important;
    }
    .doc-header-title {
      font-size: 0.95rem !important;
    }
    .doc-header-subtitle {
      font-size: 0.76rem !important;
    }
    .doc-header-upload-btn {
      width: 100% !important;
      height: 38px !important;
      font-size: 0.85rem !important;
      border-radius: var(--radius-md) !important;
    }
    .doc-section-body {
      padding: 0.75rem 0.85rem !important;
    }
    .modal-responsive-card {
      padding: 1.15rem 0.85rem !important;
    }
  }

  @media (max-width: 360px) {
    .doc-section-header {
      padding: 0.75rem 0.65rem !important;
    }
    .doc-section-body {
      padding: 0.65rem 0.65rem !important;
    }
    .doc-header-title {
      font-size: 0.88rem !important;
    }
  }

  [data-theme="light"] .doc-header-text {
    color: #0f172a;
  }
  [data-theme="light"] .doc-header-count {
    background: #e0e7ff;
    border-color: #c7d2fe;
    color: #4338ca;
  }
  [data-theme="light"] .doc-header-subtitle {
    color: #64748b;
  }
</style>

<!-- Customer Documents & Attachments Section -->
<div class="card doc-section-card" style="margin-bottom: 2rem;">
  <div class="card-header doc-section-header">
    <div class="doc-header-info">
      <h2 class="card-title doc-header-title">
        <span class="doc-header-icon">📁</span>
        <span class="doc-header-text">{{t 'documents.title'}}</span>
        {{#if customer.documents.length}}
          <span class="doc-header-count">({{bnNum customer.documents.length}})</span>
        {{/if}}
      </h2>
      <p class="doc-header-subtitle">{{t 'documents.subtitle'}}</p>
    </div>
    {{#if (or isSuperAdmin currentUser.canEdit currentUser.canCreate)}}
    <button type="button" class="btn btn-primary btn-sm doc-header-upload-btn" onclick="document.getElementById('uploadCustomerDocModal').style.display='flex'">
      <span>+</span> <span>{{t 'documents.upload'}}</span>
    </button>
    {{/if}}
  </div>

  <div class="card-body doc-section-body">
    {{> document-list documents=customer.documents deleteUrlPrefix=(concat "/customers/" customer.id "/documents") canDelete=(or isSuperAdmin currentUser.canDelete)}}
  </div>
</div>

<!-- Guarantors / জামিনদারবৃন্দ Section -->
<div class="card" style="margin-bottom: 2rem;">
  <div class="card-header doc-section-header">
    <div class="doc-header-info">
      <h2 class="card-title doc-header-title">
        <span class="doc-header-icon">🛡️</span>
        <span class="doc-header-text">{{t 'guarantors.title'}}</span>
        <span class="doc-header-count">({{bnNum customer.guarantors.length}})</span>
      </h2>
      <p class="doc-header-subtitle">{{t 'guarantors.subtitle'}}</p>
    </div>
    {{#if (or isSuperAdmin currentUser.canCreate)}}
    <button type="button" class="btn btn-primary btn-sm doc-header-upload-btn" onclick="document.getElementById('addGuarantorModal').style.display='flex'">
      <span>+</span> <span>{{t 'guarantors.add'}}</span>
    </button>
    {{/if}}
  </div>

  {{#if customer.guarantors.length}}
    <div class="card-body doc-section-body" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 1.25rem;">
      {{#each customer.guarantors}}
        <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 1.25rem; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.75rem;">
              <div>
                <div style="font-size: 1.1rem; font-weight: 700; color: var(--color-text-primary);">{{this.name}}</div>
                {{#if this.relationship}}
                  <span class="badge" style="background: rgba(99, 102, 241, 0.15); color: #818cf8; font-size: 0.75rem; margin-top: 0.25rem;">
                    {{this.relationship}}
                  </span>
                {{/if}}
              </div>
              <div class="table-actions-group">
                {{#if (or ../isSuperAdmin ../currentUser.canEdit)}}
                <a href="/customers/{{../customer.id}}/guarantors/{{this.id}}/edit" class="btn btn-secondary btn-icon-action" title="{{t 'common.edit'}}" aria-label="{{t 'common.edit'}}">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                </a>
                {{/if}}
                {{#if (or ../isSuperAdmin ../currentUser.canDelete)}}
                <form action="/customers/{{../customer.id}}/guarantors/{{this.id}}/delete" method="POST" style="display: inline;" onsubmit="return confirm('Remove this guarantor?');">
                  <button type="submit" class="btn btn-danger btn-icon-action" title="{{t 'common.delete'}}" aria-label="{{t 'common.delete'}}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                  </button>
                </form>
                {{/if}}
              </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 0.75rem; font-size: 0.85rem;">
              <div>
                <div style="color: var(--color-text-muted); font-size: 0.75rem; text-transform: uppercase;">{{t 'phones.title'}}</div>
                <div style="color: var(--color-text-secondary); font-weight: 600; display: flex; align-items: center; gap: 0.35rem; flex-wrap: wrap;">
                  <a href="tel:{{this.mobileNumber}}" style="color: #38bdf8; text-decoration: none;">📞 {{this.mobileNumber}}</a>
                  <span style="font-size: 0.65rem; color: #34d399; background: rgba(16, 185, 129, 0.15); padding: 1px 5px; border-radius: 8px;">{{t 'phones.primary'}}</span>
                </div>
                {{#if this.phoneNumbers}}
                  {{#if (gt this.phoneNumbers.length 1)}}
                    <div style="display: flex; flex-direction: column; gap: 0.2rem; margin-top: 0.35rem;">
                      {{#each this.phoneNumbers}}
                        {{#unless this.isPrimary}}
                          <div style="font-size: 0.75rem; display: flex; align-items: center; gap: 0.3rem;">
                            <a href="tel:{{this.number}}" style="color: var(--color-text-muted); text-decoration: none;">📞 {{this.number}}</a>
                            <span style="font-size: 0.65rem; color: var(--color-text-muted); background: rgba(255, 255, 255, 0.08); padding: 1px 4px; border-radius: 4px;">{{this.type}}</span>
                          </div>
                        {{/unless}}
                      {{/each}}
                    </div>
                  {{/if}}
                {{/if}}
              </div>
              <div>
                <div style="color: var(--color-text-muted); font-size: 0.75rem; text-transform: uppercase;">{{t 'guarantors.nid'}}</div>
                <code style="color: #93c5fd; font-size: 0.8rem;">{{this.nidNumber}}</code>
              </div>
              {{#if this.fatherName}}
              <div>
                <div style="color: var(--color-text-muted); font-size: 0.75rem; text-transform: uppercase;">{{t 'guarantors.fatherName'}}</div>
                <div style="color: var(--color-text-secondary);">{{this.fatherName}}</div>
              </div>
              {{/if}}
              {{#if this.motherName}}
              <div>
                <div style="color: var(--color-text-muted); font-size: 0.75rem; text-transform: uppercase;">{{t 'guarantors.motherName'}}</div>
                <div style="color: var(--color-text-secondary);">{{this.motherName}}</div>
              </div>
              {{/if}}
            </div>

            <div style="font-size: 0.85rem; border-top: 1px solid rgba(255, 255, 255, 0.05); padding-top: 0.5rem;">
              <span style="color: var(--color-text-muted); font-size: 0.75rem; text-transform: uppercase;">{{t 'guarantors.address'}}:</span>
              <span style="color: var(--color-text-secondary);"> {{this.address}}</span>
            </div>

            <div style="margin-top: 0.85rem; padding-top: 0.85rem; border-top: 1px solid rgba(255, 255, 255, 0.08);">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                <span style="color: var(--color-text-muted); font-size: 0.75rem; text-transform: uppercase; font-weight: 600;">
                  📎 {{t 'documents.title'}} {{#if this.documents.length}}({{bnNum this.documents.length}}){{/if}}
                </span>
                {{#if (or ../isSuperAdmin ../currentUser.canEdit)}}
                <button type="button" class="btn btn-secondary btn-sm" style="font-size: 0.72rem; padding: 2px 7px;" onclick="openGuarantorUploadModal('{{this.id}}', '{{this.name}}')">
                  + {{t 'documents.upload'}}
                </button>
                {{/if}}
              </div>
              {{> document-list documents=this.documents deleteUrlPrefix=(concat "/customers/" ../customer.id "/guarantors/" this.id "/documents") canDelete=(or ../isSuperAdmin ../currentUser.canDelete)}}
            </div>
          </div>
        </div>
      {{/each}}
    </div>
  {{else}}
    <div style="text-align: center; padding: 2.5rem 1rem;">
      <div style="font-size: 2rem; margin-bottom: 0.5rem;">🛡️</div>
      <h3 style="color: var(--color-text-primary); font-size: 1rem; font-weight: 600; margin-bottom: 0.25rem;">{{t 'guarantors.noGuarantors'}}</h3>
      <p style="color: var(--color-text-muted); font-size: 0.85rem; margin-bottom: 1rem;">{{t 'guarantors.noGuarantorsSub'}}</p>
      {{#if (or isSuperAdmin currentUser.canCreate)}}
      <button type="button" class="btn btn-primary btn-sm" onclick="document.getElementById('addGuarantorModal').style.display='flex'">
        + {{t 'guarantors.add'}}
      </button>
      {{/if}}
    </div>
  {{/if}}
</div>

<!-- Customer Bills Ledger Section -->
<div class="card" id="bills-section" style="margin-top: 1.5rem; padding: 0; overflow: hidden; border-radius: var(--radius-lg); box-shadow: var(--shadow-sm);">
  <!-- Section Header -->
  <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; padding: 1.15rem 1.4rem; border-bottom: 1px solid var(--color-border); background: rgba(15, 23, 42, 0.4);">
    <div style="display: flex; align-items: center; gap: 0.65rem;">
      <h2 style="margin: 0; font-size: 1.15rem; font-weight: 700; color: var(--color-text-primary); display: flex; align-items: center; gap: 0.45rem;">
        <span style="display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 6px; background: rgba(56, 189, 248, 0.15); color: #38bdf8;">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        </span>
        {{t 'bills.title'}}
        <span class="badge" style="background: rgba(99, 102, 241, 0.15); color: #818cf8; font-size: 0.8rem; padding: 2px 8px; border-radius: 9999px;">
          {{bnNum bills.length}}
        </span>
      </h2>
      {{#if (or fromDate toDate)}}
        <span class="badge" style="background: rgba(56, 189, 248, 0.15); color: #38bdf8; font-size: 0.75rem; padding: 2px 8px; border-radius: 12px;">
          {{#if isBn}}ফিল্টার সক্রিয়{{else}}Filter Active{{/if}}
        </span>
      {{/if}}
    </div>
    <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
      {{#if (or isSuperAdmin currentUser.canCreate)}}
        {{#if (and customer.isActive (not customer.isGarageSuspended))}}
          <a href="/bills/new?customerId={{customer.id}}" class="btn btn-primary btn-sm" style="background: #10b981; border-color: #10b981; display: inline-flex; align-items: center; gap: 0.35rem; font-weight: 600;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            {{t 'bills.newBill'}}
          </a>
        {{else}}
          <button type="button" class="btn btn-secondary btn-sm" style="opacity: 0.5; cursor: not-allowed; display: inline-flex; align-items: center; gap: 0.35rem;" title="{{#if customer.isGarageSuspended}}{{t 'bills.garageSuspendedNotice'}}{{else}}{{t 'customers.suspendedNoticeShort'}}{{/if}}" disabled>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            {{t 'bills.newBill'}}
          </button>
        {{/if}}
      {{/if}}
    </div>
  </div>

  <!-- Collapsible Filter Bar -->
  <div style="padding: 0.85rem 1.4rem; background: rgba(0, 0, 0, 0.02); border-bottom: 1px solid var(--color-border);" id="bills-filter">
    <form id="customerBillsFilter" method="GET" action="/customers/{{customer.id}}#bills-filter" style="display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center; justify-content: space-between;">
      <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center;">
        <!-- Date from -->
        <div style="display: inline-flex; align-items: center; gap: 0.35rem;">
          <span style="font-size: 0.78rem; color: var(--color-text-muted);">{{#if isBn}}শুরু:{{else}}From:{{/if}}</span>
          <input type="date" name="fromDate" value="{{fromDate}}" class="form-input" style="padding: 0.35rem 0.65rem; font-size: 0.82rem; width: auto; border-radius: var(--radius-sm);" onchange="document.getElementById('customerBillsFilter_preset').value='';">
        </div>
        <!-- Date to -->
        <div style="display: inline-flex; align-items: center; gap: 0.35rem;">
          <span style="font-size: 0.78rem; color: var(--color-text-muted);">{{#if isBn}}শেষ:{{else}}To:{{/if}}</span>
          <input type="date" name="toDate" value="{{toDate}}" class="form-input" style="padding: 0.35rem 0.65rem; font-size: 0.82rem; width: auto; border-radius: var(--radius-sm);" onchange="document.getElementById('customerBillsFilter_preset').value='';">
        </div>
        <button type="submit" class="btn btn-secondary btn-sm" style="padding: 0.35rem 0.75rem; font-size: 0.82rem;">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          {{#if isBn}}ফিল্টার{{else}}Filter{{/if}}
        </button>
        {{#if (or fromDate toDate)}}
          <a href="/customers/{{customer.id}}#bills-section" class="btn btn-secondary btn-sm" style="padding: 0.35rem 0.65rem; font-size: 0.82rem; color: #ef4444;" title="{{t 'common.reset'}}">
            ✕ {{#if isBn}}রিসেট{{else}}Reset{{/if}}
          </a>
        {{/if}}
      </div>

      <!-- Presets -->
      <div class="dfb-presets" style="margin: 0; padding: 0; border: none; display: flex; gap: 0.35rem; flex-wrap: wrap;">
        <button type="button" class="dfb-preset-pill {{#if (eq preset 'thisMonth')}}dfb-preset-active{{/if}}" onclick="setDatePreset('thisMonth','customerBillsFilter')">{{#if isBn}}এই মাস{{else}}This Month{{/if}}</button>
        <button type="button" class="dfb-preset-pill {{#if (eq preset 'lastMonth')}}dfb-preset-active{{/if}}" onclick="setDatePreset('lastMonth','customerBillsFilter')">{{#if isBn}}গত মাস{{else}}Last Month{{/if}}</button>
        <button type="button" class="dfb-preset-pill {{#if (eq preset 'last30')}}dfb-preset-active{{/if}}" onclick="setDatePreset('last30','customerBillsFilter')">{{#if isBn}}শেষ ৩০ দিন{{else}}Last 30 Days{{/if}}</button>
        <button type="button" class="dfb-preset-pill {{#if (eq preset 'thisYear')}}dfb-preset-active{{/if}}" onclick="setDatePreset('thisYear','customerBillsFilter')">{{#if isBn}}এই বছর{{else}}This Year{{/if}}</button>
        <button type="button" class="dfb-preset-pill {{#if (eq preset 'all')}}dfb-preset-active{{/if}}" onclick="setDatePreset('all','customerBillsFilter')">{{#if isBn}}সব{{else}}All{{/if}}</button>
      </div>
      <input type="hidden" name="preset" id="customerBillsFilter_preset" value="{{preset}}">
    </form>
  </div>

  {{#if bills.length}}
    <!-- Desktop Table View (> 768px) -->
    <div class="table-responsive desktop-bills-table">
      <table class="data-table bills-ledger-table">
        <thead>
          <tr>
            <th style="width: 90px;">{{t 'common.date'}}</th>
            <th class="th-num" style="width: 75px;" title="{{t 'bills.prevUnit'}}">{{#if isBn}}পূর্ব রিডিং{{else}}Prev{{/if}}</th>
            <th class="th-num" style="width: 75px;" title="{{t 'bills.currUnit'}}">{{#if isBn}}বর্তমান রিডিং{{else}}Curr{{/if}}</th>
            <th class="th-num" style="width: 85px; text-align: center; white-space: nowrap;">{{t 'bills.consumed'}}</th>
            <th class="th-num" style="width: 85px;">{{t 'bills.electricBill'}}</th>
            <th class="th-num" style="width: 80px;">{{#if isBn}}পূর্ব বকেয়া{{else}}Prev Dues{{/if}}</th>
            <th class="th-num" style="width: 65px;">{{t 'bills.rent'}}</th>
            <th class="th-num" style="width: 65px;">{{t 'bills.loan'}}</th>
            <th class="th-num" style="width: 90px;">{{#if isBn}}সর্বমোট{{else}}Total{{/if}}</th>
            <th class="th-num" style="width: 85px;">{{#if isBn}}পরিশোধ{{else}}Paid{{/if}}</th>
            <th class="th-num" style="width: 115px; text-align: right; white-space: nowrap;">{{t 'bills.presentDues'}}</th>
            <th style="width: 90px; text-align: right;">{{t 'common.actions'}}</th>
          </tr>
        </thead>
        <tbody>
          {{#each bills}}
            <tr class="{{#if this.isLatestBill}}row-latest-bill{{else}}row-archived-bill{{/if}}" style="border-bottom: 1px solid var(--color-border); transition: background 0.15s;">
              <td><span class="date-badge-pill">{{tDate this.date}}</span></td>
              <td class="cell-num">{{bnMoney this.previousUnit}}</td>
              <td class="cell-num font-semibold">{{bnMoney this.currentUnit}}</td>
              <td style="text-align: center; white-space: nowrap;">
                <span class="badge-consumed-units">{{bnMoney this.totalUnit}} {{t 'common.unitShort'}}</span>
              </td>
              <td class="cell-num">{{bnMoney this.electricBill}}</td>
              <td class="cell-num cell-muted-due">
                {{#if (gt this.previousDues 0)}}
                  <span class="text-due-prev">{{bnMoney this.previousDues}}</span>
                {{else}}
                  <span class="cell-dash">—</span>
                {{/if}}
              </td>
              <td class="cell-num">
                {{#if (gt this.rentBill 0)}}
                  {{bnMoney this.rentBill}}
                {{else}}
                  <span class="cell-dash">—</span>
                {{/if}}
              </td>
              <td class="cell-num">
                {{#if (gt this.loan 0)}}
                  {{bnMoney this.loan}}
                {{else}}
                  <span class="cell-dash">—</span>
                {{/if}}
              </td>
              <td class="cell-num font-bold text-accent">{{bnMoney this.totalBill}}</td>
              <td class="cell-num">
                {{#if (gt this.clearMoney 0)}}
                  <span class="text-success font-semibold">{{bnMoney this.clearMoney}}</span>
                {{else}}
                  <span class="cell-dash">—</span>
                {{/if}}
              </td>
              <td class="cell-num" style="text-align: right; white-space: nowrap;">
                {{#if (gt this.presentDues 0)}}
                  <span class="dues-badge dues-has-due">
                    ৳{{bnMoney this.presentDues}}
                  </span>
                {{else}}
                  {{#if (lt this.presentDues 0)}}
                    <span class="dues-badge dues-advance">
                      ৳{{bnMoney (subtract 0 this.presentDues)}} {{#if ../isBn}}অগ্রিম{{else}}Adv{{/if}}
                    </span>
                  {{else}}
                    <span class="dues-badge dues-cleared">
                      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                      {{#if ../isBn}}পরিশোধিত{{else}}Cleared{{/if}}
                    </span>
                  {{/if}}
                {{/if}}
              </td>
              <td style="text-align: right; white-space: nowrap;">
                <div class="table-actions-group">
                  <!-- Receipt button -->
                  <a href="/bills/{{this.id}}" class="btn btn-secondary btn-icon-action" title="{{t 'bills.receipt'}}" aria-label="{{t 'bills.receipt'}}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                  </a>

                  {{#if this.isLatestBill}}
                    <!-- Only latest bill is editable -->
                    {{#if (or ../isSuperAdmin ../currentUser.canEdit)}}
                      <a href="/bills/{{this.id}}/edit" class="btn btn-secondary btn-icon-action btn-action-edit" title="{{t 'common.edit'}}" aria-label="{{t 'common.edit'}}">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                      </a>
                    {{/if}}
                    <!-- Only latest bill is deletable -->
                    {{#if (or ../isSuperAdmin ../currentUser.canDelete)}}
                      <form action="/bills/{{this.id}}/delete" method="POST" style="display: inline;" onsubmit="return confirm('{{t 'bills.confirmDelete'}}');">
                        <button type="submit" class="btn btn-icon-action btn-action-delete" title="{{t 'common.delete'}}" aria-label="{{t 'common.delete'}}">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                        </button>
                      </form>
                    {{/if}}
                  {{else}}
                    <!-- Archived bill lock icon -->
                    <span class="btn-icon-action action-locked-pill" title="{{#if ../isBn}}পূর্ববর্তী রেকর্ড - শুধুমাত্র সর্বশেষ বিল পরিবর্তন বা মুছে ফেলা সম্ভব{{else}}Archived bill - only the latest bill can be edited or deleted{{/if}}">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    </span>
                  {{/if}}
                </div>
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>

    <!-- Mobile Cards View (<= 768px) -->
    <div class="mobile-bills-cards" style="padding: 0.85rem;">
      {{#each bills}}
        <div class="mobile-bill-card {{#if this.isLatestBill}}mbc-latest{{else}}mbc-archived{{/if}}" style="margin-bottom: 0.75rem;">
          <div class="mbc-top">
            <div class="mbc-cust-info">
              <span class="date-badge-pill">{{tDate this.date}}</span>
              {{#if this.isLatestBill}}
                <span class="mbc-latest-tag" style="margin-left: 0.35rem;">{{#if ../isBn}}সর্বশেষ বিল{{else}}Latest{{/if}}</span>
              {{/if}}
            </div>
            <div class="mbc-meta">
              {{#if (gt this.presentDues 0)}}
                <span class="dues-badge dues-has-due">৳{{bnMoney this.presentDues}}</span>
              {{else if (lt this.presentDues 0)}}
                <span class="dues-badge dues-advance">৳{{bnMoney (subtract 0 this.presentDues)}} {{#if ../isBn}}অগ্রিম{{else}}Adv{{/if}}</span>
              {{else}}
                <span class="dues-badge dues-cleared">✓ {{#if ../isBn}}পরিশোধিত{{else}}Cleared{{/if}}</span>
              {{/if}}
            </div>
          </div>

          <!-- Reading details -->
          <div class="mbc-reading-bar">
            <span>{{#if ../isBn}}রিডিং{{else}}Reading{{/if}}: <strong>{{bnMoney this.previousUnit}}</strong> &rarr; <strong>{{bnMoney this.currentUnit}}</strong></span>
            <span class="badge badge-consumed-units">{{bnMoney this.totalUnit}} {{t 'common.unitShort'}}</span>
          </div>

          <!-- Financial summary grid -->
          <div class="mbc-grid">
            <div class="mbc-stat-box">
              <span class="mbc-stat-lbl">{{t 'bills.electricBill'}}</span>
              <span class="mbc-stat-val">৳{{bnMoney this.electricBill}}</span>
            </div>
            <div class="mbc-stat-box">
              <span class="mbc-stat-lbl">{{t 'bills.rent'}} + {{t 'bills.loan'}}</span>
              <span class="mbc-stat-val">৳{{bnMoney (add this.rentBill this.loan)}}</span>
            </div>
            <div class="mbc-stat-box">
              <span class="mbc-stat-lbl">{{t 'bills.totalBill'}}</span>
              <span class="mbc-stat-val font-bold">৳{{bnMoney this.totalBill}}</span>
            </div>
            <div class="mbc-stat-box">
              <span class="mbc-stat-lbl">{{t 'bills.paid'}}</span>
              <span class="mbc-stat-val text-success font-bold">৳{{bnMoney this.clearMoney}}</span>
            </div>
          </div>

          <div class="mbc-bottom">
            <div class="mbc-dues">
              <span class="mbc-due-label">{{t 'bills.presentDues'}}:</span>
              <strong class="{{#if (ne this.presentDues 0)}}text-danger{{else}}text-success{{/if}}" style="font-size: 1.15rem; font-family: monospace;">
                ৳{{bnMoney this.presentDues}}
              </strong>
            </div>
            <div class="table-actions-group">
              <a href="/bills/{{this.id}}" class="btn btn-secondary btn-icon-action" title="{{t 'bills.receipt'}}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
              </a>
              {{#if this.isLatestBill}}
                {{#if (or ../isSuperAdmin ../currentUser.canEdit)}}
                  <a href="/bills/{{this.id}}/edit" class="btn btn-secondary btn-icon-action btn-action-edit" title="{{t 'common.edit'}}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                  </a>
                {{/if}}
                {{#if (or ../isSuperAdmin ../currentUser.canDelete)}}
                  <form action="/bills/{{this.id}}/delete" method="POST" style="display: inline;" onsubmit="return confirm('{{t 'bills.confirmDelete'}}');">
                    <button type="submit" class="btn btn-icon-action btn-action-delete" title="{{t 'common.delete'}}">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                    </button>
                  </form>
                {{/if}}
              {{else}}
                <span class="btn-icon-action action-locked-pill" title="{{#if ../isBn}}পূর্ববর্তী রেকর্ড - শুধুমাত্র সর্বশেষ বিল পরিবর্তন বা মুছে ফেলা সম্ভব{{else}}Archived bill - only the latest bill can be edited or deleted{{/if}}">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </span>
              {{/if}}
            </div>
          </div>
        </div>
      {{/each}}
    </div>
  {{else}}
    <div style="text-align: center; padding: 3rem 1.5rem;">
      <div style="width: 56px; height: 56px; border-radius: 50%; background: rgba(56, 189, 248, 0.1); color: #38bdf8; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem;">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
      </div>
      <h3 style="color: var(--color-text-primary); font-size: 1.1rem; font-weight: 600; margin-bottom: 0.35rem;">{{t 'bills.noBills'}}</h3>
      <p style="color: var(--color-text-muted); font-size: 0.88rem; max-width: 420px; margin: 0 auto 1.25rem;">{{t 'bills.noBillsSub'}}</p>
      {{#if (or isSuperAdmin currentUser.canCreate)}}
        {{#if (and customer.isActive (not customer.isGarageSuspended))}}
          <a href="/bills/new?customerId={{customer.id}}" class="btn btn-primary" style="background: #10b981; border-color: #10b981;">
            + {{t 'bills.newBill'}}
          </a>
        {{/if}}
      {{/if}}
    </div>
  {{/if}}
</div>

