<div id="addGuarantorModal" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.75); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); z-index: 9999; align-items: center; justify-content: center; padding: 1.5rem 1rem; overflow-y: auto;">
  <div class="card guarantor-modal-card">
    <!-- Modal Header -->
    <div class="g-modal-header">
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <div style="width: 42px; height: 42px; border-radius: 10px; background: rgba(99, 102, 241, 0.15); border: 1px solid rgba(99, 102, 241, 0.3); display: flex; align-items: center; justify-content: center; font-size: 1.4rem;">
          🛡️
        </div>
        <div>
          <h3 style="margin: 0; font-size: 1.2rem; font-weight: 700; color: var(--color-text-primary, #fff);">
            + {{t 'guarantors.add'}}
          </h3>
          <p style="margin: 0.15rem 0 0; font-size: 0.8rem; color: var(--color-text-muted, #94a3b8);">
            {{t 'guarantors.subtitle'}}
          </p>
        </div>
      </div>
      <button type="button" onclick="document.getElementById('addGuarantorModal').style.display='none'" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); width: 34px; height: 34px; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: var(--color-text-muted, #94a3b8); font-size: 1.4rem; cursor: pointer; transition: all 0.2s; line-height: 1;" title="{{t 'common.cancel'}}">&times;</button>
    </div>

    <!-- Form with Multipart Upload -->
    <form action="/customers/{{customer.id}}/guarantors" method="POST" enctype="multipart/form-data" style="display: flex; flex-direction: column; overflow: hidden; margin: 0; flex: 1 1 auto;">
      <div class="g-modal-body">
        
        <!-- SECTION 1: Primary Details -->
        <div class="g-form-section">
          <div class="g-section-badge">
            <span>👤</span>
            <span>{{t 'guarantors.basicInfo'}}</span>
          </div>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 1rem;">
            <div class="form-group" style="margin-bottom: 0;">
              <label class="form-label" for="gName">{{t 'guarantors.name'}} <span style="color: #f43f5e;">*</span></label>
              <input type="text" id="gName" name="name" class="form-input" required placeholder="{{#if isBn}}সম্পূর্ণ নাম লিখুন{{else}}Full Name{{/if}}">
            </div>
            <div class="form-group" style="margin-bottom: 0;">
              <label class="form-label" for="gRelationship">{{t 'guarantors.relationship'}}</label>
              <input type="text" id="gRelationship" name="relationship" class="form-input" placeholder="{{#if isBn}}যেমন: পিতা, ভাই, আত্মীয়, বন্ধু{{else}}e.g. Father, Brother, Relative, Friend{{/if}}">
            </div>
            <div class="form-group" style="grid-column: 1 / -1; margin-bottom: 0;">
              <label class="form-label" for="gNid">{{t 'guarantors.nid'}} <span style="color: #f43f5e;">*</span></label>
              <input type="text" id="gNid" name="nidNumber" class="form-input" required placeholder="{{#if isBn}}জাতীয় পরিচয়পত্র নম্বর (NID){{else}}National ID Number{{/if}}">
            </div>
          </div>
        </div>

        <!-- SECTION 2: Contact & Phone Numbers -->
        <div class="g-form-section">
          <div class="g-section-badge">
            <span>📞</span>
            <span>{{t 'guarantors.contactInfo'}}</span>
          </div>
          <div style="display: flex; flex-direction: column; gap: 1rem;">
            <div style="width: 100%;">
              {{> phone-repeater containerId="guarantorPhonesModal" primaryFieldName="mobileNumber" jsonFieldName="phoneNumbersJson" required=true label=(t 'phones.title')}}
            </div>
            <div class="form-group" style="margin-bottom: 0;">
              <label class="form-label" for="gAddress">{{t 'guarantors.address'}} <span style="color: #f43f5e;">*</span></label>
              <textarea id="gAddress" name="address" class="form-input" rows="2" required placeholder="{{#if isBn}}জামিনদারের বর্তমান ও স্থায়ী ঠিকানা লিখুন...{{else}}Guarantor residential or business address...{{/if}}"></textarea>
            </div>
          </div>
        </div>

        <!-- SECTION 3: Documents & Attachments (Multi-Category Slots) -->
        <div class="g-form-section">
          {{> documents-multi-uploader targetType="guarantor" fieldPrefix="guarantorDoc"}}
        </div>

        <!-- SECTION 4: Family Details (Optional) -->
        <div class="g-form-section">
          <div class="g-section-badge" style="justify-content: space-between;">
            <div style="display: flex; align-items: center; gap: 0.45rem;">
              <span>👨‍👩‍👧</span>
              <span>{{t 'guarantors.familyInfo'}}</span>
            </div>
            <span style="font-size: 0.7rem; font-weight: 600; padding: 2px 7px; border-radius: 9999px; background: rgba(100, 116, 139, 0.15); color: #94a3b8; border: 1px solid rgba(100, 116, 139, 0.2);">
              {{t 'guarantors.optionalBadge'}}
            </span>
          </div>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 1rem;">
            <div class="form-group" style="margin-bottom: 0;">
              <label class="form-label" for="gFather">{{t 'guarantors.fatherName'}}</label>
              <input type="text" id="gFather" name="fatherName" class="form-input" placeholder="{{#if isBn}}পিতার পূর্ণ নাম{{else}}Father's Full Name{{/if}}">
            </div>
            <div class="form-group" style="margin-bottom: 0;">
              <label class="form-label" for="gMother">{{t 'guarantors.motherName'}}</label>
              <input type="text" id="gMother" name="motherName" class="form-input" placeholder="{{#if isBn}}মাতার পূর্ণ নাম{{else}}Mother's Full Name{{/if}}">
            </div>
          </div>
        </div>

      </div>

      <!-- Modal Footer -->
      <div class="g-modal-footer">
        <button type="button" class="btn btn-secondary" onclick="document.getElementById('addGuarantorModal').style.display='none'">
          {{t 'common.cancel'}}
        </button>
        <button type="submit" class="btn btn-primary" style="background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%); border: none; font-weight: 700; box-shadow: 0 4px 14px rgba(99, 102, 241, 0.4); display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.6rem 1.4rem;">
          <span>🛡️</span>
          <span>{{t 'guarantors.save'}}</span>
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Upload Customer Document Modal -->
<div id="uploadCustomerDocModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.75); backdrop-filter: blur(5px); z-index: 9999; align-items: center; justify-content: center; padding: 1.5rem 1rem; overflow-y: auto;">
  <div class="card modal-responsive-card" style="max-width: 580px; width: 100%; max-height: calc(100vh - 3.5rem); overflow-y: auto; padding: 1.75rem; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5); border-top: 3px solid #38bdf8; margin: auto;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 1px solid var(--color-border); padding-bottom: 0.75rem;">
      <h3 style="margin: 0; font-size: 1.15rem; font-weight: 700; color: #fff; display: flex; align-items: center; gap: 0.5rem;">
        <span>📤</span> {{t 'documents.uploadNew'}}
      </h3>
      <button type="button" onclick="document.getElementById('uploadCustomerDocModal').style.display='none'" style="background: transparent; border: none; color: var(--color-text-muted); font-size: 1.5rem; cursor: pointer; line-height: 1;">&times;</button>
    </div>
    <form action="/customers/{{customer.id}}/documents" method="POST" enctype="multipart/form-data">
      <div style="margin-bottom: 1rem;">
        <label class="form-label" for="custDocType">{{t 'documents.documentType'}}</label>
        <select id="custDocType" name="type" class="form-input">
          <option value="GENERAL">{{t 'documents.typeGeneral'}}</option>
          <option value="NID">{{t 'documents.typeNid'}}</option>
          <option value="PASSPORT">{{t 'documents.typePassport'}}</option>
          <option value="AGREEMENT">{{t 'documents.typeAgreement'}}</option>
          <option value="ELECTRICITY_BILL">{{t 'documents.typeElectricityBill'}}</option>
          <option value="TRADE_LICENSE">{{t 'documents.typeTradeLicense'}}</option>
          <option value="PHOTO">{{t 'documents.typePhoto'}}</option>
          <option value="SIGNATURE">{{t 'documents.typeSignature'}}</option>
          <option value="OTHER">{{t 'documents.typeOther'}}</option>
        </select>
      </div>

      {{> file-uploader uploaderId="custModalUploader" fieldName="files" maxFiles=10}}

      <div style="display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 1.25rem;">
        <button type="button" class="btn btn-secondary" onclick="document.getElementById('uploadCustomerDocModal').style.display='none'">{{t 'common.cancel'}}</button>
        <button type="submit" class="btn btn-primary" style="background: #38bdf8; border-color: #38bdf8; color: #0f172a; font-weight: 700;">
          {{t 'documents.upload'}}
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Upload Guarantor Document Modal -->
<div id="uploadGuarantorDocModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.75); backdrop-filter: blur(5px); z-index: 9999; align-items: center; justify-content: center; padding: 1.5rem 1rem; overflow-y: auto;">
  <div class="card modal-responsive-card" style="max-width: 580px; width: 100%; max-height: calc(100vh - 3.5rem); overflow-y: auto; padding: 1.75rem; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5); border-top: 3px solid #818cf8; margin: auto;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 1px solid var(--color-border); padding-bottom: 0.75rem;">
      <h3 style="margin: 0; font-size: 1.15rem; font-weight: 700; color: #fff; display: flex; align-items: center; gap: 0.5rem;">
        <span>🛡️</span> {{t 'documents.uploadNew'}} &mdash; <span id="guarantorModalTargetName" style="color: #a5b4fc;"></span>
      </h3>
      <button type="button" onclick="document.getElementById('uploadGuarantorDocModal').style.display='none'" style="background: transparent; border: none; color: var(--color-text-muted); font-size: 1.5rem; cursor: pointer; line-height: 1;">&times;</button>
    </div>
    <form id="guarantorUploadForm" action="" method="POST" enctype="multipart/form-data">
      <div style="margin-bottom: 1rem;">
        <label class="form-label" for="gDocType">{{t 'documents.documentType'}}</label>
        <select id="gDocType" name="type" class="form-input">
          <option value="GENERAL">{{t 'documents.typeGeneral'}}</option>
          <option value="NID">{{t 'documents.typeNid'}}</option>
          <option value="PASSPORT">{{t 'documents.typePassport'}}</option>
          <option value="PHOTO">{{t 'documents.typePhoto'}}</option>
          <option value="SIGNATURE">{{t 'documents.typeSignature'}}</option>
          <option value="OTHER">{{t 'documents.typeOther'}}</option>
        </select>
      </div>

      {{> file-uploader uploaderId="guarantorModalUploader" fieldName="files" maxFiles=10}}

      <div style="display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 1.25rem;">
        <button type="button" class="btn btn-secondary" onclick="document.getElementById('uploadGuarantorDocModal').style.display='none'">{{t 'common.cancel'}}</button>
        <button type="submit" class="btn btn-primary" style="background: #818cf8; border-color: #818cf8; color: #0f172a; font-weight: 700;">
          {{t 'documents.upload'}}
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function openGuarantorUploadModal(guarantorId, guarantorName) {
    const form = document.getElementById('guarantorUploadForm');
    const nameSpan = document.getElementById('guarantorModalTargetName');
    if (form) {
      form.action = '/customers/{{customer.id}}/guarantors/' + guarantorId + '/documents';
    }
    if (nameSpan) {
      nameSpan.textContent = guarantorName || '';
    }
    const modal = document.getElementById('uploadGuarantorDocModal');
    if (modal) {
      modal.style.display = 'flex';
    }
  }

  function triggerCustomerSuspendModal(formId) {
    const targetFormId = formId || 'suspendCustomerHeaderForm';
    const form = document.getElementById(targetFormId);
    if (typeof window.showConfirmModal !== 'function') {
      if (confirm('{{t "customers.confirmSuspend"}}')) {
        if (form) form.submit();
      }
      return;
    }

    window.showConfirmModal({
      title: "{{t 'customers.suspendModalTitle'}}",
      desc: "{{t 'customers.suspendModalDesc'}}",
      type: 'warning',
      icon: '⚠️',
      targetName: {{{json customer.name}}},
      targetSub: "{{#if customer.customerCode}}ID: {{customer.customerCode}} &bull; {{/if}}System #{{#if customer.cId}}{{bnNum customer.cId}}{{else}}{{bnNum customer.id}}{{/if}}",
      targetBadgeText: "{{t 'customers.active'}}",
      targetBadgeClass: "badge-success",
      calloutText: "{{t 'customers.suspendModalWarning'}}",
      calloutIcon: "⚠️",
      cancelText: "{{t 'common.cancel'}}",
      submitText: "{{t 'customers.suspendModalBtn'}}",
      submitBtnClass: "btn-warning",
      onConfirm: function() {
        if (form) form.submit();
      }
    });
  }

  function triggerCustomerReactivateModal(formId) {
    const targetFormId = formId || 'reactivateCustomerHeaderForm';
    const form = document.getElementById(targetFormId);
    if (typeof window.showConfirmModal !== 'function') {
      if (confirm('{{t "customers.confirmReactivate"}}')) {
        if (form) form.submit();
      }
      return;
    }

    window.showConfirmModal({
      title: "{{t 'customers.reactivateModalTitle'}}",
      desc: "{{t 'customers.reactivateModalDesc'}}",
      type: 'success',
      icon: '⚡',
      targetName: {{{json customer.name}}},
      targetSub: "{{#if customer.customerCode}}ID: {{customer.customerCode}} &bull; {{/if}}System #{{#if customer.cId}}{{bnNum customer.cId}}{{else}}{{bnNum customer.id}}{{/if}}",
      targetBadgeText: "{{t 'customers.suspended'}}",
      targetBadgeClass: "badge-danger",
      calloutText: "{{t 'customers.reactivateModalNotice'}}",
      calloutIcon: "✨",
      cancelText: "{{t 'common.cancel'}}",
      submitText: "{{t 'customers.reactivateModalBtn'}}",
      submitBtnClass: "btn-success",
      onConfirm: function() {
        if (form) form.submit();
      }
    });
  }

  // Close modals on Escape key or backdrop click
  window.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      ['addGuarantorModal', 'uploadCustomerDocModal', 'uploadGuarantorDocModal'].forEach(function(id) {
        var m = document.getElementById(id);
        if (m && m.style.display !== 'none') {
          m.style.display = 'none';
        }
      });
    }
  });

  ['addGuarantorModal', 'uploadCustomerDocModal', 'uploadGuarantorDocModal'].forEach(function(id) {
    var modal = document.getElementById(id);
    if (modal) {
      modal.addEventListener('click', function(e) {
        if (e.target === this) {
          this.style.display = 'none';
        }
      });
    }
  });
</script>
