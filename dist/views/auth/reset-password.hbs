<div style="max-width: 480px; margin: 3rem auto; padding: 0 1rem;">
  <div class="card" style="box-shadow: var(--shadow-lg); border-color: rgba(79, 70, 229, 0.3);">
    <div class="card-header" style="text-align: center; flex-direction: column; gap: 0.5rem; padding: 2rem 1.5rem 1rem;">
      <h1 style="font-size: 1.5rem; font-weight: 800; color: #ffffff;">{{t 'auth.resetPasswordTitle'}}</h1>
      <p style="font-size: 0.85rem; color: var(--color-text-muted);">
        {{#if isBn}}<strong>{{email}}</strong> অ্যাকাউন্টের জন্য নতুন পাসওয়ার্ড লিখুন{{else}}Enter a new secure password for <strong>{{email}}</strong>{{/if}}
      </p>
    </div>

    <div class="card-body" style="padding: 1.5rem 2rem 2rem;">
      {{#if error}}
        <div style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: var(--radius-md); padding: 0.75rem 1rem; margin-bottom: 1.25rem; font-size: 0.85rem; color: #f87171;">
          {{error}}
        </div>
      {{/if}}

      <form action="/reset-password" method="POST">
        <input type="hidden" name="token" value="{{token}}">
        <input type="hidden" name="email" value="{{email}}">

        <div class="form-group" style="margin-bottom: 1.5rem;">
          <label class="form-label" for="newPassword" style="display: block; margin-bottom: 0.4rem; font-size: 0.875rem; font-weight: 600;">{{t 'auth.newPassword'}}</label>
          <div class="password-input-wrapper">
            <input
              type="password"
              id="newPassword"
              name="password"
              class="form-control"
              required
              minlength="6"
              placeholder="Minimum 6 characters"
              style="width: 100%; padding: 0.75rem 2.75rem 0.75rem 0.75rem; border-radius: var(--radius-md); background: rgba(15, 23, 42, 0.8); border: 1px solid var(--color-border); color: #fff;"
            />
            <button type="button" class="password-toggle-btn" aria-label="Toggle password visibility" tabindex="-1">
              <svg class="eye-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
              <svg class="eye-off-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                <line x1="1" y1="1" x2="23" y2="23"></line>
              </svg>
            </button>
          </div>
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.75rem; font-weight: 600; font-size: 0.95rem;">
          {{t 'auth.savePassword'}}
        </button>
      </form>
    </div>
  </div>
</div>
