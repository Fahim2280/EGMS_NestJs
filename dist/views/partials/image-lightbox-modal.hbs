<!-- Universal Image Lightbox Modal Component (উভয় ভিউ ও উভয় থিমের জন্য লাইটবক্স মোডাল) -->
<div id="imageLightboxModal" class="lightbox-modal-overlay" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="lightboxModalName">
  <div class="lightbox-modal-backdrop" id="lightboxModalBackdrop"></div>
  
  <div class="lightbox-modal-card" id="lightboxModalCard">
    <!-- Header -->
    <div class="lightbox-modal-header">
      <div class="lightbox-modal-identity">
        <div class="lightbox-modal-icon-badge">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
        </div>
        <div class="lightbox-modal-titles">
          <div class="lightbox-modal-name-row">
            <h3 class="lightbox-modal-name" id="lightboxModalName">Profile Picture</h3>
            <span class="lightbox-badge-code" id="lightboxModalCode" style="display: none;"></span>
          </div>
          <div class="lightbox-modal-meta-row">
            <span class="lightbox-badge-role" id="lightboxModalBadge" style="display: none;"></span>
            <span class="lightbox-modal-sub" id="lightboxModalSub"></span>
          </div>
        </div>
      </div>

      <button type="button" class="lightbox-close-btn" id="lightboxModalCloseBtn" aria-label="{{t 'common.close'}}">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <!-- Body / Image Container -->
    <div class="lightbox-modal-body">
      <div class="lightbox-image-viewport">
        <div class="lightbox-spinner" id="lightboxModalSpinner">
          <div class="lightbox-spinner-circle"></div>
          <span>{{#if isBn}}ছবি লোড হচ্ছে...{{else}}Loading image...{{/if}}</span>
        </div>
        <img id="lightboxModalImg" class="lightbox-image" src="" alt="Profile Picture" style="display: none;" />
      </div>
    </div>

    <!-- Footer Actions -->
    <div class="lightbox-modal-footer">
      <div class="lightbox-footer-left">
        <a id="lightboxModalNewTabBtn" href="#" target="_blank" rel="noopener" class="btn btn-secondary btn-sm lightbox-btn">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            <polyline points="15 3 21 3 21 9"/>
            <line x1="10" y1="14" x2="21" y2="3"/>
          </svg>
          <span>{{t 'profile.openNewTab'}}</span>
        </a>
      </div>

      <div class="lightbox-footer-right">
        <a id="lightboxModalDownloadBtn" href="#" download="profile-photo.jpg" class="btn btn-primary btn-sm lightbox-btn">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          <span>{{t 'profile.downloadPicture'}}</span>
        </a>

        <button type="button" class="btn btn-secondary btn-sm lightbox-btn" id="lightboxModalCancelBtn">
          {{t 'common.close'}}
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    function initImageLightbox() {
      var modal = document.getElementById('imageLightboxModal');
      var backdrop = document.getElementById('lightboxModalBackdrop');
      var card = document.getElementById('lightboxModalCard');
      var nameEl = document.getElementById('lightboxModalName');
      var codeEl = document.getElementById('lightboxModalCode');
      var badgeEl = document.getElementById('lightboxModalBadge');
      var subEl = document.getElementById('lightboxModalSub');
      var imgEl = document.getElementById('lightboxModalImg');
      var spinnerEl = document.getElementById('lightboxModalSpinner');
      var newTabBtn = document.getElementById('lightboxModalNewTabBtn');
      var downloadBtn = document.getElementById('lightboxModalDownloadBtn');
      var closeBtn = document.getElementById('lightboxModalCloseBtn');
      var cancelBtn = document.getElementById('lightboxModalCancelBtn');

      if (!modal || !imgEl) return;

      window.openImageLightbox = function(photoUrl, name, subInfo, badgeText, codeText) {
        if (!photoUrl) return;

        // Populate fields
        nameEl.textContent = name || 'Profile Picture';

        if (codeText) {
          codeEl.textContent = codeText;
          codeEl.style.display = 'inline-flex';
        } else {
          codeEl.style.display = 'none';
        }

        if (badgeText) {
          badgeEl.textContent = badgeText;
          badgeEl.style.display = 'inline-flex';
        } else {
          badgeEl.style.display = 'none';
        }

        if (subInfo) {
          subEl.textContent = subInfo;
          subEl.style.display = 'inline-block';
        } else {
          subEl.style.display = 'none';
        }

        // Configure links
        newTabBtn.href = photoUrl;
        downloadBtn.href = photoUrl;
        
        var safeFileName = (name || 'profile')
          .toLowerCase()
          .replace(/[^a-z0-9]/g, '-')
          .replace(/-+/g, '-') + '-photo.jpg';
        downloadBtn.setAttribute('download', safeFileName);

        // Reset image state & show spinner
        imgEl.style.display = 'none';
        spinnerEl.style.display = 'flex';
        modal.style.display = 'flex';
        document.body.classList.add('lightbox-open');

        // Preload image
        var loader = new Image();
        loader.onload = function() {
          imgEl.src = photoUrl;
          spinnerEl.style.display = 'none';
          imgEl.style.display = 'block';
        };
        loader.onerror = function() {
          spinnerEl.innerHTML = '<span style="color:#ef4444;">⚠️ {{#if isBn}}ছবি প্রদর্শন করা সম্ভব হয়নি{{else}}Unable to load image{{/if}}</span>';
        };
        loader.src = photoUrl;
      };

      function closeLightbox() {
        modal.style.display = 'none';
        document.body.classList.remove('lightbox-open');
        imgEl.src = '';
      }

      if (closeBtn) closeBtn.onclick = closeLightbox;
      if (cancelBtn) cancelBtn.onclick = closeLightbox;
      if (backdrop) backdrop.onclick = closeLightbox;

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modal.style.display === 'flex') {
          closeLightbox();
        }
      });

      // Global delegation for any previewable avatar element
      document.addEventListener('click', function(e) {
        var trigger = e.target.closest('.previewable-avatar, [data-preview-img]');
        if (trigger) {
          var url = trigger.getAttribute('data-preview-img');
          if (url && url.trim() !== '') {
            e.preventDefault();
            e.stopPropagation();
            var name = trigger.getAttribute('data-preview-name') || '';
            var sub = trigger.getAttribute('data-preview-sub') || '';
            var badge = trigger.getAttribute('data-preview-badge') || '';
            var code = trigger.getAttribute('data-preview-code') || '';
            window.openImageLightbox(url, name, sub, badge, code);
          }
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initImageLightbox);
    } else {
      initImageLightbox();
    }
  })();
</script>
