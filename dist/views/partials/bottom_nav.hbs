<!-- Mobile Bottom Navigation Dock (Visible on viewports < 768px) -->
<nav class="bottom-nav-dock" aria-label="Mobile Navigation">
  <a href="/" class="bottom-nav-item {{#if (eq activeNav 'dashboard')}}active{{/if}}">
    <div class="bottom-nav-icon">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="3" width="7" height="9"/>
        <rect x="14" y="3" width="7" height="5"/>
        <rect x="14" y="12" width="7" height="9"/>
        <rect x="3" y="16" width="7" height="5"/>
      </svg>
    </div>
    <span class="bottom-nav-label">{{t 'nav.dashboard'}}</span>
  </a>

  <a href="/customers" class="bottom-nav-item {{#if (eq activeNav 'customers')}}active{{/if}}">
    <div class="bottom-nav-icon">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
        <circle cx="9" cy="7" r="4"/>
        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
      </svg>
    </div>
    <span class="bottom-nav-label">{{t 'nav.customers'}}</span>
  </a>

  <a href="/bills" class="bottom-nav-item {{#if (eq activeNav 'bills')}}active{{/if}}">
    <div class="bottom-nav-icon">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
      </svg>
    </div>
    <span class="bottom-nav-label">{{t 'nav.bills'}}</span>
  </a>

  {{#if (or (eq currentUser.role 'SUPER_ADMIN') currentUser.isSuperAdmin isSuperAdmin currentUser.garageIds.length)}}
  <a href="/garages" class="bottom-nav-item {{#if (eq activeNav 'garages')}}active{{/if}}">
    <div class="bottom-nav-icon">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
        <polyline points="9 22 9 12 15 12 15 22"/>
      </svg>
    </div>
    <span class="bottom-nav-label">{{t 'nav.garages'}}</span>
  </a>
  {{/if}}

  <button type="button" class="bottom-nav-item" id="mobileBottomMenuBtn" aria-label="Open Navigation Menu">
    <div class="bottom-nav-icon">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </div>
    <span class="bottom-nav-label">Menu</span>
  </button>
</nav>
