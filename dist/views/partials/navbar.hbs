<nav class="navbar">
  <div class="container nav-container">
    <div class="nav-brand-wrapper">
      <a href="/" class="nav-brand">
        <div class="brand-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
          </svg>
        </div>
        <div class="brand-title">
          <span class="brand-name">EGMS Portal</span>
          <span class="brand-subtitle">Electric Garage &amp; Billing System</span>
        </div>
      </a>
    </div>

    <!-- Header Actions & Language/Theme Switcher (Public / Auth Pages) -->
    <div class="nav-actions">
      <!-- Language Switcher -->
      <div class="lang-switcher">
        {{#if isBn}}
          <a href="/lang/en" class="lang-switch-btn" title="Switch to English" data-lang="en">
            <span class="lang-code-active">বাং</span>
            <span class="lang-code-inactive">| EN</span>
          </a>
        {{else}}
          <a href="/lang/bn" class="lang-switch-btn" title="বাংলায় পরিবর্তন করুন" data-lang="bn">
            <span class="lang-code-active">EN</span>
            <span class="lang-code-inactive">| বাং</span>
          </a>
        {{/if}}
      </div>

      <!-- Theme Switcher Button -->
      <button class="theme-toggle-btn" aria-label="Toggle Theme" title="{{#if isLight}}{{t 'theme.toggleDark'}}{{else}}{{t 'theme.toggleLight'}}{{/if}}">
        <svg class="theme-icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="{{#if isLight}}display:none;{{else}}display:block;{{/if}}">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <svg class="theme-icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="{{#if isLight}}display:block;{{else}}display:none;{{/if}}">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>

      {{#if (eq activeNav 'login')}}
        <a href="/register" class="btn btn-primary btn-sm">{{t 'nav.register'}}</a>
      {{else}}
        <a href="/login" class="btn btn-secondary btn-sm nav-login-btn">{{t 'nav.signIn'}}</a>
      {{/if}}
    </div>
  </div>
</nav>
