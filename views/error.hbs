<div style="text-align: center; padding: 4rem 1rem; max-width: 600px; margin: 0 auto;">
  <div style="font-size: 5rem; font-weight: 800; color: var(--status-rejected); line-height: 1; margin-bottom: 1rem;">
    {{statusCode}}
  </div>
  <h1 style="font-size: 1.75rem; font-weight: 700; color: #ffffff; margin-bottom: 0.75rem;">
    {{title}}
  </h1>
  <p style="color: var(--color-text-muted); font-size: 1rem; margin-bottom: 2rem;">
    {{message}}
  </p>
  <div style="display: flex; justify-content: center; gap: 1rem;">
    <a href="/" class="btn btn-primary">Return to Dashboard</a>
    <a href="/garages" class="btn btn-secondary">Browse Garages</a>
  </div>

</div>
