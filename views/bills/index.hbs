<div class="page-header">
  <div class="header-content">
    <h1 class="page-title">{{t 'bills.title'}}</h1>
    <p class="page-subtitle">{{t 'bills.subtitle'}}</p>
  </div>
  {{#if (or isSuperAdmin currentUser.canCreate)}}
  <div class="header-actions">
    <button type="button" class="btn btn-secondary" onclick="openBatchModal()" style="display: inline-flex; align-items: center; gap: 0.5rem; white-space: nowrap; flex-shrink: 0; padding: 0.62rem 1.15rem; font-weight: 600; box-shadow: var(--shadow-sm);">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2.5">
        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
      </svg>
      <span>{{t 'bills.batchGenerate'}}</span>
    </button>
    <a href="/bills/new" class="btn btn-primary" style="background: #10b981; border-color: #10b981; display: inline-flex; align-items: center; gap: 0.5rem; white-space: nowrap; flex-shrink: 0; padding: 0.62rem 1.25rem; font-weight: 700; box-shadow: 0 4px 14px rgba(16, 185, 129, 0.35);">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <line x1="12" y1="5" x2="12" y2="19"/>
        <line x1="5" y1="12" x2="19" y2="12"/>
      </svg>
      <span>{{t 'bills.newBill'}}</span>
    </a>
  </div>
  {{/if}}
</div>

<div class="card">
  <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
    <h2 class="card-title">{{t 'bills.ledgerTitle'}} ({{bnNum totalBillsCount}})</h2>
  </div>

  {{#if bills.length}}
    <div class="table-scroll-hint">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="8 18 2 12 8 6"/><polyline points="16 6 22 12 16 18"/></svg>
      <span>{{#if isBn}}সম্পূর্ণ বিবরণ দেখতে ডানে স্ক্রোল করুন{{else}}Scroll horizontally to view all{{/if}}</span>
    </div>
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>{{t 'common.date'}}</th>
            <th>{{t 'bills.customer'}}</th>
            <th>{{t 'bills.prevUnit'}}</th>
            <th>{{t 'bills.currUnit'}}</th>
            <th>{{t 'bills.consumed'}}</th>
            <th>{{t 'bills.electricBill'}} ({{t 'common.currency'}})</th>
            <th>{{t 'bills.prevDues'}} ({{t 'common.currency'}})</th>
            <th>{{t 'bills.rent'}} ({{t 'common.currency'}})</th>
            <th>{{t 'bills.loan'}} ({{t 'common.currency'}})</th>
            <th>{{t 'bills.totalBill'}} ({{t 'common.currency'}})</th>
            <th>{{t 'bills.paid'}} ({{t 'common.currency'}})</th>
            <th>{{t 'bills.presentDues'}} ({{t 'common.currency'}})</th>
            <th style="text-align: right;">{{t 'common.actions'}}</th>
          </tr>
        </thead>
        <tbody>
          {{#each bills}}
            <tr>
              <td>{{tDate this.date}}</td>
              <td>
                <a href="/customers/{{this.customerId}}" style="color: #60a5fa; text-decoration: none; font-weight: 600;">
                  {{this.customerName}}
                </a>
              </td>
              <td>{{bnNum this.previousUnit}}</td>
              <td><strong>{{bnNum this.currentUnit}}</strong></td>
              <td><span class="badge" style="background: rgba(56, 189, 248, 0.15); color: #38bdf8;">{{bnNum this.totalUnit}} {{t 'common.unitShort'}}</span></td>
              <td>{{t 'common.currency'}}{{bnNum this.electricBill}}</td>
              <td>{{t 'common.currency'}}{{bnNum this.previousDues}}</td>
              <td>{{t 'common.currency'}}{{bnNum this.rentBill}}</td>
              <td>{{t 'common.currency'}}{{bnNum this.loan}}</td>
              <td><strong>{{t 'common.currency'}}{{bnNum this.totalBill}}</strong></td>
              <td style="color: #10b981; font-weight: 600;">{{t 'common.currency'}}{{bnNum this.clearMoney}}</td>
              <td>
                <span style="font-weight: 700; {{#if (ne this.presentDues 0)}}color: #ef4444;{{else}}color: #10b981;{{/if}}">
                  {{t 'common.currency'}}{{bnNum this.presentDues}}
                </span>
              </td>
              <td style="text-align: right;">
                <div class="table-actions-group">
                  <a href="/bills/{{this.id}}" class="btn btn-secondary btn-icon-action" title="{{t 'bills.receipt'}}" aria-label="{{t 'bills.receipt'}}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                  </a>
                  {{#if (or ../isSuperAdmin ../currentUser.canEdit)}}
                  <a href="/bills/{{this.id}}/edit" class="btn btn-secondary btn-icon-action" title="{{t 'common.edit'}}" aria-label="{{t 'common.edit'}}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                  </a>
                  {{/if}}
                  {{#if (or ../isSuperAdmin ../currentUser.canDelete)}}
                  <form action="/bills/{{this.id}}/delete" method="POST" style="display: inline;" onsubmit="return confirm('Delete this bill? Subsequent bills will be automatically recalculated.');">
                    <button type="submit" class="btn btn-danger btn-icon-action" title="{{t 'common.delete'}}" aria-label="{{t 'common.delete'}}">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                    </button>
                  </form>
                  {{/if}}
                </div>
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  {{else}}
    <div style="text-align: center; padding: 4rem 1rem;">
      <div style="font-size: 3rem; margin-bottom: 1rem;">⚡</div>
      <h3 style="color: var(--color-text-primary); font-size: 1.25rem; font-weight: 600; margin-bottom: 0.5rem;">{{t 'bills.noBills'}}</h3>
      <p style="color: var(--color-text-muted); margin-bottom: 1.5rem;">{{t 'bills.noBillsSub'}}</p>
      {{#if (or isSuperAdmin currentUser.canCreate)}}
      <a href="/bills/new" class="btn btn-primary" style="background: #10b981; border-color: #10b981;">{{t 'bills.newBill'}}</a>
      {{/if}}
    </div>
  {{/if}}
</div>

<!-- Batch Generate Monthly Bills Modal -->
<div id="batchGenerateModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.75); backdrop-filter: blur(6px); z-index: 9999; align-items: center; justify-content: center; padding: 1rem;">
  <div class="card" style="max-width: 520px; width: 100%; padding: 1.75rem; border-top: 3px solid #38bdf8; background: radial-gradient(circle at top right, rgba(56, 189, 248, 0.1), transparent 70%), rgba(30, 41, 59, 0.95); box-shadow: 0 25px 50px -12px rgba(0,0,0,0.6); animation: slideInUp 0.25s ease-out; margin-bottom: 0;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 1px solid rgba(255, 255, 255, 0.08); padding-bottom: 0.85rem;">
      <h3 style="margin: 0; font-size: 1.2rem; font-weight: 700; color: #fff; display: flex; align-items: center; gap: 0.5rem;">
        <span style="display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 8px; background: rgba(56, 189, 248, 0.15); color: #38bdf8;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        </span>
        {{t 'bills.batchGenerate'}}
      </h3>
      <button type="button" onclick="closeBatchModal()" style="background: transparent; border: none; color: var(--color-text-muted); font-size: 1.5rem; cursor: pointer; line-height: 1; padding: 0.25rem;">&times;</button>
    </div>

    <form action="/bills/generate-monthly" method="POST">
      <p style="color: #94a3b8; font-size: 0.88rem; line-height: 1.5; margin-bottom: 1.25rem;">
        Generate electric bills in bulk for all active customer accounts who haven't received an invoice for the target billing cycle.
      </p>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.25rem;">
        <div class="form-group" style="margin-bottom: 0;">
          <label class="form-label" for="batchFromDate">
            <span>{{t 'bills.fromDate'}} <span style="color: #f43f5e;">*</span></span>
          </label>
          <input type="date" id="batchFromDate" name="fromDate" class="form-input" required value="{{#if defaultFromDate}}{{defaultFromDate}}{{else}}{{todayDate}}{{/if}}" style="font-size: 0.95rem; font-weight: 600;">
          <span class="form-hint">Billing cycle start date</span>
        </div>

        <div class="form-group" style="margin-bottom: 0;">
          <label class="form-label" for="batchToDate">
            <span>{{t 'bills.toDate'}} <span style="color: #f43f5e;">*</span></span>
          </label>
          <input type="date" id="batchToDate" name="toDate" class="form-input" required value="{{#if defaultToDate}}{{defaultToDate}}{{else}}{{todayDate}}{{/if}}" style="font-size: 0.95rem; font-weight: 600;">
          <span class="form-hint">Billing cycle end / invoice date</span>
        </div>
      </div>

      <div style="background: rgba(15, 23, 42, 0.5); border: 1px solid rgba(255, 255, 255, 0.06); border-radius: 8px; padding: 1rem; margin-bottom: 1.5rem; font-size: 0.82rem; color: #94a3b8; line-height: 1.5;">
        <div style="font-weight: 700; color: #cbd5e1; margin-bottom: 0.35rem; display: flex; align-items: center; gap: 0.35rem;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
          Batch Processing Rules:
        </div>
        <ul style="margin: 0; padding-left: 1.25rem; display: flex; flex-direction: column; gap: 0.25rem;">
          <li>Uses latest meter reading as baseline previous unit.</li>
          <li>Carries over outstanding dues and baseline facility rent.</li>
          <li>Customers already billed for this month will be skipped safely.</li>
        </ul>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 0.75rem;">
        <button type="button" class="btn btn-secondary" onclick="closeBatchModal()" style="padding: 0.65rem 1.25rem;">{{t 'common.cancel'}}</button>
        <button type="submit" class="btn btn-primary" style="background: linear-gradient(135deg, #0284c7, #0ea5e9); border-color: #0284c7; padding: 0.65rem 1.5rem; display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 700; box-shadow: 0 4px 14px rgba(14, 165, 233, 0.35);">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          Generate Statements
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function openBatchModal() {
    const modal = document.getElementById('batchGenerateModal');
    if (modal) modal.style.display = 'flex';
  }
  function closeBatchModal() {
    const modal = document.getElementById('batchGenerateModal');
    if (modal) modal.style.display = 'none';
  }
  window.addEventListener('click', (e) => {
    const modal = document.getElementById('batchGenerateModal');
    if (e.target === modal) closeBatchModal();
  });
</script>
