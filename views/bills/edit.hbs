<div class="page-header">
  <div class="header-content">
    <a href="/bills/{{bill.id}}" style="color: #94a3b8; text-decoration: none; font-size: 0.875rem; display: inline-flex; align-items: center; gap: 0.25rem; margin-bottom: 0.5rem;">
      &larr; Back to Bill Receipt
    </a>
    <h1 class="page-title">Edit Electric Bill</h1>
    <p class="page-subtitle">Update meter readings, charges, or payments</p>
  </div>
</div>

<div class="card" style="max-width: 700px; margin: 0 auto;">
  <div style="background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.3); border-radius: 8px; padding: 1rem; margin-bottom: 1.5rem; color: #fbbf24; font-size: 0.9rem; display: flex; gap: 0.75rem; align-items: flex-start;">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;">
      <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
      <line x1="12" y1="9" x2="12" y2="13"/>
      <line x1="12" y1="17" x2="12.01" y2="17"/>
    </svg>
    <div>
      <strong>Cascade Recalculation Notice:</strong><br>
      Updating this bill will automatically recalculate previous units, electric charges, and present dues for all subsequent chronological bills for this customer.
    </div>
  </div>

  {{#if error}}
    <div style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 8px; padding: 1rem; margin-bottom: 1.5rem; color: #ef4444; font-size: 0.9rem;">
      {{error}}
    </div>
  {{/if}}

  <form action="/bills/{{bill.id}}/edit" method="POST">
    <input type="hidden" name="customerId" value="{{bill.customerId}}">

    <div style="margin-bottom: 1.25rem;">
      <label class="form-label">Customer</label>
      <input type="text" class="form-input" readonly value="{{bill.customerName}}" style="background: rgba(255,255,255,0.03); color: #94a3b8;">
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.25rem;">
      <div class="form-group">
        <label class="form-label" for="date">Bill Date *</label>
        <input type="date" id="date" name="date" class="form-input" required value="{{billDateStr}}">
      </div>

      <div class="form-group">
        <label class="form-label" for="unitRate">
          Rate per Unit (৳) *
          {{#if (eq user.role 'SUPER_ADMIN')}}
          <span style="font-size: 0.75rem; color: #10b981; font-weight: normal; margin-left: 0.25rem;">Super Admin Configurable</span>
          {{else}}
          <span style="font-size: 0.75rem; color: #94a3b8; font-weight: normal; margin-left: 0.25rem;">Locked</span>
          {{/if}}
        </label>
        <input type="number" step="0.01" min="0.01" id="unitRate" name="unitRate" class="form-input" required 
          value="{{#if bill.unitRate}}{{bill.unitRate}}{{else}}15.00{{/if}}"
          {{#unless (eq user.role 'SUPER_ADMIN')}}readonly style="background: rgba(255,255,255,0.03); color: #94a3b8; cursor: not-allowed;" title="Only Super Admin can change the electricity unit rate"{{/unless}}>
      </div>
    </div>

    <div class="form-group" style="margin-bottom: 1.25rem;">
      <label class="form-label" for="currentUnit">Current Meter Reading *</label>
      <input type="number" step="0.01" min="0" id="currentUnit" name="currentUnit" class="form-input" required value="{{bill.currentUnit}}">
      <span style="font-size: 0.75rem; color: #94a3b8;">Previous meter reading for this bill was {{bill.previousUnit}} units.</span>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.25rem;">
      <div class="form-group">
        <label class="form-label" for="rentBill">Rent Bill (৳)</label>
        <input type="number" step="0.01" min="0" id="rentBill" name="rentBill" class="form-input" required value="{{bill.rentBill}}">
      </div>

      <div class="form-group">
        <label class="form-label" for="loan">Loan (৳)</label>
        <input type="number" step="0.01" min="0" id="loan" name="loan" class="form-input" required value="{{bill.loan}}">
      </div>
    </div>

    <div class="form-group" style="margin-bottom: 1.5rem;">
      <label class="form-label" for="clearMoney">Amount Paid / Clear Money (৳) *</label>
      <input type="number" step="0.01" min="0" id="clearMoney" name="clearMoney" class="form-input" required value="{{bill.clearMoney}}">
    </div>

    <div style="display: flex; gap: 1rem; justify-content: flex-end;">
      <a href="/bills/{{bill.id}}" class="btn btn-secondary">Cancel</a>
      <button type="submit" class="btn btn-primary">Save &amp; Recalculate</button>
    </div>
  </form>
</div>
