<div class="page-header" style="margin-bottom: 1.5rem;">
  <div class="header-content">
    <a href="/bills" style="color: var(--color-text-muted); text-decoration: none; font-size: 0.85rem; display: inline-flex; align-items: center; gap: 0.35rem; margin-bottom: 0.5rem; transition: color 0.15s ease;">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
      {{t 'bills.backToBills'}}
    </a>
    <h1 class="page-title" style="display: flex; align-items: center; gap: 0.65rem;">
      <span style="display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 10px; background: rgba(16, 185, 129, 0.15); color: #10b981;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
      </span>
      {{t 'bills.createTitle'}}
    </h1>
    <p class="page-subtitle">{{t 'bills.createSubtitle'}}</p>
  </div>
</div>

{{#if error}}
  <div style="background: rgba(239, 68, 68, 0.12); border: 1px solid rgba(239, 68, 68, 0.25); border-radius: 10px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; color: #f87171; font-size: 0.9rem; display: flex; align-items: center; gap: 0.75rem;">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    <span>{{error}}</span>
  </div>
{{/if}}

<div class="bill-create-grid" style="display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 1.75rem; align-items: start;">
  <!-- Bill Creation Form -->
  <div class="card" style="padding: 1.75rem; border-top: 3px solid #10b981; margin-bottom: 0;">
    <div style="display: flex; align-items: center; justify-content: space-between; padding-bottom: 1rem; margin-bottom: 1.5rem; border-bottom: 1px solid var(--color-border);">
      <h2 style="font-size: 1.15rem; font-weight: 700; color: var(--color-text-primary); margin: 0; display: flex; align-items: center; gap: 0.5rem;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        {{t 'bills.billDetails'}}
      </h2>
      <span class="badge" style="background: rgba(16, 185, 129, 0.12); color: #34d399; font-size: 0.72rem;">{{t 'bills.step1'}}</span>
    </div>

    <form action="/bills" method="POST" id="billForm">
      <!-- Section 1: Customer & Date -->
      <div style="background: rgba(15, 23, 42, 0.4); border: 1px solid rgba(255, 255, 255, 0.06); border-radius: var(--radius-md); padding: 1.25rem; margin-bottom: 1.25rem;">
        <div style="font-size: 0.76rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: #94a3b8; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.4rem;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          {{t 'bills.customerAndDate'}}
        </div>

        <div class="form-group" style="margin-bottom: 1rem;">
          <label class="form-label" for="customerId">
            <span>{{t 'bills.selectCustomer'}} <span style="color: #f43f5e;">*</span></span>
          </label>
          <select id="customerId" name="customerId" class="form-input" required>
            <option value="">{{t 'bills.chooseCustomer'}}</option>
            {{#each customers}}
              <option value="{{this.id}}" data-subtext="📱 {{this.mobileNumber}}" {{#if (eq ../preselectedCustomerId this.id)}}selected{{/if}}>
                {{this.name}}
              </option>
            {{/each}}
          </select>
        </div>

        <div class="form-grid-2" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
          <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label" for="date">
              <span>{{t 'bills.billingDate'}} <span style="color: #f43f5e;">*</span></span>
            </label>
            <input type="date" id="date" name="date" class="form-input" required value="{{todayDate}}">
          </div>

          <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label" for="unitRate">
              <span>{{t 'bills.ratePerUnit'}} ({{t 'common.currency'}}) <span style="color: #f43f5e;">*</span></span>
              {{#if (eq user.role 'SUPER_ADMIN')}}
              <span style="font-size: 0.7rem; color: #10b981; font-weight: 600;">{{t 'bills.editable'}}</span>
              {{else}}
              <span style="font-size: 0.7rem; color: var(--color-text-dim);">{{t 'bills.locked'}}</span>
              {{/if}}
            </label>
            <input type="number" step="0.01" min="0.01" id="unitRate" name="unitRate" class="form-input" required 
              value="{{#if formData.unitRate}}{{formData.unitRate}}{{else}}{{defaultUnitRate}}{{/if}}"
              {{#unless (eq user.role 'SUPER_ADMIN')}}readonly title="{{t 'bills.superAdminRateHint'}}"{{/unless}}>
          </div>
        </div>
      </div>

      <!-- Section 2: Meter Readings -->
      <div style="background: rgba(15, 23, 42, 0.4); border: 1px solid rgba(255, 255, 255, 0.06); border-radius: var(--radius-md); padding: 1.25rem; margin-bottom: 1.25rem;">
        <div style="font-size: 0.76rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: #94a3b8; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.4rem;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          {{t 'bills.electricityMeterReadings'}}
        </div>

        <div class="form-grid-2" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
          <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label">
              <span>{{t 'bills.prevUnit'}}</span>
              <span style="font-size: 0.7rem; color: var(--color-text-dim);">{{t 'bills.autoLoaded'}}</span>
            </label>
            <input type="text" id="displayPreviousUnit" class="form-input" readonly value="0.00">
          </div>

          <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label" for="currentUnit">
              <span>{{t 'bills.currUnit'}} <span style="color: #f43f5e;">*</span></span>
            </label>
            <input type="number" step="0.01" min="0" id="currentUnit" name="currentUnit" class="form-input" required placeholder="0.00" value="{{formData.currentUnit}}">
          </div>
        </div>
      </div>

      <!-- Section 3: Rent, Loan & Payment Settlement -->
      <div style="background: rgba(15, 23, 42, 0.4); border: 1px solid rgba(255, 255, 255, 0.06); border-radius: var(--radius-md); padding: 1.25rem; margin-bottom: 1.5rem;">
        <div style="font-size: 0.76rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: #94a3b8; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.4rem;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
          {{t 'bills.chargesAndSettlement'}}
        </div>

        <div class="form-grid-2" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
          <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label" for="rentBill">{{t 'bills.rent'}} ({{t 'common.currency'}})</label>
            <input type="number" step="0.01" min="0" id="rentBill" name="rentBill" class="form-input" required value="{{#if formData.rentBill}}{{formData.rentBill}}{{else}}0.00{{/if}}">
          </div>

          <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label" for="loan">{{t 'bills.loan'}} ({{t 'common.currency'}})</label>
            <input type="number" step="0.01" min="0" id="loan" name="loan" class="form-input" required value="{{#if formData.loan}}{{formData.loan}}{{else}}0.00{{/if}}">
          </div>
        </div>

        <div class="form-group" style="margin-bottom: 0;">
          <label class="form-label" for="clearMoney">
            <span>{{t 'bills.paid'}} ({{t 'common.currency'}}) <span style="color: #f43f5e;">*</span></span>
            <span style="font-size: 0.7rem; color: #10b981;">{{t 'bills.customerHandover'}}</span>
          </label>
          <input type="number" step="0.01" min="0" id="clearMoney" name="clearMoney" class="form-input" required placeholder="0.00" value="{{#if formData.clearMoney}}{{formData.clearMoney}}{{else}}0.00{{/if}}" style="font-size: 1.05rem; font-weight: 700; color: #34d399;">
        </div>
      </div>

      <div class="form-actions" style="display: flex; gap: 0.75rem; justify-content: flex-end; align-items: center;">
        <a href="/bills" class="btn btn-secondary" style="padding: 0.65rem 1.25rem;">{{t 'common.cancel'}}</a>
        <button type="submit" class="btn btn-primary" style="background: #10b981; border-color: #10b981; padding: 0.65rem 1.5rem; display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 700; box-shadow: 0 4px 14px rgba(16, 185, 129, 0.35);">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          {{t 'bills.saveBill'}}
        </button>
      </div>
    </form>
  </div>

  <!-- Live Automatic Calculation Preview Card -->
  <div class="bill-create-preview" style="position: sticky; top: 84px;">
    <div class="card" style="padding: 1.75rem; border-top: 3px solid #38bdf8; box-shadow: var(--shadow-md);">
      <!-- Header -->
      <div style="display: flex; align-items: center; justify-content: space-between; padding-bottom: 1rem; margin-bottom: 1.25rem; border-bottom: 1px solid var(--color-border);">
        <div>
          <h3 style="font-size: 1.1rem; font-weight: 700; color: var(--color-text-primary); margin: 0; display: flex; align-items: center; gap: 0.5rem;">
            <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #10b981; box-shadow: 0 0 10px #10b981;"></span>
            {{t 'bills.livePreview'}}
          </h3>
          <span style="font-size: 0.72rem; color: var(--color-text-dim);">{{t 'bills.realtimeBreakdown'}}</span>
        </div>
        <span class="badge" id="previewRateBadge" style="background: rgba(56, 189, 248, 0.15); color: #0284c7; border: 1px solid rgba(56, 189, 248, 0.3); font-size: 0.75rem; font-weight: 700;">
          {{t 'bills.ratePerUnitLabel'}} {{t 'common.currency'}}{{bnNum defaultUnitRate}}/{{t 'common.units'}}
        </span>
      </div>

      <!-- Customer Name Pill -->
      <div style="background: var(--color-bg-subtle); border: 1px solid var(--color-border); border-radius: 8px; padding: 0.75rem 1rem; margin-bottom: 1.25rem; display: flex; align-items: center; justify-content: space-between;">
        <span style="font-size: 0.8rem; color: var(--color-text-muted);">{{t 'bills.customer'}}</span>
        <strong id="previewCustomerName" style="color: var(--color-text-primary); font-size: 0.92rem;">{{t 'bills.chooseCustomer'}}</strong>
      </div>

      <!-- Meter Reading Bar -->
      <div style="background: var(--color-bg-subtle); border: 1px solid var(--color-border); border-radius: 8px; padding: 0.85rem 1rem; margin-bottom: 1.25rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
          <span style="font-size: 0.76rem; font-weight: 600; text-transform: uppercase; color: var(--color-text-muted);">{{t 'bills.meterReadings'}}</span>
          <span style="font-size: 0.76rem; color: #0284c7; font-weight: 700;" id="previewConsumedUnits">{{bnNum '0.00'}} {{t 'common.units'}}</span>
        </div>
        <div style="display: flex; align-items: center; justify-content: space-between; font-family: monospace; font-size: 1rem; font-weight: 700; color: var(--color-text-primary);">
          <span id="previewPrevUnit" style="color: var(--color-text-muted);">{{bnNum '0.00'}}</span>
          <span style="color: #0284c7; font-size: 1.15rem;">&rarr;</span>
          <span id="previewCurrUnit" style="color: #38bdf8;">{{bnNum '0.00'}}</span>
        </div>
      </div>

      <!-- Breakdown Table Rows -->
      <div style="display: flex; flex-direction: column; gap: 0.65rem; font-size: 0.88rem; margin-bottom: 1.25rem;">
        <div style="display: flex; justify-content: space-between; padding-bottom: 0.45rem; border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
          <span style="color: var(--color-text-muted);" id="previewElectricLabel">{{t 'bills.electricBill'}}:</span>
          <strong id="previewElectricBill" style="color: #ffffff; font-family: monospace;">{{t 'common.currency'}}{{bnNum '0.00'}}</strong>
        </div>

        <div style="display: flex; justify-content: space-between; padding-bottom: 0.45rem; border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
          <span style="color: var(--color-text-muted);">{{t 'bills.prevDues'}}:</span>
          <strong id="previewPrevDues" style="color: #fbbf24; font-family: monospace;">{{t 'common.currency'}}{{bnNum '0.00'}}</strong>
        </div>

        <div style="display: flex; justify-content: space-between; padding-bottom: 0.45rem; border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
          <span style="color: var(--color-text-muted);">{{t 'bills.rentLoan'}}:</span>
          <strong id="previewRentLoan" style="color: #ffffff; font-family: monospace;">{{t 'common.currency'}}{{bnNum '0.00'}}</strong>
        </div>
      </div>

      <!-- Total Bill Card -->
      <div style="background: linear-gradient(135deg, rgba(99, 102, 241, 0.15), rgba(56, 189, 248, 0.1)); border: 1px solid rgba(99, 102, 241, 0.3); border-radius: 10px; padding: 1rem 1.15rem; margin-bottom: 0.85rem; display: flex; justify-content: space-between; align-items: center;">
        <div>
          <div style="font-size: 0.76rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #a5b4fc;">{{t 'bills.totalBill'}}</div>
          <div style="font-size: 0.72rem; color: var(--color-text-dim);">{{t 'bills.combinedObligation'}}</div>
        </div>
        <strong id="previewTotalBill" style="font-size: 1.5rem; font-weight: 800; color: #ffffff; letter-spacing: -0.02em;">{{t 'common.currency'}}{{bnNum '0.00'}}</strong>
      </div>

      <!-- Paid Amount Row -->
      <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.65rem 0.85rem; background: rgba(16, 185, 129, 0.08); border: 1px solid rgba(16, 185, 129, 0.2); border-radius: 8px; margin-bottom: 0.85rem;">
        <span style="font-size: 0.82rem; font-weight: 600; color: #34d399;">{{t 'bills.paid'}}</span>
        <strong id="previewPaidAmount" style="font-size: 1.1rem; color: #34d399; font-weight: 800;">{{t 'common.currency'}}{{bnNum '0.00'}}</strong>
      </div>

      <!-- Present Net Dues Alert -->
      <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.85rem 1rem; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.25); border-radius: 10px;">
        <div>
          <div style="font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #f87171;">{{t 'bills.presentDues'}}</div>
          <div style="font-size: 0.7rem; color: #fca5a5;">{{t 'bills.outstandingCarryover'}}</div>
        </div>
        <strong id="previewPresentDues" style="font-size: 1.5rem; font-weight: 800; color: #ef4444; letter-spacing: -0.02em;">{{t 'common.currency'}}{{bnNum '0.00'}}</strong>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const customerSelect = document.getElementById('customerId');
    const displayPreviousUnit = document.getElementById('displayPreviousUnit');
    const currentUnitInput = document.getElementById('currentUnit');
    const unitRateInput = document.getElementById('unitRate');
    const rentBillInput = document.getElementById('rentBill');
    const loanInput = document.getElementById('loan');
    const clearMoneyInput = document.getElementById('clearMoney');
    const previewRateBadge = document.getElementById('previewRateBadge');
    const previewElectricLabel = document.getElementById('previewElectricLabel');

    let previousUnit = 0;
    let previousDues = 0;
    let customerName = '';

    async function fetchCustomerSummary(id) {
      if (!id) {
        previousUnit = 0;
        previousDues = 0;
        if (displayPreviousUnit) displayPreviousUnit.value = '0.00';
        const custNameEl = document.getElementById('previewCustomerName');
        if (custNameEl) custNameEl.textContent = '{{t "bills.chooseCustomer"}}';
        recalc();
        return;
      }
      try {
        const res = await fetch(`/bills/api/customer-summary/${id}`);
        if (!res.ok) return;
        const json = await res.json();
        if (json.success) {
          previousUnit = Number(json.data.lastMeterReading) || 0;
          previousDues = Number(json.data.previousDues) || 0;
          customerName = json.data.customerName || '';
          if (displayPreviousUnit) displayPreviousUnit.value = previousUnit.toFixed(2);
          const custNameEl = document.getElementById('previewCustomerName');
          if (custNameEl) custNameEl.textContent = customerName;
          recalc();
        }
      } catch (err) {
        console.error('Error fetching customer summary:', err);
      }
    }

    const isBn = {{#if isBn}}true{{else}}false{{/if}};
    const bnDigits = ['০', '১', '২', '৩', '৪', '৫', '৬', '৭', '৮', '৯'];
    function toBn(val) {
      if (!isBn) return String(val);
      return String(val).replace(/[0-9]/g, (d) => bnDigits[d]);
    }

    function recalc() {
      const currentUnit = Number(currentUnitInput ? currentUnitInput.value : 0) || 0;
      const rent = Number(rentBillInput ? rentBillInput.value : 0) || 0;
      const loan = Number(loanInput ? loanInput.value : 0) || 0;
      const clearMoney = Number(clearMoneyInput ? clearMoneyInput.value : 0) || 0;
      const rate = Number(unitRateInput ? unitRateInput.value : 15) || 15;

      const consumed = Math.max(0, currentUnit - previousUnit);
      const electric = consumed * rate;
      const total = previousDues + electric + rent + loan;
      const presentDues = total - clearMoney;

      if (previewRateBadge) {
        previewRateBadge.textContent = (isBn ? 'রেট: ৳' : 'Rate: ৳') + toBn(rate.toFixed(2)) + (isBn ? '/ইউনিট' : '/Unit');
      }
      if (previewElectricLabel) {
        previewElectricLabel.innerHTML = (isBn ? 'বিদ্যুৎ বিল (' : 'Electric Bill (') + toBn(consumed.toFixed(1)) + (isBn ? ' ইউ &times; ৳' : 'u &times; ৳') + toBn(rate.toFixed(2)) + '):';
      }

      const prevUnitEl = document.getElementById('previewPrevUnit');
      const currUnitEl = document.getElementById('previewCurrUnit');
      const consumedEl = document.getElementById('previewConsumedUnits');
      const elecBillEl = document.getElementById('previewElectricBill');
      const prevDuesEl = document.getElementById('previewPrevDues');
      const rentLoanEl = document.getElementById('previewRentLoan');
      const totalBillEl = document.getElementById('previewTotalBill');
      const paidAmountEl = document.getElementById('previewPaidAmount');
      const duesEl = document.getElementById('previewPresentDues');

      if (prevUnitEl) prevUnitEl.textContent = toBn(previousUnit.toFixed(2));
      if (currUnitEl) currUnitEl.textContent = toBn(currentUnit.toFixed(2));
      if (consumedEl) consumedEl.textContent = toBn(consumed.toFixed(2)) + (isBn ? ' ইউনিট' : ' Units');
      if (elecBillEl) elecBillEl.textContent = '৳' + toBn(electric.toFixed(2));
      if (prevDuesEl) prevDuesEl.textContent = '৳' + toBn(previousDues.toFixed(2));
      if (rentLoanEl) rentLoanEl.textContent = '৳' + toBn((rent + loan).toFixed(2));
      if (totalBillEl) totalBillEl.textContent = '৳' + toBn(total.toFixed(2));
      if (paidAmountEl) paidAmountEl.textContent = '৳' + toBn(clearMoney.toFixed(2));
      
      if (duesEl) {
        duesEl.textContent = '৳' + toBn(presentDues.toFixed(2));
        if (presentDues <= 0) {
          duesEl.style.color = '#34d399';
          if (duesEl.parentElement) {
            duesEl.parentElement.style.background = 'rgba(16, 185, 129, 0.1)';
            duesEl.parentElement.style.borderColor = 'rgba(16, 185, 129, 0.25)';
          }
        } else {
          duesEl.style.color = '#ef4444';
          if (duesEl.parentElement) {
            duesEl.parentElement.style.background = 'rgba(239, 68, 68, 0.1)';
            duesEl.parentElement.style.borderColor = 'rgba(239, 68, 68, 0.25)';
          }
        }
      }
    }

    if (customerSelect) customerSelect.addEventListener('change', () => fetchCustomerSummary(customerSelect.value));
    if (currentUnitInput) currentUnitInput.addEventListener('input', recalc);
    if (unitRateInput) unitRateInput.addEventListener('input', recalc);
    if (rentBillInput) rentBillInput.addEventListener('input', recalc);
    if (loanInput) loanInput.addEventListener('input', recalc);
    if (clearMoneyInput) clearMoneyInput.addEventListener('input', recalc);

    if (customerSelect && customerSelect.value) {
      fetchCustomerSummary(customerSelect.value);
    }
  });
</script>
