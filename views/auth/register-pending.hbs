<div style="min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 2rem; background: var(--color-bg-primary, #0f172a);">
  <div style="max-width: 520px; width: 100%; background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); border-radius: 20px; border: 1px solid rgba(245, 158, 11, 0.25); overflow: hidden; box-shadow: 0 25px 60px rgba(0,0,0,0.5);">

    <!-- Header -->
    <div style="background: linear-gradient(135deg, #b45309 0%, #f59e0b 100%); padding: 2.5rem 2rem; text-align: center;">
      <div style="width: 64px; height: 64px; background: rgba(255,255,255,0.2); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; font-size: 2rem;">
        ⏳
      </div>
      <h1 style="margin: 0; color: #fff; font-size: 1.6rem; font-weight: 800;">নিবন্ধন জমা হয়েছে!</h1>
      <p style="margin: 0.5rem 0 0; color: rgba(255,255,255,0.8); font-size: 0.9rem;">Registration Submitted Successfully</p>
    </div>

    <!-- Body -->
    <div style="padding: 2.5rem 2rem;">

      <!-- Status Badge -->
      <div style="display: flex; align-items: center; gap: 0.75rem; background: rgba(245,158,11,0.1); border: 1px solid rgba(245,158,11,0.25); border-radius: 12px; padding: 1rem 1.25rem; margin-bottom: 1.75rem;">
        <span style="font-size: 1.5rem; flex-shrink: 0;">🕐</span>
        <div>
          <p style="margin: 0; color: #fbbf24; font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">অনুমোদনের অপেক্ষায় — Pending Approval</p>
          <p style="margin: 4px 0 0; color: #94a3b8; font-size: 0.8rem;">আপনার অ্যাকাউন্ট অ্যাডমিন কর্তৃক অনুমোদনের অপেক্ষায় আছে।</p>
        </div>
      </div>

      <!-- Details -->
      <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; padding: 1.25rem; margin-bottom: 1.75rem;">
        <p style="margin: 0 0 0.75rem; color: #64748b; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px;">Submitted Details</p>
        <div style="display: flex; justify-content: space-between; padding: 0.5rem 0; border-bottom: 1px solid rgba(255,255,255,0.05);">
          <span style="color: #64748b; font-size: 0.85rem;">Company</span>
          <span style="color: #f1f5f9; font-size: 0.85rem; font-weight: 600;">{{ companyName }}</span>
        </div>
        <div style="display: flex; justify-content: space-between; padding: 0.5rem 0;">
          <span style="color: #64748b; font-size: 0.85rem;">Email</span>
          <span style="color: #a5b4fc; font-size: 0.85rem;">{{ email }}</span>
        </div>
      </div>

      <!-- Info Steps -->
      <div style="margin-bottom: 1.75rem;">
        <p style="margin: 0 0 1rem; color: #94a3b8; font-size: 0.85rem; line-height: 1.6;">
          আপনার নিবন্ধন অনুরোধ অ্যাডমিনের কাছে পাঠানো হয়েছে। অ্যাডমিন অনুমোদন করলেই আপনি লগইন করতে পারবেন এবং একটি স্বাগত ইমেইল পাবেন।
        </p>
        <div style="display: flex; flex-direction: column; gap: 0.6rem;">
          <div style="display: flex; align-items: center; gap: 0.75rem; color: #94a3b8; font-size: 0.85rem;">
            <span style="color: #f59e0b; flex-shrink: 0;">1️⃣</span> অ্যাডমিন একটি অনুমোদন ইমেইল পাবেন
          </div>
          <div style="display: flex; align-items: center; gap: 0.75rem; color: #94a3b8; font-size: 0.85rem;">
            <span style="color: #f59e0b; flex-shrink: 0;">2️⃣</span> অনুমোদন পেলে আপনার ইমেইলে নিশ্চিতকরণ বার্তা আসবে
          </div>
          <div style="display: flex; align-items: center; gap: 0.75rem; color: #94a3b8; font-size: 0.85rem;">
            <span style="color: #f59e0b; flex-shrink: 0;">3️⃣</span> এরপর আপনি লগইন করে সকল সুবিধা ব্যবহার করতে পারবেন
          </div>
        </div>
      </div>

      <!-- CTA -->
      <a href="/login" style="display: block; text-align: center; background: linear-gradient(135deg, #6366f1, #8b5cf6); color: #fff; text-decoration: none; font-size: 0.95rem; font-weight: 700; padding: 0.85rem 1.5rem; border-radius: 10px; transition: opacity 0.2s;">
        ← লগইন পাতায় ফিরুন / Back to Login
      </a>
    </div>

  </div>
</div>
