<div class="page-header">
  <div class="header-content">
    <a href="/garages" style="color: var(--color-text-muted); text-decoration: none; font-size: 0.875rem; display: inline-flex; align-items: center; gap: 0.25rem; margin-bottom: 0.5rem;">
      &larr; {{t 'garages.backToGarages'}}
    </a>
    <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
      <h1 class="page-title" style="margin: 0;">{{garage.garageName}}</h1>
      <span class="badge" style="background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3);">
        <span class="badge-dot" style="background: #10b981;"></span>{{t 'garages.facilityActive'}}
      </span>
    </div>
    <p class="page-subtitle" style="margin-top: 0.35rem;">
      <span style="color: var(--color-text-secondary);">📍 {{garage.address}}</span> &bull;
      <span>{{t 'garages.managedBy'}} {{garage.companyName}}</span> &bull;
      <span style="font-family: monospace; font-size: 0.8rem; color: var(--color-text-dim);">ID: {{garage.id}}</span>
    </p>
  </div>
  <div class="header-actions">
    <a href="/customers/new?garageId={{garage.id}}" class="btn btn-primary">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <line x1="12" y1="5" x2="12" y2="19"/>
        <line x1="5" y1="12" x2="19" y2="12"/>
      </svg>
      {{t 'nav.addCustomer'}}
    </a>
    <a href="/bills/new" class="btn btn-secondary" style="color: #38bdf8;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
      </svg>
      {{t 'bills.newBill'}}
    </a>
    {{#if isSuperAdmin}}
      <a href="/garages/{{garage.id}}/edit" class="btn btn-secondary">
        {{t 'garages.editGarage'}}
      </a>
    {{/if}}
  </div>
</div>

{{#if successMessage}}
  <div style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.3); border-radius: 8px; padding: 1rem; margin-bottom: 1.5rem; color: #34d399; font-size: 0.9rem; display: flex; align-items: center; gap: 0.5rem;">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
    {{successMessage}}
  </div>
{{/if}}

<!-- Date Filter Bar -->
<div class="card" style="padding: 1rem 1.25rem; margin-bottom: 1.5rem;">
  <!-- Mobile toggle -->
  <div class="dfb-mobile-toggle" onclick="toggleFilterDrawer('garageDashFilter')">
    <span class="dfb-toggle-icon">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="4" y1="6" x2="20" y2="6"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="10" y1="18" x2="14" y2="18"/></svg>
    </span>
    <span class="dfb-toggle-label">
      {{#if isBn}}ফিল্টার ও তারিখ{{else}}Filter & Date{{/if}}
      {{#if (or fromDate toDate)}}<span class="dfb-active-dot"></span>{{/if}}
    </span>
    <svg class="dfb-toggle-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
  </div>

  <form id="garageDashFilter" class="dfb-form dfb-collapse"
        method="GET" data-garage-id="{{garage.id}}"
        onsubmit="this.action='/garages/'+this.dataset.garageId">
    <!-- From date -->
    <div class="dfb-group">
      <label class="dfb-label" for="gdFrom">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        {{#if isBn}}শুরু{{else}}From{{/if}}
      </label>
      <input type="date" id="gdFrom" name="fromDate" class="dfb-input" value="{{fromDate}}" onchange="clearPreset('garageDashFilter')">
    </div>
    <!-- To date -->
    <div class="dfb-group">
      <label class="dfb-label" for="gdTo">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        {{#if isBn}}শেষ{{else}}To{{/if}}
      </label>
      <input type="date" id="gdTo" name="toDate" class="dfb-input" value="{{toDate}}" onchange="clearPreset('garageDashFilter')">
    </div>
    <!-- Actions -->
    <div class="dfb-actions">
      <button type="submit" class="btn btn-primary dfb-btn">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        {{#if isBn}}ফিল্টার{{else}}Filter{{/if}}
      </button>
      {{#if (or fromDate toDate)}}
        <a id="gdReset" href="/garages/{{garage.id}}" class="btn btn-secondary dfb-btn" style="color: #ef4444;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          {{#if isBn}}রিসেট{{else}}Reset{{/if}}
        </a>
      {{/if}}
    </div>
    <!-- Preset Pills -->
    <div class="dfb-presets">
      <button type="button" class="dfb-preset-pill {{#if (eq preset 'today')}}dfb-preset-active{{/if}}"
              onclick="setDatePreset('today','garageDashFilter')">{{#if isBn}}আজ{{else}}Today{{/if}}</button>
      <button type="button" class="dfb-preset-pill {{#if (eq preset 'thisMonth')}}dfb-preset-active{{/if}}"
              onclick="setDatePreset('thisMonth','garageDashFilter')">{{#if isBn}}এই মাস{{else}}This Month{{/if}}</button>
      <button type="button" class="dfb-preset-pill {{#if (eq preset 'lastMonth')}}dfb-preset-active{{/if}}"
              onclick="setDatePreset('lastMonth','garageDashFilter')">{{#if isBn}}গত মাস{{else}}Last Month{{/if}}</button>
      <button type="button" class="dfb-preset-pill {{#if (eq preset 'last30')}}dfb-preset-active{{/if}}"
              onclick="setDatePreset('last30','garageDashFilter')">{{#if isBn}}শেষ ৩০ দিন{{else}}Last 30 Days{{/if}}</button>
      <button type="button" class="dfb-preset-pill {{#if (eq preset 'thisYear')}}dfb-preset-active{{/if}}"
              onclick="setDatePreset('thisYear','garageDashFilter')">{{#if isBn}}এই বছর{{else}}This Year{{/if}}</button>
      <button type="button" class="dfb-preset-pill {{#if (eq preset 'all')}}dfb-preset-active{{/if}}"
              onclick="setDatePreset('all','garageDashFilter')">{{#if isBn}}সব{{else}}All Time{{/if}}</button>
    </div>
    <input type="hidden" name="preset" id="garageDashFilter_preset" value="{{preset}}">
  </form>

  {{#if (or fromDate toDate)}}
    <div style="margin-top: 0.75rem; display: flex; align-items: center; gap: 0.5rem; font-size: 0.8rem; color: var(--color-text-muted);">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      <span>
        {{#if isBn}}ফিল্টার করা বিল: {{else}}Filtered bills: {{/if}}
        <strong style="color: var(--color-text-primary);">{{bnNum totalFilteredBillsCount}}</strong>
        {{#if fromDate}}&nbsp;·&nbsp;{{#if isBn}}থেকে{{else}}From{{/if}} <strong>{{fromDate}}</strong>{{/if}}
        {{#if toDate}}&nbsp;·&nbsp;{{#if isBn}}পর্যন্ত{{else}}To{{/if}} <strong>{{toDate}}</strong>{{/if}}
      </span>
    </div>
  {{/if}}
</div>

<script>
  // Ensure the form action uses the correct garage ID
  (function() {
    const form = document.getElementById('garageDashFilter');
    if (form && form.dataset.garageId) {
      form.action = '/garages/' + form.dataset.garageId;
    }
  })();
</script>


<!-- Facility Metrics Grid -->
<div class="kpi-grid-6" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem; margin-bottom: 2rem;">
  <div class="card" style="padding: 1.25rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
      <span style="font-size: 0.8rem; text-transform: uppercase; color: var(--color-text-muted); font-weight: 600; letter-spacing: 0.05em;">{{t 'garages.assignedCustomers'}}</span>
      <span style="background: rgba(59, 130, 246, 0.15); color: #60a5fa; padding: 4px; border-radius: 6px;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      </span>
    </div>
    <div style="font-size: 1.75rem; font-weight: 700; color: var(--color-text-primary); margin-bottom: 0.25rem;">{{bnNum metrics.totalCustomers}}</div>
    <div style="font-size: 0.8rem; color: var(--color-text-muted);">{{t 'garages.exclusiveFacility'}}</div>
  </div>

  <div class="card" style="padding: 1.25rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
      <span style="font-size: 0.8rem; text-transform: uppercase; color: var(--color-text-muted); font-weight: 600; letter-spacing: 0.05em;">{{t 'garages.unitsConsumed'}}</span>
      <span style="background: rgba(56, 189, 248, 0.15); color: #38bdf8; padding: 4px; border-radius: 6px;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
      </span>
    </div>
    <div style="font-size: 1.75rem; font-weight: 700; color: #38bdf8; margin-bottom: 0.25rem;">{{bnNum metrics.totalUnitsConsumed}} <span style="font-size: 1rem; font-weight: 500;">{{t 'common.units'}}</span></div>
    <div style="font-size: 0.8rem; color: var(--color-text-muted);">Avg: {{bnNum metrics.averageUnitsPerCustomer}} {{t 'common.unitShort'}}</div>
  </div>

  <div class="card" style="padding: 1.25rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
      <span style="font-size: 0.8rem; text-transform: uppercase; color: var(--color-text-muted); font-weight: 600; letter-spacing: 0.05em;">{{t 'garages.electricCharges'}}</span>
      <span style="background: rgba(168, 85, 247, 0.15); color: #c084fc; padding: 4px; border-radius: 6px;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
      </span>
    </div>
    <div style="font-size: 1.75rem; font-weight: 700; color: #c084fc; margin-bottom: 0.25rem;">{{t 'common.currency'}}{{bnNum metrics.totalElectricAmount}}</div>
    <div style="font-size: 0.8rem; color: var(--color-text-muted);">{{t 'bills.electricBill'}}</div>
  </div>

  <div class="card" style="padding: 1.25rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
      <span style="font-size: 0.8rem; text-transform: uppercase; color: var(--color-text-muted); font-weight: 600; letter-spacing: 0.05em;">{{t 'garages.totalInvoiced'}}</span>
      <span style="background: rgba(99, 102, 241, 0.15); color: #818cf8; padding: 4px; border-radius: 6px;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
      </span>
    </div>
    <div style="font-size: 1.75rem; font-weight: 700; color: #818cf8; margin-bottom: 0.25rem;">{{t 'common.currency'}}{{bnNum metrics.totalBilledAmount}}</div>
    <div style="font-size: 0.8rem; color: var(--color-text-muted);">{{t 'bills.totalBill'}}</div>
  </div>

  <div class="card" style="padding: 1.25rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
      <span style="font-size: 0.8rem; text-transform: uppercase; color: var(--color-text-muted); font-weight: 600; letter-spacing: 0.05em;">{{t 'garages.collectedRevenue'}}</span>
      <span style="background: rgba(16, 185, 129, 0.15); color: #34d399; padding: 4px; border-radius: 6px;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
      </span>
    </div>
    <div style="font-size: 1.75rem; font-weight: 700; color: #34d399; margin-bottom: 0.25rem;">{{t 'common.currency'}}{{bnNum metrics.totalCollectedRevenue}}</div>
    <div style="font-size: 0.8rem; color: var(--color-text-muted);">{{t 'bills.paid'}}</div>
  </div>

  <div class="card" style="padding: 1.25rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
      <span style="font-size: 0.8rem; text-transform: uppercase; color: var(--color-text-muted); font-weight: 600; letter-spacing: 0.05em;">{{t 'garages.outstandingDues'}}</span>
      <span style="background: rgba(239, 68, 68, 0.15); color: #f87171; padding: 4px; border-radius: 6px;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      </span>
    </div>
    <div style="font-size: 1.75rem; font-weight: 700; color: #f87171; margin-bottom: 0.25rem;">{{t 'common.currency'}}{{bnNum metrics.totalOutstandingDues}}</div>
    <div style="font-size: 0.8rem; color: var(--color-text-muted);">{{t 'bills.presentDues'}}</div>
  </div>
</div>

<!-- Section 1: Facility Customer Roster -->
<div class="card" style="margin-bottom: 2rem; padding: 0; overflow: hidden; border-radius: var(--radius-lg); box-shadow: var(--shadow-sm);">
  <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; padding: 1.15rem 1.4rem; border-bottom: 1px solid var(--color-border); background: rgba(15, 23, 42, 0.4);">
    <div style="display: flex; align-items: center; gap: 0.65rem;">
      <span style="display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 8px; background: rgba(99, 102, 241, 0.15); color: #818cf8;">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      </span>
      <div>
        <h2 style="margin: 0; font-size: 1.15rem; font-weight: 700; color: var(--color-text-primary); display: flex; align-items: center; gap: 0.45rem;">
          {{t 'garages.assignedCustomers'}}
          <span class="badge" style="background: rgba(99, 102, 241, 0.15); color: #818cf8; font-size: 0.8rem; padding: 2px 8px; border-radius: 9999px;">
            {{bnNum customers.length}}
          </span>
        </h2>
        <p style="color: var(--color-text-muted); font-size: 0.8rem; margin: 0.15rem 0 0 0;">{{garage.garageName}}</p>
      </div>
    </div>
    <div>
      <a href="/customers/new?garageId={{garage.id}}" class="btn btn-primary btn-sm" style="display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 600;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        {{t 'nav.addCustomer'}}
      </a>
    </div>
  </div>

  {{#if customers.length}}
    <!-- Desktop Customers Table (> 768px) -->
    <div class="table-responsive desktop-customers-table">
      <table class="data-table bills-ledger-table">
        <thead>
          <tr>
            <th style="width: 75px;">{{t 'customers.id'}}</th>
            <th>{{t 'customers.name'}}</th>
            <th style="width: 135px;">{{t 'customers.mobile'}}</th>
            <th>{{t 'customers.address'}}</th>
            <th class="th-num" style="width: 100px; text-align: right;">{{t 'customers.baselineMeter'}}</th>
            <th class="th-num" style="width: 105px; text-align: right;">{{t 'customers.advanceMoney'}}</th>
            <th class="th-num" style="width: 125px; text-align: right; white-space: nowrap;">{{t 'customers.presentDues'}}</th>
            <th style="width: 110px; text-align: center; white-space: nowrap;">{{t 'customers.lastBill'}}</th>
            <th style="width: 95px; text-align: right;">{{t 'common.actions'}}</th>
          </tr>
        </thead>
        <tbody>
          {{#each customers}}
            <tr class="{{#unless this.isActive}}row-suspended-customer{{/unless}}" style="border-bottom: 1px solid var(--color-border); transition: background 0.15s;">
              <td>
                <span class="badge-cid">#{{#if this.cId}}{{bnNum this.cId}}{{else}}{{this.id}}{{/if}}</span>
              </td>
              <td>
                <div class="table-avatar-cell">
                  <div class="table-avatar-initials avatar-gradient-{{modulo @index 5}}">
                    {{firstChar this.name}}
                  </div>
                  <div class="table-cust-meta">
                    <div class="cust-name-row">
                      <a href="/customers/{{this.id}}" class="customer-name-link font-semibold">{{this.name}}</a>
                      {{#if this.customerCode}}
                        <span class="table-code-badge" style="font-size: 0.72rem;">{{this.customerCode}}</span>
                      {{/if}}
                      {{#unless this.isActive}}
                        <span class="badge-mini-tag badge-suspended">🚫 {{t 'customers.suspended'}}</span>
                      {{/unless}}
                    </div>
                  </div>
                </div>
              </td>
              <td>
                <div class="cell-phone-group">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-text-muted);"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                  <span style="font-family: monospace; font-size: 0.84rem;">{{this.mobileNumber}}</span>
                </div>
              </td>
              <td>
                <div style="color: var(--color-text-secondary); font-size: 0.82rem; max-width: 220px; white-space: normal; line-height: 1.35;">
                  {{#if this.address}}
                    <span title="{{this.address}}">{{this.address}}</span>
                  {{else}}
                    <span class="cell-dash">—</span>
                  {{/if}}
                </div>
              </td>
              <td class="cell-num" style="text-align: right;">
                <span class="cell-meter-val"><strong>{{bnNum this.previousUnit}}</strong> <small class="text-muted">{{t 'common.unitShort'}}</small></span>
              </td>
              <td class="cell-num" style="text-align: right;">
                {{#if (gt this.advanceMoney 0)}}
                  <span class="dues-badge dues-advance">
                    ৳{{bnMoney this.advanceMoney}}
                  </span>
                {{else}}
                  <span class="cell-dash">—</span>
                {{/if}}
              </td>
              <td class="cell-num" style="text-align: right; white-space: nowrap;">
                {{#if (gt this.presentDues 0)}}
                  <span class="dues-badge dues-has-due">
                    ৳{{bnMoney this.presentDues}}
                  </span>
                {{else if (lt this.presentDues 0)}}
                  <span class="dues-badge dues-advance">
                    ৳{{bnMoney (subtract 0 this.presentDues)}} {{#if ../isBn}}অগ্রিম{{else}}Adv{{/if}}
                  </span>
                {{else}}
                  <span class="dues-badge dues-cleared">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                    {{#if ../isBn}}পরিশোধিত{{else}}Cleared{{/if}}
                  </span>
                {{/if}}
              </td>
              <td style="text-align: center; white-space: nowrap;">
                {{#if this.lastBillDate}}
                  <span class="date-badge-pill">{{tDate this.lastBillDate}}</span>
                {{else}}
                  <span class="cell-dash" title="{{t 'common.na'}}">—</span>
                {{/if}}
              </td>
              <td style="text-align: right; white-space: nowrap;">
                <div class="table-actions-group">
                  <a href="/customers/{{this.id}}" class="btn btn-secondary btn-icon-action" title="{{t 'common.view'}}" aria-label="{{t 'common.view'}}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                  </a>
                  {{#if (or ../isSuperAdmin ../currentUser.canCreate)}}
                    {{#if (ne this.isActive false)}}
                      <a href="/bills/new?customerId={{this.id}}" class="btn btn-icon-action btn-action-bill" title="{{t 'bills.newBill'}}" aria-label="{{t 'bills.newBill'}}">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                      </a>
                    {{else}}
                      <button type="button" class="btn btn-secondary btn-icon-action" style="opacity: 0.35; cursor: not-allowed;" title="{{t 'customers.suspendedNoticeShort'}}" disabled>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                      </button>
                    {{/if}}
                  {{/if}}
                  {{#if (or ../isSuperAdmin ../currentUser.canEdit)}}
                    <a href="/customers/{{this.id}}/edit" class="btn btn-secondary btn-icon-action btn-action-edit" title="{{t 'common.edit'}}" aria-label="{{t 'common.edit'}}">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                    </a>
                  {{/if}}
                </div>
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>

    <!-- Mobile Customers Cards (<= 768px) -->
    <div class="mobile-customers-cards" style="padding: 0.85rem;">
      {{#each customers}}
        <div class="mobile-customer-card {{#if this.isActive}}mcc-active{{else}}mcc-suspended{{/if}}" style="margin-bottom: 0.75rem;">
          <!-- Card Header -->
          <div class="mcc-header">
            <div class="table-avatar-initials avatar-gradient-{{modulo @index 5}}" style="width: 36px; height: 36px; font-size: 0.85rem; flex-shrink: 0;">
              {{firstChar this.name}}
            </div>
            <div class="mcc-info">
              <div class="mcc-name-row">
                <a href="/customers/{{this.id}}" class="mcc-name">{{this.name}}</a>
              </div>
              <div class="mcc-id-badges">
                <span class="badge-cid">#{{#if this.cId}}{{bnNum this.cId}}{{else}}{{this.id}}{{/if}}</span>
                {{#if this.customerCode}}
                  <span class="table-code-badge">{{this.customerCode}}</span>
                {{/if}}
              </div>
            </div>
            <div class="mcc-status-col">
              {{#if (gt this.presentDues 0)}}
                <span class="dues-badge dues-has-due">৳{{bnMoney this.presentDues}}</span>
              {{else if (lt this.presentDues 0)}}
                <span class="dues-badge dues-advance">৳{{bnMoney (subtract 0 this.presentDues)}} {{#if ../isBn}}অগ্রিম{{else}}Adv{{/if}}</span>
              {{else}}
                <span class="dues-badge dues-cleared">✓ {{#if ../isBn}}পরিশোধিত{{else}}Cleared{{/if}}</span>
              {{/if}}
            </div>
          </div>

          <!-- Middle Meta Row: Phone & Address -->
          <div class="mcc-middle-row">
            <a href="tel:{{this.mobileNumber}}" class="mcc-phone-link">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              <span>{{this.mobileNumber}}</span>
            </a>
            {{#if this.lastBillDate}}
              <span class="date-badge-pill" style="font-size: 0.73rem;">{{tDate this.lastBillDate}}</span>
            {{/if}}
          </div>

          <!-- Stats Grid -->
          <div class="mcc-grid">
            <div class="mcc-stat-box">
              <span class="mcc-stat-lbl">{{t 'customers.baselineMeter'}}</span>
              <span class="mcc-stat-val"><strong>{{bnNum this.previousUnit}}</strong> {{t 'common.unitShort'}}</span>
            </div>
            <div class="mcc-stat-box">
              <span class="mcc-stat-lbl">{{t 'customers.advanceMoney'}}</span>
              <span class="mcc-stat-val {{#if (gt this.advanceMoney 0)}}text-success{{/if}} font-bold">
                {{#if (gt this.advanceMoney 0)}}৳{{bnMoney this.advanceMoney}}{{else}}—{{/if}}
              </span>
            </div>
            {{#if this.address}}
              <div class="mcc-stat-box" style="grid-column: 1 / -1;">
                <span class="mcc-stat-lbl">{{t 'customers.address'}}</span>
                <span class="mcc-stat-val" style="font-size: 0.8rem; font-family: inherit; font-weight: normal; white-space: normal;">{{this.address}}</span>
              </div>
            {{/if}}
          </div>

          <!-- Footer Actions -->
          <div class="mcc-footer" style="display: flex; justify-content: space-between; align-items: center;">
            <div>
              {{#unless this.isActive}}
                <span class="badge-mini-tag badge-suspended">🚫 {{t 'customers.suspended'}}</span>
              {{/unless}}
            </div>
            <div class="table-actions-group">
              <a href="/customers/{{this.id}}" class="btn btn-secondary btn-icon-action" title="{{t 'common.view'}}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              </a>
              {{#if (or ../isSuperAdmin ../currentUser.canCreate)}}
                {{#if this.isActive}}
                  <a href="/bills/new?customerId={{this.id}}" class="btn btn-icon-action btn-action-bill" title="{{t 'bills.newBill'}}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                  </a>
                {{/if}}
              {{/if}}
              {{#if (or ../isSuperAdmin ../currentUser.canEdit)}}
                <a href="/customers/{{this.id}}/edit" class="btn btn-secondary btn-icon-action btn-action-edit" title="{{t 'common.edit'}}">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                </a>
              {{/if}}
            </div>
          </div>
        </div>
      {{/each}}
    </div>
  {{else}}
    <div style="text-align: center; padding: 3rem 1rem;">
      <div style="font-size: 2.5rem; margin-bottom: 0.75rem;">👥</div>
      <h3 style="color: var(--color-text-primary); font-size: 1.15rem; font-weight: 600; margin-bottom: 0.5rem;">{{t 'garages.noCustomers'}}</h3>
      <p style="color: var(--color-text-muted); margin-bottom: 1.5rem; max-width: 400px; margin-left: auto; margin-right: auto;">
        {{garage.garageName}}
      </p>
      <a href="/customers/new?garageId={{garage.id}}" class="btn btn-primary">{{t 'nav.addCustomer'}}</a>
    </div>
  {{/if}}
</div>

<!-- Section 2: Recent Electric Billing Ledger -->
<div class="card" style="margin-bottom: 2rem; padding: 0; overflow: hidden; border-radius: var(--radius-lg); box-shadow: var(--shadow-sm);">
  <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; padding: 1.15rem 1.4rem; border-bottom: 1px solid var(--color-border); background: rgba(15, 23, 42, 0.4);">
    <div style="display: flex; align-items: center; gap: 0.65rem;">
      <span style="display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 8px; background: rgba(56, 189, 248, 0.15); color: #38bdf8;">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
      </span>
      <div>
        <h2 style="margin: 0; font-size: 1.15rem; font-weight: 700; color: var(--color-text-primary); display: flex; align-items: center; gap: 0.45rem;">
          {{t 'garages.recentBills'}}
          <span class="badge" style="background: rgba(56, 189, 248, 0.15); color: #38bdf8; font-size: 0.8rem; padding: 2px 8px; border-radius: 9999px;">
            {{bnNum recentBills.length}}
          </span>
        </h2>
        <p style="color: var(--color-text-muted); font-size: 0.8rem; margin: 0.15rem 0 0 0;">{{garage.garageName}}</p>
      </div>
    </div>
    <div>
      <a href="/bills/new" class="btn btn-primary btn-sm" style="background: #10b981; border-color: #10b981; display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 600;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        {{t 'bills.newBill'}}
      </a>
    </div>
  </div>

  {{#if recentBills.length}}
    <!-- Desktop Bills Table (> 768px) -->
    <div class="table-responsive desktop-bills-table">
      <table class="data-table bills-ledger-table">
        <thead>
          <tr>
            <th style="width: 75px;">{{t 'bills.billNo'}}</th>
            <th>{{t 'bills.customer'}}</th>
            <th style="width: 105px; text-align: center; white-space: nowrap;">{{t 'bills.billingDate'}}</th>
            <th class="th-num" style="width: 85px; text-align: right; white-space: nowrap;">{{t 'bills.currUnit'}}</th>
            <th style="width: 95px; text-align: center; white-space: nowrap;">{{t 'bills.consumed'}}</th>
            <th class="th-num" style="width: 90px; text-align: right; white-space: nowrap;">{{t 'bills.electricBill'}}</th>
            <th class="th-num" style="width: 95px; text-align: right; white-space: nowrap;">{{#if isBn}}সর্বমোট{{else}}Total{{/if}}</th>
            <th class="th-num" style="width: 85px; text-align: right; white-space: nowrap;">{{#if isBn}}পরিশোধ{{else}}Paid{{/if}}</th>
            <th class="th-num" style="width: 120px; text-align: right; white-space: nowrap;">{{t 'bills.presentDues'}}</th>
            <th style="width: 85px; text-align: right; white-space: nowrap;">{{t 'common.actions'}}</th>
          </tr>
        </thead>
        <tbody>
          {{#each recentBills}}
            <tr class="{{#if this.isLatestBill}}row-latest-bill{{else}}row-archived-bill{{/if}}" style="border-bottom: 1px solid var(--color-border); transition: background 0.15s;">
              <td>
                <span class="badge" style="background: rgba(99, 102, 241, 0.15); color: #818cf8; font-family: monospace; font-weight: 700;">#{{bnNum this.billNumber}}</span>
              </td>
              <td>
                <a href="/customers/{{this.customerId}}" class="customer-name-link font-semibold" title="{{this.customerName}}">
                  {{this.customerName}}
                </a>
              </td>
              <td style="text-align: center; white-space: nowrap;">
                <span class="date-badge-pill">{{tDate this.date}}</span>
              </td>
              <td class="cell-num font-semibold" style="text-align: right;">{{bnMoney this.currentUnit}}</td>
              <td style="text-align: center; white-space: nowrap;">
                <span class="badge-consumed-units">{{bnMoney this.totalUnit}} {{t 'common.unitShort'}}</span>
              </td>
              <td class="cell-num" style="text-align: right;">{{bnMoney this.electricBill}}</td>
              <td class="cell-num font-bold text-accent" style="text-align: right;">{{bnMoney this.totalBill}}</td>
              <td class="cell-num" style="text-align: right;">
                {{#if (gt this.clearMoney 0)}}
                  <span class="text-success font-semibold">{{bnMoney this.clearMoney}}</span>
                {{else}}
                  <span class="cell-dash">—</span>
                {{/if}}
              </td>
              <td class="cell-num" style="text-align: right; white-space: nowrap;">
                {{#if (gt this.presentDues 0)}}
                  <span class="dues-badge dues-has-due">
                    ৳{{bnMoney this.presentDues}}
                  </span>
                {{else if (lt this.presentDues 0)}}
                  <span class="dues-badge dues-advance">
                    ৳{{bnMoney (subtract 0 this.presentDues)}} {{#if ../isBn}}অগ্রিম{{else}}Adv{{/if}}
                  </span>
                {{else}}
                  <span class="dues-badge dues-cleared">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                    {{#if ../isBn}}পরিশোধিত{{else}}Cleared{{/if}}
                  </span>
                {{/if}}
              </td>
              <td style="text-align: right; white-space: nowrap;">
                <div class="table-actions-group">
                  <a href="/bills/{{this.id}}" class="btn btn-secondary btn-icon-action" title="{{t 'bills.receipt'}}" aria-label="{{t 'bills.receipt'}}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                  </a>
                  {{#if this.isLatestBill}}
                    {{#if (or ../isSuperAdmin ../currentUser.canEdit)}}
                      <a href="/bills/{{this.id}}/edit" class="btn btn-secondary btn-icon-action btn-action-edit" title="{{t 'common.edit'}}" aria-label="{{t 'common.edit'}}">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                      </a>
                    {{/if}}
                  {{else}}
                    <span class="btn-icon-action action-locked-pill" title="{{#if ../isBn}}পূর্ববর্তী রেকর্ড - শুধুমাত্র সর্বশেষ বিল পরিবর্তন করা সম্ভব{{else}}Archived bill - only the latest bill can be edited{{/if}}">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    </span>
                  {{/if}}
                </div>
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>

    <!-- Mobile Bills Cards (<= 768px) -->
    <div class="mobile-bills-cards" style="padding: 0.85rem;">
      {{#each recentBills}}
        <div class="mobile-bill-card {{#if this.isLatestBill}}mbc-latest{{else}}mbc-archived{{/if}}" style="margin-bottom: 0.75rem;">
          <div class="mbc-top">
            <div class="mbc-cust-info">
              <span class="badge" style="background: rgba(99, 102, 241, 0.15); color: #818cf8; font-family: monospace; font-size: 0.75rem; font-weight: 700;">#{{bnNum this.billNumber}}</span>
              <a href="/customers/{{this.customerId}}" class="customer-name-link font-semibold" style="margin-left: 0.35rem;">
                {{this.customerName}}
              </a>
            </div>
            <div class="mbc-meta">
              {{#if (gt this.presentDues 0)}}
                <span class="dues-badge dues-has-due">৳{{bnMoney this.presentDues}}</span>
              {{else if (lt this.presentDues 0)}}
                <span class="dues-badge dues-advance">৳{{bnMoney (subtract 0 this.presentDues)}} {{#if ../isBn}}অগ্রিম{{else}}Adv{{/if}}</span>
              {{else}}
                <span class="dues-badge dues-cleared">✓ {{#if ../isBn}}পরিশোধিত{{else}}Cleared{{/if}}</span>
              {{/if}}
            </div>
          </div>

          <div class="mbc-reading-bar">
            <span>{{#if ../isBn}}তারিখ{{else}}Date{{/if}}: <strong class="date-badge-pill" style="font-size: 0.75rem;">{{tDate this.date}}</strong></span>
            <span class="badge badge-consumed-units">{{bnMoney this.totalUnit}} {{t 'common.unitShort'}}</span>
          </div>

          <div class="mbc-grid">
            <div class="mbc-stat-box">
              <span class="mbc-stat-lbl">{{t 'bills.currUnit'}}</span>
              <span class="mbc-stat-val font-semibold">{{bnMoney this.currentUnit}}</span>
            </div>
            <div class="mbc-stat-box">
              <span class="mbc-stat-lbl">{{t 'bills.electricBill'}}</span>
              <span class="mbc-stat-val">৳{{bnMoney this.electricBill}}</span>
            </div>
            <div class="mbc-stat-box">
              <span class="mbc-stat-lbl">{{t 'bills.totalBill'}}</span>
              <span class="mbc-stat-val font-bold">৳{{bnMoney this.totalBill}}</span>
            </div>
            <div class="mbc-stat-box">
              <span class="mbc-stat-lbl">{{t 'bills.paid'}}</span>
              <span class="mbc-stat-val text-success font-bold">৳{{bnMoney this.clearMoney}}</span>
            </div>
          </div>

          <div class="mbc-bottom">
            <div class="mbc-dues">
              <span class="mbc-due-label">{{t 'bills.presentDues'}}:</span>
              <strong class="{{#if (gt this.presentDues 0)}}text-danger{{else}}text-success{{/if}}" style="font-size: 1.1rem; font-family: monospace;">
                ৳{{bnMoney this.presentDues}}
              </strong>
            </div>
            <div class="table-actions-group">
              <a href="/bills/{{this.id}}" class="btn btn-secondary btn-icon-action" title="{{t 'bills.receipt'}}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
              </a>
              {{#if this.isLatestBill}}
                {{#if (or ../isSuperAdmin ../currentUser.canEdit)}}
                  <a href="/bills/{{this.id}}/edit" class="btn btn-secondary btn-icon-action btn-action-edit" title="{{t 'common.edit'}}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                  </a>
                {{/if}}
              {{else}}
                <span class="btn-icon-action action-locked-pill" title="{{#if ../isBn}}পূর্ববর্তী রেকর্ড - শুধুমাত্র সর্বশেষ বিল পরিবর্তন করা সম্ভব{{else}}Archived bill - only the latest bill can be edited{{/if}}">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </span>
              {{/if}}
            </div>
          </div>
        </div>
      {{/each}}
    </div>
  {{else}}
    <div style="text-align: center; padding: 3rem 1rem;">
      <div style="font-size: 2.5rem; margin-bottom: 0.75rem;">⚡</div>
      <h3 style="color: var(--color-text-primary); font-size: 1.15rem; font-weight: 600; margin-bottom: 0.5rem;">{{t 'garages.noBills'}}</h3>
      <p style="color: var(--color-text-muted); margin-bottom: 1.5rem;">{{garage.garageName}}</p>
      <a href="/bills/new" class="btn btn-primary" style="background: #10b981; border-color: #10b981;">{{t 'bills.newBill'}}</a>
    </div>
  {{/if}}
</div>
