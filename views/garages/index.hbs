<div style="padding-top: 1rem; padding-bottom: 2rem;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
    <div>
      <h1 style="font-size: 1.75rem; font-weight: 700; color: var(--color-text-primary); margin: 0;">{{t 'garages.title'}}</h1>
      <p style="color: var(--color-text-muted); margin: 0.25rem 0 0 0; font-size: 0.95rem;">
        {{t 'garages.subtitle'}}
      </p>
    </div>
    {{#if isSuperAdmin}}
      <a href="/garages/new" class="btn btn-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="12" y1="5" x2="12" y2="19"/>
          <line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        {{t 'garages.newGarage'}}
      </a>
    {{/if}}
  </div>

  <!-- Search & Date Filter Toolbar -->
  <div class="card" style="padding: 1rem 1.25rem; margin-bottom: 1.5rem;">
    <form method="GET" action="/garages" id="garagesFilterForm" style="display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: flex-end;">
      <!-- Search input -->
      <div class="dfb-group" style="flex: 1; min-width: 180px;">
        <label class="dfb-label">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          {{#if isBn}}গ্যারেজ খুঁজুন{{else}}Search Garages{{/if}}
        </label>
        <input type="text" name="search" class="dfb-input" placeholder="{{#if isBn}}নাম বা ঠিকানা...{{else}}Name or address...{{/if}}" value="{{search}}">
      </div>
      <!-- From Date -->
      <div class="dfb-group">
        <label class="dfb-label">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          {{#if isBn}}নিবন্ধন শুরু{{else}}Registered From{{/if}}
        </label>
        <input type="date" name="fromDate" class="dfb-input" value="{{fromDate}}">
      </div>
      <!-- To Date -->
      <div class="dfb-group">
        <label class="dfb-label">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          {{#if isBn}}নিবন্ধন শেষ{{else}}Registered To{{/if}}
        </label>
        <input type="date" name="toDate" class="dfb-input" value="{{toDate}}">
      </div>
      <!-- Actions -->
      <div class="dfb-actions">
        <button type="submit" class="btn btn-primary dfb-btn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          {{#if isBn}}ফিল্টার{{else}}Filter{{/if}}
        </button>
        {{#if (or search fromDate toDate)}}
          <a href="/garages" class="btn btn-secondary dfb-btn" style="color: #ef4444;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            {{#if isBn}}রিসেট{{else}}Reset{{/if}}
          </a>
        {{/if}}
      </div>
    </form>
    <!-- Result badge -->
    <div style="margin-top: 0.6rem; font-size: 0.8rem; color: var(--color-text-muted);">
      {{#if isBn}}মোট: {{else}}Showing: {{/if}}
      <strong style="color: var(--color-text-primary);">{{bnNum totalGaragesCount}}</strong>
      {{#if isBn}}টি গ্যারেজ{{else}} garage(s){{/if}}
      {{#if (or search fromDate toDate)}}
        <span style="color: #38bdf8;"> · ফিল্টার সক্রিয়</span>
      {{/if}}
    </div>
  </div>

  {{#if garages.length}}
    <div class="garages-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.25rem;">
      {{#each garages}}
        <div class="card" style="padding: 1.5rem; display: flex; flex-direction: column; justify-content: space-between; transition: transform 0.2s, box-shadow 0.2s; {{#unless this.isActive}}border-left: 3px solid #ef4444; background: rgba(239, 68, 68, 0.02);{{/unless}}">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem;">
              <div style="display: flex; align-items: flex-start; gap: 0.75rem;">
                <div style="width: 44px; height: 44px; background: {{#if this.isActive}}rgba(59, 130, 246, 0.15){{else}}rgba(239, 68, 68, 0.15){{/if}}; color: {{#if this.isActive}}#3b82f6{{else}}#ef4444{{/if}}; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                    <polyline points="9 22 9 12 15 12 15 22"/>
                  </svg>
                </div>
                <div>
                  <h3 style="font-size: 1.15rem; font-weight: 700; color: var(--color-text-primary); margin: 0 0 0.25rem 0;">{{this.garageName}}</h3>
                  <div style="display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap;">
                    <span style="display: inline-block; background: rgba(59, 130, 246, 0.15); color: #60a5fa; padding: 2px 8px; border-radius: 9999px; font-size: 0.75rem; font-weight: 600;">
                      👥 {{bnNum this.customerCount}} {{t 'garages.customersBadge'}}
                    </span>
                    {{#if this.isActive}}
                      <span class="status-pill status-active" style="font-size: 0.72rem; padding: 2px 8px;">{{t 'garages.active'}}</span>
                    {{else}}
                      <span class="status-pill status-suspended" style="font-size: 0.72rem; padding: 2px 8px;">{{t 'garages.suspended'}}</span>
                    {{/if}}
                  </div>
                </div>
              </div>
              <div style="display: flex; align-items: center; gap: 0.35rem;">
                {{#if ../isSuperAdmin}}
                  {{#if this.isActive}}
                    <form action="/garages/{{this.id}}/toggle-status" method="POST" style="display: inline; margin: 0;"
                          data-confirm-modal="true"
                          data-confirm-type="warning"
                          data-confirm-icon="⚠️"
                          data-confirm-title="{{t 'garages.suspendModalTitle'}}"
                          data-confirm-desc="{{t 'garages.suspendModalDesc'}}"
                          data-confirm-warning="{{t 'garages.suspendModalWarning'}}"
                          data-confirm-submit="{{t 'garages.suspendModalBtn'}}"
                          data-confirm-target-name="{{this.garageName}}"
                          data-confirm-target-sub="{{#if this.address}}{{this.address}}{{else}}ID: {{this.id}}{{/if}}"
                          data-confirm-target-badge="{{t 'garages.active'}}"
                          data-confirm-target-badge-class="badge-success">
                      <button type="submit" class="btn btn-icon-action btn-action-suspend" title="{{t 'garages.suspendAction'}}" aria-label="{{t 'garages.suspendAction'}}">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                      </button>
                    </form>
                  {{else}}
                    <form action="/garages/{{this.id}}/toggle-status" method="POST" style="display: inline; margin: 0;"
                          data-confirm-modal="true"
                          data-confirm-type="success"
                          data-confirm-icon="⚡"
                          data-confirm-title="{{t 'garages.reactivateModalTitle'}}"
                          data-confirm-desc="{{t 'garages.reactivateModalDesc'}}"
                          data-confirm-warning="{{t 'garages.reactivateModalNotice'}}"
                          data-confirm-submit="{{t 'garages.reactivateModalBtn'}}"
                          data-confirm-btn-class="btn-success"
                          data-confirm-target-name="{{this.garageName}}"
                          data-confirm-target-sub="{{#if this.address}}{{this.address}}{{else}}ID: {{this.id}}{{/if}}"
                          data-confirm-target-badge="{{t 'garages.suspended'}}"
                          data-confirm-target-badge-class="badge-danger">
                      <button type="submit" class="btn btn-icon-action btn-action-reactivate" title="{{t 'garages.reactivateAction'}}" aria-label="{{t 'garages.reactivateAction'}}">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                      </button>
                    </form>
                  {{/if}}
                  <a href="/garages/{{this.id}}/edit" class="btn btn-secondary btn-icon-action" title="{{t 'common.edit'}}" aria-label="{{t 'common.edit'}}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                  </a>
                {{/if}}
              </div>
            </div>

            <div style="margin-bottom: 1.25rem;">
              <div style="font-size: 0.8rem; text-transform: uppercase; color: var(--color-text-dim); font-weight: 600; margin-bottom: 0.25rem;">{{t 'garages.address'}}</div>
              <div style="font-size: 0.95rem; color: var(--color-text-secondary);">{{this.address}}</div>
            </div>
          </div>

          <div>
            <div style="display: flex; gap: 0.5rem; margin-bottom: 0.75rem;">
              <a href="/garages/{{this.id}}" class="btn btn-primary" style="flex: 1; text-align: center; justify-content: center; font-size: 0.875rem;">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 0.25rem;">
                  <line x1="18" y1="20" x2="18" y2="10"/>
                  <line x1="12" y1="20" x2="12" y2="4"/>
                  <line x1="6" y1="20" x2="6" y2="14"/>
                </svg>
                {{t 'garages.viewDashboard'}}
              </a>
              {{#if (or ../isSuperAdmin ../currentUser.canCreate)}}
                {{#if this.isActive}}
                  <a href="/customers/new?garageId={{this.id}}" class="btn btn-secondary" style="font-size: 0.875rem;" title="Add Customer to this Garage">
                    + {{t 'nav.customers'}}
                  </a>
                {{else}}
                  <button type="button" class="btn btn-secondary" style="font-size: 0.875rem; opacity: 0.5; cursor: not-allowed;" title="{{t 'garages.suspendedNoticeShort'}}" disabled>
                    + {{t 'nav.customers'}}
                  </button>
                {{/if}}
              {{/if}}
            </div>

            <div style="border-top: 1px solid var(--color-border); padding-top: 0.5rem; display: flex; justify-content: space-between; align-items: center; font-size: 0.75rem; color: var(--color-text-muted);">
              <div style="display: flex; align-items: center; gap: 0.4rem;">
                {{#if this.isActive}}
                  <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #10b981;"></span>
                  <span style="color: #10b981; font-weight: 500;">{{t 'garages.facilityActive'}}</span>
                {{else}}
                  <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #ef4444;"></span>
                  <span style="color: #ef4444; font-weight: 500;">{{t 'garages.facilitySuspended'}}</span>
                {{/if}}
              </div>
              <span>ID: {{this.id}}</span>
            </div>
          </div>
        </div>
      {{/each}}
    </div>
  {{else}}
    <div class="card" style="text-align: center; padding: 4rem 2rem;">
      <div style="width: 64px; height: 64px; background: rgba(59, 130, 246, 0.1); color: var(--color-primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
        </svg>
      </div>
      <h2 style="font-size: 1.25rem; font-weight: 700; margin: 0 0 0.5rem 0;">{{t 'garages.noGarages'}}</h2>
      <p style="color: var(--color-text-muted); max-width: 400px; margin: 0 auto 1.5rem;">
        {{t 'garages.noGaragesSub'}}
      </p>
      {{#if isSuperAdmin}}
        <a href="/garages/new" class="btn btn-primary">{{t 'garages.registerFirst'}}</a>
      {{/if}}
    </div>
  {{/if}}
</div>
