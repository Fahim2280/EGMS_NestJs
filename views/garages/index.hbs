<div class="container" style="padding-top: 2rem; padding-bottom: 3rem;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
    <div>
      <h1 style="font-size: 1.75rem; font-weight: 700; color: #fff; margin: 0;">Company Garages</h1>
      <p style="color: var(--color-text-muted); margin: 0.25rem 0 0 0; font-size: 0.95rem;">
        Managed workshop locations, service bays, and physical facilities
      </p>
    </div>
    {{#if isSuperAdmin}}
      <a href="/garages/new" class="btn btn-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="12" y1="5" x2="12" y2="19"/>
          <line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        Register New Garage
      </a>
    {{/if}}
  </div>

  {{#if garages.length}}
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem;">
      {{#each garages}}
        <div class="card" style="padding: 1.5rem; display: flex; flex-direction: column; justify-content: space-between; transition: transform 0.2s, box-shadow 0.2s;">
          <div>
            <div style="display: flex; align-items: flex-start; gap: 1rem; margin-bottom: 1rem;">
              <div style="width: 44px; height: 44px; background: rgba(59, 130, 246, 0.15); color: #3b82f6; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                  <polyline points="9 22 9 12 15 12 15 22"/>
                </svg>
              </div>
              <div>
                <h3 style="font-size: 1.15rem; font-weight: 700; color: #fff; margin: 0 0 0.25rem 0;">{{this.garageName}}</h3>
                <span style="font-size: 0.75rem; color: var(--color-text-muted); font-family: monospace;">UUID: {{this.id}}</span>
              </div>
            </div>

            <div style="margin-bottom: 1rem;">
              <div style="font-size: 0.8rem; text-transform: uppercase; color: var(--color-text-dim); font-weight: 600; margin-bottom: 0.25rem;">Address</div>
              <div style="font-size: 0.95rem; color: var(--color-text-secondary);">{{this.address}}</div>
            </div>
          </div>

          <div style="border-top: 1px solid var(--color-border); padding-top: 0.75rem; display: flex; justify-content: space-between; align-items: center; font-size: 0.8rem; color: var(--color-text-muted);">
            <span>Operational Facility</span>
            <span>Registered: {{this.createdAt}}</span>
          </div>
        </div>
      {{/each}}
    </div>
  {{else}}
    <div class="card" style="text-align: center; padding: 4rem 2rem;">
      <div style="width: 64px; height: 64px; background: rgba(59, 130, 246, 0.1); color: var(--color-primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
        </svg>
      </div>
      <h2 style="font-size: 1.25rem; font-weight: 700; margin: 0 0 0.5rem 0;">No Garages Registered</h2>
      <p style="color: var(--color-text-muted); max-width: 400px; margin: 0 auto 1.5rem;">
        Your company does not currently have any physical garages or service centers registered in the system.
      </p>
      {{#if isSuperAdmin}}
        <a href="/garages/new" class="btn btn-primary">Register First Garage</a>
      {{/if}}
    </div>
  {{/if}}
</div>
