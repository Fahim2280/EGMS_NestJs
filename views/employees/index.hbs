<div style="padding-top: 1rem; padding-bottom: 2rem;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
    <div>
      <h1 style="font-size: 1.75rem; font-weight: 700; color: var(--color-text-primary); margin: 0;">{{t 'employees.title'}}</h1>
      <p style="color: var(--color-text-muted); margin: 0.25rem 0 0 0; font-size: 0.95rem;">
        {{t 'employees.subtitle'}}
      </p>
    </div>
    {{#if isSuperAdmin}}
      <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;" class="header-actions">
        <a href="/employees/permissions" class="btn btn-secondary" style="display: inline-flex; align-items: center; gap: 0.4rem;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          {{t 'employees.managePermissions'}}
        </a>
        <a href="/employees/new" class="btn btn-primary" style="display: inline-flex; align-items: center; gap: 0.4rem;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="12" y1="5" x2="12" y2="19"/>
            <line x1="5" y1="12" x2="19" y2="12"/>
          </svg>
          {{t 'employees.addEmployee'}}
        </a>
      </div>
    {{/if}}
  </div>

  {{#if employees.length}}
    <div class="card" style="padding: 0; overflow: hidden; box-shadow: var(--shadow-md);">
      <div class="table-container" style="overflow-x: auto;">
        <table class="data-table" style="width: 100%; border-collapse: collapse;">
          <thead>
            <tr style="background: rgba(15, 23, 42, 0.8); border-bottom: 1px solid var(--color-border); text-align: left;">
              <th style="padding: 1rem;">{{t 'employees.name'}}</th>
              <th style="padding: 1rem;">{{t 'employees.email'}}</th>
              <th style="padding: 1rem;">{{t 'employees.phone'}}</th>
              <th style="padding: 1rem;">{{t 'employees.role'}}</th>
              <th style="padding: 1rem;">{{t 'employees.status'}}</th>
              <th style="padding: 1rem;">{{t 'employees.nid'}}</th>
              <th style="padding: 1rem; text-align: right;">{{t 'common.actions'}}</th>
            </tr>
          </thead>
          <tbody>
            {{#each employees}}
              <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.05); transition: background 0.15s;">
                <td style="padding: 1rem; font-weight: 600;">
                  <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <div class="user-avatar" style="width: 34px; height: 34px; font-size: 0.85rem; background: rgba(99, 102, 241, 0.2); color: #818cf8; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700;">
                      {{this.name.[0]}}
                    </div>
                    <div>
                      <a href="/employees/{{this.id}}" style="color: var(--color-text-primary); font-weight: 600;">{{this.name}}</a>
                      <div style="font-size: 0.75rem; color: var(--color-text-muted); font-family: monospace;">UUID: {{this.id}}</div>
                    </div>
                  </div>
                </td>
                <td style="padding: 1rem; color: var(--color-text-secondary);">{{this.email}}</td>
                <td style="padding: 1rem; color: var(--color-text-secondary);">{{this.phoneNumber}}</td>
                <td style="padding: 1rem;">{{{roleBadge this.role}}}</td>
                <td style="padding: 1rem;">
                  {{#if this.isActive}}
                    <span class="badge badge-active"><span class="badge-dot"></span>{{t 'common.active'}}</span>
                  {{else}}
                    <span class="badge" style="background: rgba(239, 68, 68, 0.15); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.2);"><span class="badge-dot" style="background: #ef4444;"></span>{{t 'employees.suspended'}}</span>
                  {{/if}}
                </td>
                <td style="padding: 1rem;">
                  <span style="font-family: monospace; background: rgba(59, 130, 246, 0.1); color: #93c5fd; padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.85rem; border: 1px solid rgba(59, 130, 246, 0.2);">
                    {{this.nidNumber}}
                  </span>
                </td>
                <td style="padding: 1rem; text-align: right;">
                  <div style="display: flex; gap: 0.4rem; justify-content: flex-end;">
                    <a href="/employees/{{this.id}}" class="btn btn-secondary btn-sm" title="{{t 'common.view'}}">{{t 'common.view'}}</a>
                    <a href="/employees/{{this.id}}/edit" class="btn btn-secondary btn-sm" title="{{t 'common.edit'}}">{{t 'common.edit'}}</a>
                    <a href="/employees/permissions" class="btn btn-primary btn-sm" title="{{t 'employees.managePermissions'}}" style="background: rgba(99, 102, 241, 0.2); border-color: rgba(99, 102, 241, 0.4); color: #a5b4fc;">🛡️ {{t 'nav.permissions'}}</a>
                  </div>
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </div>
  {{else}}
    <div class="card" style="text-align: center; padding: 4rem 2rem;">
      <div style="width: 64px; height: 64px; background: rgba(16, 185, 129, 0.1); color: #10b981; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
          <circle cx="9" cy="7" r="4"/>
        </svg>
      </div>
      <h2 style="font-size: 1.25rem; font-weight: 700; margin: 0 0 0.5rem 0;">{{t 'employees.noEmployees'}}</h2>
      <p style="color: var(--color-text-muted); max-width: 400px; margin: 0 auto 1.5rem;">
        {{t 'employees.noEmployeesSub'}}
      </p>
      {{#if isSuperAdmin}}
        <a href="/employees/new" class="btn btn-primary">{{t 'employees.addFirst'}}</a>
      {{/if}}
    </div>
  {{/if}}
</div>
