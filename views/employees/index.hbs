<div class="container" style="padding-top: 2rem; padding-bottom: 3rem;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
    <div>
      <h1 style="font-size: 1.75rem; font-weight: 700; color: #fff; margin: 0;">Employee Roster</h1>
      <p style="color: var(--color-text-muted); margin: 0.25rem 0 0 0; font-size: 0.95rem;">
        Staff members, technicians, and general personnel connected to your company
      </p>
    </div>
    {{#if isSuperAdmin}}
      <a href="/employees/new" class="btn btn-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="12" y1="5" x2="12" y2="19"/>
          <line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        Add New Employee
      </a>
    {{/if}}
  </div>

  {{#if employees.length}}
    <div class="card" style="padding: 0; overflow: hidden; box-shadow: var(--shadow-md);">
      <div class="table-container" style="overflow-x: auto;">
        <table class="data-table" style="width: 100%; border-collapse: collapse;">
          <thead>
            <tr style="background: rgba(15, 23, 42, 0.8); border-bottom: 1px solid var(--color-border); text-align: left;">
              <th style="padding: 1rem;">Employee Name</th>
              <th style="padding: 1rem;">Email Address</th>
              <th style="padding: 1rem;">Phone Number</th>
              <th style="padding: 1rem;">Role</th>
              <th style="padding: 1rem;">NID Number</th>
              <th style="padding: 1rem;">Residential Address</th>
              <th style="padding: 1rem;">Joined Date</th>
            </tr>
          </thead>
          <tbody>
            {{#each employees}}
              <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.05); transition: background 0.15s;">
                <td style="padding: 1rem; font-weight: 600;">
                  <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <div class="user-avatar" style="width: 34px; height: 34px; font-size: 0.85rem; background: rgba(99, 102, 241, 0.2); color: #818cf8; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700;">
                      {{this.name.[0]}}
                    </div>
                    <div>
                      <div style="color: #fff;">{{this.name}}</div>
                      <div style="font-size: 0.75rem; color: var(--color-text-muted); font-family: monospace;">UUID: {{this.id}}</div>
                    </div>
                  </div>
                </td>
                <td style="padding: 1rem; color: var(--color-text-secondary);">{{this.email}}</td>
                <td style="padding: 1rem; color: var(--color-text-secondary);">{{this.phoneNumber}}</td>
                <td style="padding: 1rem;">{{{roleBadge this.role}}}</td>
                <td style="padding: 1rem;">
                  <span style="font-family: monospace; background: rgba(59, 130, 246, 0.1); color: #93c5fd; padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.85rem; border: 1px solid rgba(59, 130, 246, 0.2);">
                    {{this.nidNumber}}
                  </span>
                </td>
                <td style="padding: 1rem; color: var(--color-text-muted); font-size: 0.85rem;">{{this.address}}</td>
                <td style="padding: 1rem; color: var(--color-text-muted); font-size: 0.85rem;">{{this.createdAt}}</td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </div>
  {{else}}
    <div class="card" style="text-align: center; padding: 4rem 2rem;">
      <div style="width: 64px; height: 64px; background: rgba(16, 185, 129, 0.1); color: #10b981; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
          <circle cx="9" cy="7" r="4"/>
        </svg>
      </div>
      <h2 style="font-size: 1.25rem; font-weight: 700; margin: 0 0 0.5rem 0;">No Employees Registered</h2>
      <p style="color: var(--color-text-muted); max-width: 400px; margin: 0 auto 1.5rem;">
        There are currently no staff members or employees associated with this company in the directory.
      </p>
      {{#if isSuperAdmin}}
        <a href="/employees/new" class="btn btn-primary">Add First Employee</a>
      {{/if}}
    </div>
  {{/if}}
</div>
