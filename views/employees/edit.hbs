<div class="page-header">
  <div class="page-header-content">
    <div>
      <h1 class="page-title">✏️ {{t 'employees.editEmployeeTitle'}}</h1>
      <p class="page-subtitle">{{t 'employees.editEmployeeSubtitle'}} <strong style="color:#a5b4fc;">{{employee.name}}</strong></p>
    </div>
    <div style="display:flex;gap:0.75rem;">
      <a href="/employees/{{employee.id}}" class="btn btn-outline">← {{t 'employees.backToProfile'}}</a>
    </div>
  </div>
</div>

<div style="max-width:680px;margin:0 auto;">
  <div class="card">
    <div class="card-header">
      <h3 class="card-title">{{t 'employees.employeeDetails'}}</h3>
      <p class="card-subtitle">{{t 'employees.detailsSubtitle'}}</p>
    </div>
    <div class="card-body">
      {{#if error}}
        <div class="alert alert-danger" style="margin-bottom:1.5rem;">{{error}}</div>
      {{/if}}

      <form method="POST" action="/employees/{{employee.id}}/edit">
        <div class="form-group">
          <label class="form-label">{{#if isBn}}পুরো নাম{{else}}Full Name{{/if}} <span class="required">*</span></label>
          <input type="text" name="name" class="form-control" value="{{employee.name}}" required minlength="2" placeholder="{{#if isBn}}পুরো নাম{{else}}Full name{{/if}}">
        </div>

        <div class="form-group">
          <label class="form-label">{{t 'employees.emailReadOnly'}}</label>
          <input type="email" class="form-control" value="{{employee.email}}" disabled style="opacity:0.6;cursor:not-allowed;">
          <p class="form-help">{{t 'employees.emailNotice'}}</p>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
          <div class="form-group">
            <label class="form-label">{{t 'employees.phone'}} <span class="required">*</span></label>
            <input type="text" name="phoneNumber" class="form-control" value="{{employee.phoneNumber}}" required placeholder="01XXXXXXXXX">
          </div>
          <div class="form-group">
            <label class="form-label">{{t 'employees.nid'}} <span class="required">*</span></label>
            <input type="text" name="nidNumber" class="form-control" value="{{employee.nidNumber}}" required placeholder="{{#if isBn}}জাতীয় পরিচয়পত্র নম্বর{{else}}National ID Number{{/if}}">
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">{{#if isBn}}ঠিকানা{{else}}Address{{/if}} <span class="required">*</span></label>
          <textarea name="address" class="form-control" rows="3" required placeholder="{{#if isBn}}পুরো ঠিকানা{{else}}Full address{{/if}}">{{employee.address}}</textarea>
        </div>

        <div style="display:flex;gap:1rem;justify-content:flex-end;margin-top:1.5rem;">
          <a href="/employees/{{employee.id}}" class="btn btn-outline">{{t 'common.cancel'}}</a>
          <button type="submit" class="btn btn-primary">💾 {{t 'customers.saveChanges'}}</button>
        </div>
      </form>
    </div>
  </div>
</div>
