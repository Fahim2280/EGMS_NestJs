<!-- Sidebar Navigation Bar -->
<style>
  [data-theme="light"] .sidebar-brand-text .brand-name {
    color: #0f172a !important;
    background: none !important;
    -webkit-background-clip: initial !important;
    background-clip: initial !important;
    -webkit-text-fill-color: #0f172a !important;
    font-weight: 800 !important;
  }
  [data-theme="light"] .sidebar-brand-text .brand-sub {
    color: #4f46e5 !important;
    -webkit-text-fill-color: #4f46e5 !important;
    font-weight: 600 !important;
  }
</style>
<aside class="sidebar" id="appSidebar">
  <!-- Sidebar Header / Brand -->
  <div class="sidebar-header">
    <a href="/" class="sidebar-brand">
      <div class="sidebar-brand-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
        </svg>
      </div>
      <div class="sidebar-brand-text">
        <span class="brand-name">EGMS Portal</span>
        <span class="brand-sub">Electric Garage System</span>
      </div>
    </a>
    <button class="sidebar-close-btn" id="sidebarCloseBtn" aria-label="Close Sidebar">&times;</button>
  </div>

  {{#if currentUser}}
  <!-- Company / Tenant Badge -->
  <div class="sidebar-tenant">
    <div class="tenant-icon">🏢</div>
    <div class="tenant-details">
      <div class="tenant-name" title="{{currentUser.companyName}}">{{currentUser.companyName}}</div>
      <div class="tenant-role">
        {{#if (or (eq currentUser.role 'SUPER_ADMIN') currentUser.isSuperAdmin isSuperAdmin)}}
          <span class="badge badge-admin" style="font-size:0.7rem;padding:0.15rem 0.5rem;"><span class="badge-dot"></span>{{t 'nav.superAdmin'}}</span>
        {{else}}
          <span class="badge badge-officer" style="font-size:0.7rem;padding:0.15rem 0.5rem;"><span class="badge-dot"></span>{{t 'nav.generalStaff'}}</span>
        {{/if}}
      </div>
    </div>
  </div>
  {{/if}}

  <!-- Navigation Menu Sections -->
  <div class="sidebar-content">
    <nav class="sidebar-nav">
      <!-- Section: Overview -->
      <div class="nav-section-label">{{t 'nav.overview'}}</div>
      <a href="/" class="sidebar-link {{#if (eq activeNav 'dashboard')}}active{{/if}}">
        <span class="link-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
            <rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
          </svg>
        </span>
        <span class="link-text">{{t 'nav.dashboard'}}</span>
      </a>

      <!-- Section: Operations -->
      <div class="nav-section-label">{{t 'nav.operations'}}</div>
      {{#if (or (eq currentUser.role 'SUPER_ADMIN') currentUser.isSuperAdmin isSuperAdmin currentUser.garageIds.length)}}
      <a href="/garages" class="sidebar-link {{#if (eq activeNav 'garages')}}active{{/if}}">
        <span class="link-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
          </svg>
        </span>
        <span class="link-text">{{t 'nav.garages'}}</span>
      </a>
      {{/if}}

      <a href="/customers" class="sidebar-link {{#if (eq activeNav 'customers')}}active{{/if}}">
        <span class="link-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
        </span>
        <span class="link-text">{{t 'nav.customers'}}</span>
      </a>

      <a href="/bills" class="sidebar-link {{#if (eq activeNav 'bills')}}active{{/if}}">
        <span class="link-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/>
            <line x1="16" y1="17" x2="8" y2="17"/>
          </svg>
        </span>
        <span class="link-text">{{t 'nav.bills'}}</span>
      </a>

      {{#if (or (eq currentUser.role 'SUPER_ADMIN') currentUser.isSuperAdmin isSuperAdmin)}}
      <!-- Section: Administration -->
      <div class="nav-section-label">{{t 'nav.administration'}}</div>
      <a href="/employees" class="sidebar-link {{#if (eq activeNav 'employees')}}active{{/if}}">
        <span class="link-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
          </svg>
        </span>
        <span class="link-text">{{t 'nav.employees'}}</span>
      </a>

      <a href="/employees/permissions" class="sidebar-link {{#if (eq activeNav 'permissions')}}active{{/if}}">
        <span class="link-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
        </span>
        <span class="link-text">{{t 'nav.permissions'}}</span>
      </a>

      <a href="/audit-logs" class="sidebar-link {{#if (eq activeNav 'audit-logs')}}active{{/if}}">
        <span class="link-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <path d="M9 12l2 2 4-4"/>
          </svg>
        </span>
        <span class="link-text">{{t 'nav.auditLogs'}}</span>
      </a>
      {{/if}}

      {{#if (or (eq currentUser.role 'SUPER_ADMIN') currentUser.isSuperAdmin isSuperAdmin currentUser.canCreate)}}
      <!-- Section: Quick Actions -->
      <div class="nav-section-label">{{t 'nav.quickActions'}}</div>
      <a href="/bills/new" class="sidebar-link quick-action-link" style="color: #34d399;">
        <span class="link-icon" style="color: #34d399;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
          </svg>
        </span>
        <span class="link-text">{{t 'nav.newBill'}}</span>
      </a>

      <a href="/customers/new" class="sidebar-link quick-action-link" style="color: #818cf8;">
        <span class="link-icon" style="color: #818cf8;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>
            <line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/>
          </svg>
        </span>
        <span class="link-text">{{t 'nav.addCustomer'}}</span>
      </a>
      {{/if}}
    </nav>
  </div>

  <!-- Sidebar Footer: User Profile Card -->
  {{#if currentUser}}
  <div class="sidebar-footer">
    <div class="sidebar-user-card">
      <div class="sidebar-user-avatar">
        {{currentUser.name.[0]}}
      </div>
      <div class="sidebar-user-info">
        <div class="sidebar-user-name" title="{{currentUser.name}}">{{currentUser.name}}</div>
        <div class="sidebar-user-email" title="{{currentUser.email}}">{{currentUser.email}}</div>
      </div>
      <div class="sidebar-user-actions">
        {{#if (or (eq currentUser.role 'SUPER_ADMIN') currentUser.isSuperAdmin isSuperAdmin)}}
        <a href="/profile/edit" class="sidebar-action-btn" title="Company Profile &amp; Electricity Rate">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
          </svg>
        </a>
        {{/if}}
        <a href="/logout" class="sidebar-action-btn logout" title="Sign Out">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
            <polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
  {{else}}
  <div class="sidebar-footer" style="padding: 1rem;">
    <a href="/login" class="btn btn-primary" style="width: 100%; justify-content: center;">Sign In</a>
  </div>
  {{/if}}
</aside>

<!-- Mobile Overlay Backdrop -->
<div class="sidebar-backdrop" id="sidebarBackdrop"></div>
