<!-- Top Application Header -->
<header class="app-topbar">
  <div class="topbar-left">
    <!-- Hamburger button for opening sidebar on mobile / collapsing -->
    <button class="topbar-toggle-btn" id="sidebarToggleBtn" aria-label="Toggle Sidebar Navigation">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>

    <!-- Page Breadcrumb / Title Indicator -->
    <div class="topbar-breadcrumb">
      <span class="breadcrumb-root">EGMS</span>
      <span class="breadcrumb-separator">/</span>
      <span class="breadcrumb-current">
        {{#if (eq activeNav 'dashboard')}}{{t 'nav.dashboard'}}
        {{else if (eq activeNav 'customers')}}{{t 'nav.customers'}}
        {{else if (eq activeNav 'bills')}}{{t 'nav.bills'}}
        {{else if (eq activeNav 'garages')}}{{t 'nav.garages'}}
        {{else if (eq activeNav 'employees')}}{{t 'nav.employees'}}
        {{else if (eq activeNav 'permissions')}}{{t 'nav.permissions'}}
        {{else if (eq activeNav 'audit-logs')}}{{t 'nav.auditLogs'}}
        {{else}}{{title}}
        {{/if}}
      </span>
    </div>
  </div>

  <div class="topbar-right">
    <!-- Language Switcher Pill Button -->
    <div class="lang-switcher">
      {{#if isBn}}
        <a href="/lang/en" class="lang-switch-btn" id="langSwitchBtn" title="Switch to English" data-lang="en">
          <span class="lang-code-active">বাং</span>
          <span class="lang-code-inactive">| EN</span>
        </a>
      {{else}}
        <a href="/lang/bn" class="lang-switch-btn" id="langSwitchBtn" title="বাংলায় পরিবর্তন করুন" data-lang="bn">
          <span class="lang-code-active">EN</span>
          <span class="lang-code-inactive">| বাং</span>
        </a>
      {{/if}}
    </div>

    <!-- Theme Switcher Button (Dark / Light) -->
    <button class="theme-toggle-btn" id="themeToggleBtn" aria-label="Toggle Dark / Light Theme" title="{{#if isLight}}{{t 'theme.toggleDark'}}{{else}}{{t 'theme.toggleLight'}}{{/if}}">
      <svg class="theme-icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="{{#if isLight}}display:none;{{else}}display:block;{{/if}}">
        <circle cx="12" cy="12" r="5"/>
        <line x1="12" y1="1" x2="12" y2="3"/>
        <line x1="12" y1="21" x2="12" y2="23"/>
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
        <line x1="1" y1="12" x2="3" y2="12"/>
        <line x1="21" y1="12" x2="23" y2="12"/>
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
      </svg>
      <svg class="theme-icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="{{#if isLight}}display:block;{{else}}display:none;{{/if}}">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
      </svg>
    </button>

    <!-- System Status Indicator -->
    <div class="system-status-indicator desktop-only">
      <span class="status-pulse-dot"></span>
      <span>{{t 'nav.systemActive'}}</span>
    </div>

    {{#if (or (eq currentUser.role 'SUPER_ADMIN') currentUser.isSuperAdmin isSuperAdmin)}}
      <!-- Super Admin Audit & Security Notification Bell -->
      <div class="topbar-notif-wrapper" id="auditNotifWrapper">
        <button class="topbar-notif-btn" id="auditNotifBtn" type="button" aria-label="Audit & Security Alerts" title="{{t 'notif.title'}}">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
          </svg>
          <span class="topbar-notif-badge" id="auditNotifBadge" style="display: none;">0</span>
          <span class="topbar-notif-pulse" id="auditNotifPulse" style="display: none;"></span>
        </button>

        <!-- Notification Dropdown Menu -->
        <div class="audit-notif-dropdown" id="auditNotifDropdown" style="display: none;">
          <div class="audit-notif-header">
            <div style="display: flex; align-items: center; gap: 0.5rem;">
              <span style="font-size: 1rem;">🛡️</span>
              <span class="audit-notif-title">{{t 'notif.title'}}</span>
              <span class="audit-notif-pill" id="auditNotifPill" style="display: none;">0</span>
            </div>
            <div style="display: flex; align-items: center; gap: 0.35rem;">
              <button type="button" class="audit-notif-read-btn" id="auditNotifMarkReadBtn">
                {{t 'notif.markAllRead'}}
              </button>
              <button type="button" class="audit-notif-close-btn" id="auditNotifCloseBtn" aria-label="Close" style="background: none; border: none; color: var(--color-text-muted); font-size: 1.2rem; line-height: 1; cursor: pointer; padding: 0.2rem 0.45rem; border-radius: 4px; display: inline-flex; align-items: center; justify-content: center; transition: all 0.15s ease;">
                &times;
              </button>
            </div>
          </div>

          <div class="audit-notif-list" id="auditNotifList">
            <div class="audit-notif-loading" style="padding: 1.5rem; text-align: center; color: var(--color-text-muted); font-size: 0.85rem;">
              <span class="spinner" style="display: inline-block; width: 14px; height: 14px; border: 2px solid var(--color-border); border-top-color: var(--color-primary); border-radius: 50%; animation: spin 0.7s linear infinite; vertical-align: middle; margin-right: 6px;"></span>
              {{#if isBn}}লোড হচ্ছে...{{else}}Loading alerts...{{/if}}
            </div>
          </div>

          <div class="audit-notif-footer">
            <a href="/audit-logs" class="audit-notif-view-all">
              <span>{{t 'notif.viewAll'}}</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </a>
          </div>
        </div>
      </div>

      <a href="/bills/new" class="btn btn-primary btn-sm topbar-action-btn desktop-only" style="background: #10b981; border-color: #10b981;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        {{t 'nav.newBill'}}
      </a>
    {{/if}}

    {{#if currentUser}}
      <div class="topbar-user-pill">
        <div class="topbar-avatar">{{currentUser.name.[0]}}</div>
        <div class="topbar-user-details desktop-only">
          <span class="topbar-user-name">{{currentUser.name}}</span>
          <span class="topbar-user-role">
            {{#if (or (eq currentUser.role 'SUPER_ADMIN') currentUser.isSuperAdmin isSuperAdmin)}}{{t 'nav.superAdmin'}}{{else}}{{t 'nav.generalStaff'}}{{/if}}
          </span>
        </div>
      </div>
    {{else}}
      <a href="/login" class="btn btn-secondary btn-sm">{{t 'nav.signIn'}}</a>
      <a href="/register" class="btn btn-primary btn-sm">{{t 'nav.register'}}</a>
    {{/if}}
  </div>
</header>
