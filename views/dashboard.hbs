<div style="padding-top: 1rem; padding-bottom: 2rem;">
  <!-- Dashboard Hero Header -->
  <div class="dashboard-header" style="background: linear-gradient(135deg, rgba(30, 41, 59, 0.9), rgba(15, 23, 42, 0.95)); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 1.5rem; margin-bottom: 1.5rem; box-shadow: var(--shadow-md);">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
      <div>
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.35rem; flex-wrap: wrap;">
          <h1 style="font-size: 1.75rem; font-weight: 700; color: #fff; margin: 0;">{{company.companyName}}</h1>
          {{{roleBadge user.role}}}
        </div>
        <p style="color: var(--color-text-muted); margin: 0; font-size: 0.9rem;">
          Logged in as <strong>{{user.name}}</strong> &bull; Electric Garage Management Portal
        </p>
      </div>
      <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; width: auto;" class="header-actions">
        <a href="/bills/new" class="btn btn-primary" style="background: #10b981; border-color: #10b981;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="12" y1="5" x2="12" y2="19"/>
            <line x1="5" y1="12" x2="19" y2="12"/>
          </svg>
          {{t 'nav.newBill'}}
        </a>
        <a href="/customers/new" class="btn btn-secondary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <line x1="19" y1="8" x2="19" y2="14"/>
            <line x1="22" y1="11" x2="16" y2="11"/>
          </svg>
          {{t 'nav.addCustomer'}}
        </a>
      </div>
    </div>
  </div>

  <!-- Financial KPI Metrics (Matching ASP.NET Core EGMS) -->
  <div class="kpi-grid-4" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 1.25rem; margin-bottom: 2rem;">
    <!-- Total Advance Money -->
    <div class="stat-card" style="border-top: 3px solid #10b981;">
      <div class="stat-card-header">
        <span class="stat-label">{{t 'dashboard.totalAdvance'}}</span>
        <div class="stat-icon" style="background: rgba(16, 185, 129, 0.15); color: #10b981;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="5" width="20" height="14" rx="2"/>
            <line x1="2" y1="10" x2="22" y2="10"/>
          </svg>
        </div>
      </div>
      <div class="stat-value" style="color: #10b981;">৳{{bnNum totalAdvanceMoney}}</div>
      <div class="stat-footer">
        <span class="stat-trend positive">{{t 'dashboard.totalAdvanceSub'}}</span>
      </div>
    </div>

    <!-- Total Present Dues -->
    <div class="stat-card" style="border-top: 3px solid #ef4444;">
      <div class="stat-card-header">
        <span class="stat-label">{{t 'dashboard.totalDues'}}</span>
        <div class="stat-icon" style="background: rgba(239, 68, 68, 0.15); color: #ef4444;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="8" x2="12" y2="12"/>
            <line x1="12" y1="16" x2="12.01" y2="16"/>
          </svg>
        </div>
      </div>
      <div class="stat-value" style="color: #ef4444;">৳{{bnNum totalPresentDues}}</div>
      <div class="stat-footer">
        <span style="color: #ef4444;">{{t 'dashboard.totalDuesSub'}}</span>
      </div>
    </div>

    <!-- Net Balance -->
    <div class="stat-card" style="border-top: 3px solid {{#if (ne balance 0)}}#38bdf8{{else}}#94a3b8{{/if}};">
      <div class="stat-card-header">
        <span class="stat-label">{{t 'dashboard.netBalance'}}</span>
        <div class="stat-icon" style="background: rgba(56, 189, 248, 0.15); color: #38bdf8;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
          </svg>
        </div>
      </div>
      <div class="stat-value" style="color: #38bdf8;">৳{{bnNum balance}}</div>
      <div class="stat-footer">
        <span>{{t 'dashboard.netBalanceSub'}}</span>
      </div>
    </div>

    <!-- Total Customers Breakdown -->
    <div class="stat-card" style="border-top: 3px solid #8b5cf6;">
      <div class="stat-card-header">
        <span class="stat-label">{{t 'dashboard.activeSubscribers'}}</span>
        <div class="stat-icon" style="background: rgba(139, 92, 246, 0.15); color: #8b5cf6;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
          </svg>
        </div>
      </div>
      <div class="stat-value">{{bnNum customerCount}}</div>
      <div class="stat-footer">
        <span style="color: #10b981;">{{bnNum customersWithBills}} {{t 'dashboard.billedSubscribers'}}</span> &bull; 
        <span style="color: #94a3b8;">{{bnNum customersWithoutBills}} {{t 'dashboard.unbilledSubscribers'}}</span>
      </div>
    </div>
  </div>

  <!-- Customer Billing Status Table -->
  <div class="card" style="margin-bottom: 2rem;">
    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
      <div>
        <h2 class="card-title">{{t 'dashboard.subscribersRoster'}}</h2>
        <p style="color: var(--color-text-muted); font-size: 0.85rem; margin: 0.2rem 0 0 0;">{{t 'customers.subtitle'}}</p>
      </div>
      <div style="display: flex; gap: 0.5rem;">
        <a href="/customers" class="btn btn-secondary btn-sm">{{t 'customers.title'}}</a>
        <a href="/bills" class="btn btn-secondary btn-sm">{{t 'bills.title'}}</a>
      </div>
    </div>

    {{#if customers.length}}
      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th>{{t 'customers.name'}}</th>
              <th>{{t 'customers.mobile'}}</th>
              <th>{{t 'customers.advanceMoney'}} (৳)</th>
              <th>{{t 'customers.presentDues'}} (৳)</th>
              <th>{{t 'customers.lastBill'}}</th>
              <th>{{t 'common.status'}}</th>
              <th style="text-align: right;">{{t 'common.actions'}}</th>
            </tr>
          </thead>
          <tbody>
            {{#each customers}}
              <tr>
                <td>
                  <a href="/customers/{{this.id}}" style="font-weight: 600; text-decoration: none;">
                    {{this.name}}
                  </a>
                </td>
                <td>{{this.mobileNumber}}</td>
                <td style="color: #10b981; font-weight: 600;">৳{{bnNum this.advanceMoney}}</td>
                <td>
                  <span style="font-weight: 700; {{#if (ne this.presentDues 0)}}color: #ef4444;{{else}}color: #10b981;{{/if}}">
                    ৳{{bnNum this.presentDues}}
                  </span>
                </td>
                <td style="color: #94a3b8; font-size: 0.85rem;">{{tDate this.lastBillDate}}</td>
                <td>
                  {{#if this.hasBills}}
                    <span class="badge" style="background: rgba(16, 185, 129, 0.15); color: #10b981;">Billed</span>
                  {{else}}
                    <span class="badge" style="background: rgba(245, 158, 11, 0.15); color: #fbbf24;">No Bills</span>
                  {{/if}}
                </td>
                <td style="text-align: right;">
                  <div style="display: inline-flex; gap: 0.5rem;">
                    <a href="/bills/new?customerId={{this.id}}" class="btn btn-primary btn-sm" style="background: #10b981; border-color: #10b981;">
                      + Bill
                    </a>
                    <a href="/customers/{{this.id}}" class="btn btn-secondary btn-sm">
                      {{t 'common.view'}}
                    </a>
                  </div>
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    {{else}}
      <div style="text-align: center; padding: 3rem 1rem;">
        <div style="font-size: 2.5rem; margin-bottom: 0.5rem;">🚗⚡</div>
        <h3 style="font-size: 1.15rem; font-weight: 600; margin-bottom: 0.5rem;">{{t 'customers.noCustomers'}}</h3>
        <p style="color: #94a3b8; margin-bottom: 1.5rem;">Add your first customer to begin managing electricity meters, bills, and payments.</p>
        <a href="/customers/new" class="btn btn-primary">{{t 'customers.addCustomer'}}</a>
      </div>
    {{/if}}
  </div>

  <!-- Operational Facilities & Staff Summary -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem;">
    <!-- Garages Quick Card -->
    <div class="card" style="padding: 1.5rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h3 style="font-size: 1.1rem; font-weight: 600; color: #f8fafc; margin: 0;">Garages ({{garages.length}})</h3>
        <a href="/garages" class="btn btn-secondary btn-sm">Manage</a>
      </div>
      {{#if garages.length}}
        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
          {{#each garages}}
            <div style="background: rgba(15, 23, 42, 0.5); padding: 0.75rem; border-radius: 6px; border: 1px solid var(--color-border);">
              <strong style="color: #f8fafc;">{{this.garageName}}</strong>
              <div style="font-size: 0.8rem; color: #94a3b8;">{{this.address}}</div>
            </div>
          {{/each}}
        </div>
      {{else}}
        <p style="color: #94a3b8; font-size: 0.85rem;">No garage facilities registered.</p>
      {{/if}}
    </div>

    <!-- Employees Quick Card -->
    <div class="card" style="padding: 1.5rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h3 style="font-size: 1.1rem; font-weight: 600; color: #f8fafc; margin: 0;">Staff &amp; Technicians ({{employees.length}})</h3>
        <a href="/employees" class="btn btn-secondary btn-sm">Manage</a>
      </div>
      {{#if employees.length}}
        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
          {{#each employees}}
            <div style="display: flex; justify-content: space-between; align-items: center; background: rgba(15, 23, 42, 0.5); padding: 0.75rem; border-radius: 6px; border: 1px solid var(--color-border);">
              <div>
                <strong style="color: #f8fafc;">{{this.name}}</strong>
                <div style="font-size: 0.8rem; color: #94a3b8;">{{this.phoneNumber}}</div>
              </div>
              {{{roleBadge this.role}}}
            </div>
          {{/each}}
        </div>
      {{else}}
        <p style="color: #94a3b8; font-size: 0.85rem;">No employees registered.</p>
      {{/if}}
    </div>
  </div>
</div>
