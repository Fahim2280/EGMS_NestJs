<div class="container" style="padding-top: 2rem; padding-bottom: 3rem;">
  <!-- Dashboard Hero Header -->
  <div class="dashboard-header" style="background: linear-gradient(135deg, rgba(30, 41, 59, 0.9), rgba(15, 23, 42, 0.95)); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 1.75rem 2rem; margin-bottom: 2rem; box-shadow: var(--shadow-md);">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
      <div>
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.35rem;">
          <h1 style="font-size: 1.75rem; font-weight: 700; color: #fff; margin: 0;">{{company.companyName}}</h1>
          {{{roleBadge user.role}}}
        </div>
        <p style="color: var(--color-text-muted); margin: 0; font-size: 0.95rem;">
          Logged in as <strong>{{user.name}}</strong> &bull; {{company.email}} &bull; {{company.phoneNumber}}
        </p>
      </div>
      <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
        {{#if (eq user.role 'SUPER_ADMIN')}}
          <a href="/garages/new" class="btn btn-secondary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
              <line x1="12" y1="9" x2="12" y2="15"/>
              <line x1="9" y1="12" x2="15" y2="12"/>
            </svg>
            Add Garage
          </a>
          <a href="/employees/new" class="btn btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="12" y1="5" x2="12" y2="19"/>
              <line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            Add Employee
          </a>
        {{/if}}
      </div>
    </div>
  </div>

  <!-- KPI Stat Cards -->
  <div class="stats-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem; margin-bottom: 2.5rem;">
    <div class="stat-card">
      <div class="stat-card-header">
        <span class="stat-label">Company Garages</span>
        <div class="stat-icon" style="background: rgba(59, 130, 246, 0.15); color: #3b82f6;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          </svg>
        </div>
      </div>
      <div class="stat-value">{{garages.length}}</div>
      <div class="stat-footer">
        <span class="stat-trend positive">Active Facilities</span>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-card-header">
        <span class="stat-label">Total Employees</span>
        <div class="stat-icon" style="background: rgba(16, 185, 129, 0.15); color: #10b981;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
          </svg>
        </div>
      </div>
      <div class="stat-value">{{employees.length}}</div>
      <div class="stat-footer">
        <span class="stat-trend positive">General Staff Roster</span>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-card-header">
        <span class="stat-label">Governance Tier</span>
        <div class="stat-icon" style="background: rgba(139, 92, 246, 0.15); color: #8b5cf6;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
          </svg>
        </div>
      </div>
      <div class="stat-value" style="font-size: 1.5rem; text-transform: uppercase;">{{user.role}}</div>
      <div class="stat-footer">
        <span>Headquarters: {{company.address}}</span>
      </div>
    </div>
  </div>

  <!-- Main Split Sections: Garages & Employees -->
  <div style="display: grid; grid-template-columns: 1fr; gap: 2rem;">
    <!-- Garages Section -->
    <div class="card" style="padding: 1.5rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
        <div>
          <h2 style="font-size: 1.25rem; font-weight: 600; margin: 0;">Garages / Operational Units</h2>
          <p style="color: var(--color-text-muted); font-size: 0.875rem; margin: 0.25rem 0 0 0;">Physical workshops and facilities registered under {{company.companyName}}</p>
        </div>
        <a href="/garages" class="btn btn-secondary btn-sm">View All Garages</a>
      </div>

      {{#if garages.length}}
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1rem;">
          {{#each garages}}
            <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 1.25rem;">
              <div style="display: flex; align-items: flex-start; gap: 0.75rem; margin-bottom: 0.5rem;">
                <div style="background: rgba(59, 130, 246, 0.1); color: var(--color-primary); padding: 0.5rem; border-radius: var(--radius-sm);">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                  </svg>
                </div>
                <div>
                  <h3 style="font-size: 1.05rem; font-weight: 600; margin: 0;">{{this.garageName}}</h3>
                  <span style="font-size: 0.75rem; color: var(--color-text-muted);">ID: {{this.id}}</span>
                </div>
              </div>
              <p style="font-size: 0.875rem; color: var(--color-text-secondary); margin: 0.5rem 0;">
                <strong>Address:</strong> {{this.address}}
              </p>
              <div style="font-size: 0.75rem; color: var(--color-text-muted);">
                Registered: {{this.createdAt}}
              </div>
            </div>
          {{/each}}
        </div>
      {{else}}
        <div style="text-align: center; padding: 2rem; color: var(--color-text-muted);">
          No garages registered yet.
          {{#if (eq user.role 'SUPER_ADMIN')}}
            <div style="margin-top: 1rem;">
              <a href="/garages/new" class="btn btn-primary btn-sm">Register First Garage</a>
            </div>
          {{/if}}
        </div>
      {{/if}}
    </div>

    <!-- Employees Section -->
    <div class="card" style="padding: 1.5rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; flex-wrap: wrap; gap: 0.5rem;">
        <div>
          <h2 style="font-size: 1.25rem; font-weight: 600; margin: 0;">Employee Directory</h2>
          <p style="color: var(--color-text-muted); font-size: 0.875rem; margin: 0.25rem 0 0 0;">General staff members connected to {{company.companyName}}</p>
        </div>
        <a href="/employees" class="btn btn-secondary btn-sm">Full Directory</a>
      </div>

      {{#if employees.length}}
        <div class="table-container" style="overflow-x: auto;">
          <table class="data-table" style="width: 100%; border-collapse: collapse;">
            <thead>
              <tr style="border-bottom: 1px solid var(--color-border); text-align: left;">
                <th style="padding: 0.75rem;">Employee Name</th>
                <th style="padding: 0.75rem;">Email</th>
                <th style="padding: 0.75rem;">Phone Number</th>
                <th style="padding: 0.75rem;">Role</th>
                <th style="padding: 0.75rem;">NID Number</th>
                <th style="padding: 0.75rem;">Address</th>
              </tr>
            </thead>
            <tbody>
              {{#each employees}}
                <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
                  <td style="padding: 0.75rem; font-weight: 600;">
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                      <span class="user-avatar" style="width: 28px; height: 28px; font-size: 0.75rem;">{{this.name.[0]}}</span>
                      {{this.name}}
                    </div>
                  </td>
                  <td style="padding: 0.75rem; color: var(--color-text-secondary);">{{this.email}}</td>
                  <td style="padding: 0.75rem; color: var(--color-text-secondary);">{{this.phoneNumber}}</td>
                  <td style="padding: 0.75rem;">{{{roleBadge this.role}}}</td>
                  <td style="padding: 0.75rem;">
                    <span style="font-family: monospace; background: rgba(255,255,255,0.06); padding: 0.2rem 0.45rem; border-radius: 4px;">{{this.nidNumber}}</span>
                  </td>
                  <td style="padding: 0.75rem; color: var(--color-text-muted); font-size: 0.85rem;">{{this.address}}</td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      {{else}}
        <div style="text-align: center; padding: 2rem; color: var(--color-text-muted);">
          No employees added yet.
          {{#if (eq user.role 'SUPER_ADMIN')}}
            <div style="margin-top: 1rem;">
              <a href="/employees/new" class="btn btn-primary btn-sm">Add First Employee</a>
            </div>
          {{/if}}
        </div>
      {{/if}}
    </div>
  </div>
</div>
