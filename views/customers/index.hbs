<div class="page-header">
  <div class="header-content">
    <h1 class="page-title">{{t 'customers.title'}}</h1>
    <p class="page-subtitle">{{t 'customers.subtitle'}}</p>
  </div>
  {{#if (or isSuperAdmin currentUser.canCreate)}}
  <div class="header-actions">
    <a href="/customers/new" class="btn btn-primary">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <line x1="12" y1="5" x2="12" y2="19"/>
        <line x1="5" y1="12" x2="19" y2="12"/>
      </svg>
      {{t 'customers.addCustomer'}}
    </a>
  </div>
  {{/if}}
</div>

<div class="card">
  <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
    <h2 class="card-title" style="margin: 0;">{{t 'customers.registeredCount'}} ({{bnNum customerCount}})</h2>
    <form method="GET" action="/customers" class="table-filter-form" style="display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: flex-end;">
      <select name="garageId" class="form-input filter-select" onchange="this.form.submit()">
        <option value="">{{t 'common.allGarages'}}</option>
        {{#each garages}}
          <option value="{{this.id}}" {{#if (eq this.id ../selectedGarageId)}}selected{{/if}}>
            {{this.garageName}}
          </option>
        {{/each}}
      </select>
      <!-- Date range -->
      <div class="dfb-group" style="min-width: 130px;">
        <label class="dfb-label" for="custFrom">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          {{#if isBn}}শুরু{{else}}From{{/if}}
        </label>
        <input type="date" id="custFrom" name="fromDate" class="dfb-input" value="{{fromDate}}">
      </div>
      <div class="dfb-group" style="min-width: 130px;">
        <label class="dfb-label" for="custTo">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          {{#if isBn}}শেষ{{else}}To{{/if}}
        </label>
        <input type="date" id="custTo" name="toDate" class="dfb-input" value="{{toDate}}">
      </div>
      <div class="search-input-group">
        <input type="text" name="search" class="form-input" placeholder="{{t 'customers.searchPlaceholder'}}" value="{{search}}">
        <button type="submit" class="btn btn-secondary btn-sm">{{t 'common.search'}}</button>
        {{#if (or selectedGarageId search fromDate toDate)}}
          <a href="/customers" class="btn btn-secondary btn-sm" style="color: #ef4444;">{{t 'common.reset'}}</a>
        {{/if}}
      </div>
    </form>
  </div>

  {{#if customers.length}}
    <div class="table-scroll-hint desktop-only-hint">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="8 18 2 12 8 6"/><polyline points="16 6 22 12 16 18"/></svg>
      <span>{{#if isBn}}সম্পূর্ণ বিবরণ দেখতে ডানে স্ক্রোল করুন{{else}}Scroll horizontally to view all{{/if}}</span>
    </div>

    <!-- Desktop Table View -->
    <div class="table-responsive desktop-customers-table">
      <table class="data-table table-dense table-hover-enhanced">
        <thead>
          <tr>
            <th style="width: 70px;">{{t 'customers.id'}}</th>
            <th style="width: 100px;">{{t 'customers.code'}}</th>
            <th style="min-width: 190px;">{{t 'customers.name'}}</th>
            <th style="min-width: 140px;">{{t 'customers.garage'}}</th>
            <th>{{t 'customers.mobile'}}</th>
            <th>{{t 'customers.nid'}}</th>
            <th class="th-num" style="text-align: right;">{{t 'customers.initialMeter'}}</th>
            <th class="th-num" style="text-align: right;">{{t 'customers.advanceMoney'}}</th>
            <th>{{t 'customers.status'}}</th>
            <th style="white-space: nowrap;">{{t 'common.registered'}}</th>
            <th style="text-align: right; min-width: 130px;">{{t 'common.actions'}}</th>
          </tr>
        </thead>
        <tbody>
          {{#each customers}}
            <tr class="{{#unless this.isActive}}row-suspended-customer{{/unless}}">
              <td>
                <span class="badge-cid">#{{#if this.cId}}{{bnNum this.cId}}{{else}}{{this.id}}{{/if}}</span>
              </td>
              <td>
                {{#if this.customerCode}}
                  <span class="table-code-badge">{{this.customerCode}}</span>
                {{else}}
                  <span class="text-muted" style="font-size: 0.85rem;">—</span>
                {{/if}}
              </td>
              <td>
                <div class="table-avatar-cell">
                  <div class="user-avatar-wrapper previewable-avatar"
                       data-preview-img="{{profilePicUrl this}}"
                       data-preview-name="{{this.name}}"
                       data-preview-code="{{this.customerCode}}"
                       data-preview-badge="{{#if this.garageName}}🏢 {{this.garageName}}{{/if}}"
                       data-preview-sub="ID: #{{#if this.cId}}{{bnNum this.cId}}{{else}}{{this.id}}{{/if}}{{#if this.mobileNumber}} • 📞 {{this.mobileNumber}}{{/if}}"
                       title="{{#if (profilePicUrl this)}}{{t 'profile.clickToEnlarge'}}{{else}}{{this.name}}{{/if}}">
                    {{#if (profilePicUrl this)}}
                      <img src="{{profilePicUrl this}}" alt="{{this.name}}" class="table-avatar-img" loading="lazy" />
                      <span class="avatar-zoom-badge">
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                      </span>
                    {{else}}
                      <div class="table-avatar-initials avatar-gradient-{{modulo @index 5}}">
                        {{firstChar this.name}}
                      </div>
                    {{/if}}
                  </div>
                  <div class="table-cust-meta">
                    <div class="cust-name-row">
                      <a href="/customers/{{this.id}}" class="customer-name-link">{{this.name}}</a>
                      {{#unless this.isActive}}
                        <span class="badge-mini-tag badge-suspended">🚫 {{t 'customers.suspended'}}</span>
                      {{/unless}}
                    </div>
                    {{#if this.fatherName}}
                      <div class="cust-father-row">
                        <span class="text-muted" style="font-size: 0.76rem;">{{t 'customers.fatherName'}}:</span>
                        <span style="font-size: 0.78rem; color: var(--color-text-secondary);">{{this.fatherName}}</span>
                      </div>
                    {{/if}}
                  </div>
                </div>
              </td>
              <td>
                {{#if this.garageId}}
                  <a href="/garages/{{this.garageId}}" class="table-garage-link">
                    <span class="table-garage-pill" title="{{this.garageName}}">
                      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                      <span class="garage-name-text">{{this.garageName}}</span>
                    </span>
                  </a>
                {{else}}
                  <span class="garage-none-dash" title="{{t 'common.na'}}">—</span>
                {{/if}}
              </td>
              <td>
                <div class="cell-phone-group">
                  <span style="font-family: monospace; font-size: 0.84rem;">{{this.mobileNumber}}</span>
                  {{#if this.phoneNumbers}}
                    {{#if (gt this.phoneNumbers.length 1)}}
                      <span class="badge-phone-count" title="{{#each this.phoneNumbers}}{{this.number}} ({{this.type}})&#10;{{/each}}">
                        +{{bnNum (subtract this.phoneNumbers.length 1)}}
                      </span>
                    {{/if}}
                  {{/if}}
                </div>
              </td>
              <td>
                {{#if this.nidNumber}}
                  <code class="cell-nid-code">{{this.nidNumber}}</code>
                {{else}}
                  <span class="text-muted" style="font-size: 0.85rem;">—</span>
                {{/if}}
              </td>
              <td class="cell-num" style="text-align: right;">
                <span class="cell-meter-val"><strong>{{bnNum this.previousUnit}}</strong> <small class="text-muted">{{t 'common.unitShort'}}</small></span>
              </td>
              <td class="cell-num" style="text-align: right;">
                <span class="cell-advance-val {{#if (gt this.advanceMoney 0)}}val-highlight{{/if}}">
                  ৳{{bnMoney this.advanceMoney}}
                </span>
              </td>
              <td>
                {{#if this.isActive}}
                  <span class="status-pill status-active">
                    <span class="status-dot"></span> {{t 'customers.active'}}
                  </span>
                {{else}}
                  <span class="status-pill status-suspended">
                    <span class="status-dot"></span> {{t 'customers.suspended'}}
                  </span>
                {{/if}}
              </td>
              <td style="white-space: nowrap;">
                <span class="date-badge-pill">{{tDate this.createdDate}}</span>
              </td>
              <td style="text-align: right;">
                <div class="table-actions-group">
                  <a href="/customers/{{this.id}}" class="btn btn-secondary btn-icon-action" title="{{t 'common.view'}}" aria-label="{{t 'common.view'}}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                  </a>
                  {{#if (or ../isSuperAdmin ../currentUser.canCreate)}}
                    {{#if this.isActive}}
                      <a href="/bills/new?customerId={{this.id}}" class="btn btn-icon-action btn-action-bill" title="{{t 'bills.newBill'}}" aria-label="{{t 'bills.newBill'}}">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                      </a>
                    {{else}}
                      <button type="button" class="btn btn-secondary btn-icon-action" style="opacity: 0.35; cursor: not-allowed;" title="{{t 'customers.suspendedNoticeShort'}}" disabled>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                      </button>
                    {{/if}}
                  {{/if}}
                  {{#if (or ../isSuperAdmin ../currentUser.canEdit)}}
                  <a href="/customers/{{this.id}}/edit" class="btn btn-secondary btn-icon-action" title="{{t 'common.edit'}}" aria-label="{{t 'common.edit'}}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                  </a>
                  {{/if}}
                  {{#if ../isSuperAdmin}}
                    {{#if this.isActive}}
                      <form action="/customers/{{this.id}}/toggle-status" method="POST" style="display: inline;"
                            data-confirm-modal="true"
                            data-confirm-type="warning"
                            data-confirm-title="{{t 'customers.suspendModalTitle'}}"
                            data-confirm-desc="{{t 'customers.suspendModalDesc'}}"
                            data-confirm-warning="{{t 'customers.suspendModalWarning'}}"
                            data-confirm-submit="{{t 'customers.suspendModalBtn'}}"
                            data-confirm-target-name="{{this.name}}"
                            data-confirm-target-sub="{{#if this.customerCode}}ID: {{this.customerCode}}{{/if}}"
                            data-confirm-target-badge="{{t 'customers.active'}}"
                            data-confirm-target-badge-class="badge-success">
                        <button type="submit" class="btn btn-icon-action btn-action-suspend" title="{{t 'customers.suspendAction'}}" aria-label="{{t 'customers.suspendAction'}}">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                        </button>
                      </form>
                    {{else}}
                      <form action="/customers/{{this.id}}/toggle-status" method="POST" style="display: inline;"
                            data-confirm-modal="true"
                            data-confirm-type="success"
                            data-confirm-icon="⚡"
                            data-confirm-title="{{t 'customers.reactivateModalTitle'}}"
                            data-confirm-desc="{{t 'customers.reactivateModalDesc'}}"
                            data-confirm-warning="{{t 'customers.reactivateModalNotice'}}"
                            data-confirm-submit="{{t 'customers.reactivateModalBtn'}}"
                            data-confirm-btn-class="btn-success"
                            data-confirm-target-name="{{this.name}}"
                            data-confirm-target-sub="{{#if this.customerCode}}ID: {{this.customerCode}}{{/if}}"
                            data-confirm-target-badge="{{t 'customers.suspended'}}"
                            data-confirm-target-badge-class="badge-danger">
                        <button type="submit" class="btn btn-icon-action btn-action-reactivate" title="{{t 'customers.reactivateAction'}}" aria-label="{{t 'customers.reactivateAction'}}">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                        </button>
                      </form>
                    {{/if}}
                  {{/if}}
                  {{#if (or ../isSuperAdmin ../currentUser.canDelete)}}
                  <form action="/customers/{{this.id}}/delete" method="POST" style="display: inline;" onsubmit="return confirm('{{t 'customers.confirmDelete'}}');">
                    <button type="submit" class="btn btn-danger btn-icon-action btn-action-delete" title="{{t 'common.delete'}}" aria-label="{{t 'common.delete'}}">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                    </button>
                  </form>
                  {{/if}}
                </div>
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>

    <!-- Mobile Customer Cards View (Under 768px) -->
    <div class="mobile-customers-cards">
      {{#each customers}}
        <div class="mobile-customer-card {{#if this.isActive}}mcc-active{{else}}mcc-suspended{{/if}}">
          <!-- Card Header -->
          <div class="mcc-header">
            <div class="user-avatar-wrapper previewable-avatar"
                 data-preview-img="{{profilePicUrl this}}"
                 data-preview-name="{{this.name}}"
                 data-preview-code="{{this.customerCode}}"
                 data-preview-badge="{{#if this.garageName}}🏢 {{this.garageName}}{{/if}}"
                 data-preview-sub="ID: #{{#if this.cId}}{{bnNum this.cId}}{{else}}{{this.id}}{{/if}}{{#if this.mobileNumber}} • 📞 {{this.mobileNumber}}{{/if}}">
              {{#if (profilePicUrl this)}}
                <img src="{{profilePicUrl this}}" alt="{{this.name}}" class="table-avatar-img" loading="lazy" />
              {{else}}
                <div class="table-avatar-initials avatar-gradient-{{modulo @index 5}}">
                  {{firstChar this.name}}
                </div>
              {{/if}}
            </div>

            <div class="mcc-info">
              <div class="mcc-name-row">
                <a href="/customers/{{this.id}}" class="mcc-name">{{this.name}}</a>
              </div>
              <div class="mcc-id-badges">
                <span class="badge-cid">#{{#if this.cId}}{{bnNum this.cId}}{{else}}{{this.id}}{{/if}}</span>
                {{#if this.customerCode}}
                  <span class="table-code-badge">{{this.customerCode}}</span>
                {{/if}}
              </div>
              {{#if this.fatherName}}
                <div class="mcc-father">
                  <span class="text-muted">{{t 'customers.fatherName'}}:</span> {{this.fatherName}}
                </div>
              {{/if}}
            </div>

            <div class="mcc-status-col">
              {{#if this.isActive}}
                <span class="status-pill status-active"><span class="status-dot"></span>{{t 'customers.active'}}</span>
              {{else}}
                <span class="status-pill status-suspended"><span class="status-dot"></span>{{t 'customers.suspended'}}</span>
              {{/if}}
            </div>
          </div>

          <!-- Middle Meta Row: Garage & Phone -->
          <div class="mcc-middle-row">
            {{#if this.garageId}}
              <a href="/garages/{{this.garageId}}" class="table-garage-link">
                <span class="table-garage-pill" title="{{this.garageName}}">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                  <span class="garage-name-text">{{this.garageName}}</span>
                </span>
              </a>
            {{/if}}

            <a href="tel:{{this.mobileNumber}}" class="mcc-phone-link">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              <span>{{this.mobileNumber}}</span>
            </a>
          </div>

          <!-- Stats Grid: NID, Initial Meter, Advance, Registered -->
          <div class="mcc-grid">
            <div class="mcc-stat-box">
              <span class="mcc-stat-lbl">{{t 'customers.nid'}}</span>
              <span class="mcc-stat-val">{{#if this.nidNumber}}{{this.nidNumber}}{{else}}—{{/if}}</span>
            </div>
            <div class="mcc-stat-box">
              <span class="mcc-stat-lbl">{{t 'customers.initialMeter'}}</span>
              <span class="mcc-stat-val">{{bnNum this.previousUnit}} {{t 'common.unitShort'}}</span>
            </div>
            <div class="mcc-stat-box">
              <span class="mcc-stat-lbl">{{t 'customers.advanceMoney'}}</span>
              <span class="mcc-stat-val {{#if (gt this.advanceMoney 0)}}text-success{{/if}} font-bold">৳{{bnMoney this.advanceMoney}}</span>
            </div>
            <div class="mcc-stat-box">
              <span class="mcc-stat-lbl">{{t 'common.registered'}}</span>
              <span class="mcc-stat-val">{{tDate this.createdDate}}</span>
            </div>
          </div>

          <!-- Card Actions Footer -->
          <div class="mcc-footer">
            <div class="table-actions-group">
              <a href="/customers/{{this.id}}" class="btn btn-secondary btn-icon-action" title="{{t 'common.view'}}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              </a>
              {{#if (or ../isSuperAdmin ../currentUser.canCreate)}}
                {{#if this.isActive}}
                  <a href="/bills/new?customerId={{this.id}}" class="btn btn-icon-action btn-action-bill" title="{{t 'bills.newBill'}}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                  </a>
                {{/if}}
              {{/if}}
              {{#if (or ../isSuperAdmin ../currentUser.canEdit)}}
              <a href="/customers/{{this.id}}/edit" class="btn btn-secondary btn-icon-action" title="{{t 'common.edit'}}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
              </a>
              {{/if}}
              {{#if ../isSuperAdmin}}
                {{#if this.isActive}}
                  <form action="/customers/{{this.id}}/toggle-status" method="POST" style="display: inline;"
                        data-confirm-modal="true"
                        data-confirm-type="warning"
                        data-confirm-title="{{t 'customers.suspendModalTitle'}}"
                        data-confirm-desc="{{t 'customers.suspendModalDesc'}}"
                        data-confirm-warning="{{t 'customers.suspendModalWarning'}}"
                        data-confirm-submit="{{t 'customers.suspendModalBtn'}}"
                        data-confirm-target-name="{{this.name}}"
                        data-confirm-target-sub="{{#if this.customerCode}}ID: {{this.customerCode}}{{/if}}"
                        data-confirm-target-badge="{{t 'customers.active'}}"
                        data-confirm-target-badge-class="badge-success">
                    <button type="submit" class="btn btn-icon-action btn-action-suspend" title="{{t 'customers.suspendAction'}}">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                    </button>
                  </form>
                {{else}}
                  <form action="/customers/{{this.id}}/toggle-status" method="POST" style="display: inline;"
                        data-confirm-modal="true"
                        data-confirm-type="success"
                        data-confirm-icon="⚡"
                        data-confirm-title="{{t 'customers.reactivateModalTitle'}}"
                        data-confirm-desc="{{t 'customers.reactivateModalDesc'}}"
                        data-confirm-warning="{{t 'customers.reactivateModalNotice'}}"
                        data-confirm-submit="{{t 'customers.reactivateModalBtn'}}"
                        data-confirm-btn-class="btn-success"
                        data-confirm-target-name="{{this.name}}"
                        data-confirm-target-sub="{{#if this.customerCode}}ID: {{this.customerCode}}{{/if}}"
                        data-confirm-target-badge="{{t 'customers.suspended'}}"
                        data-confirm-target-badge-class="badge-danger">
                    <button type="submit" class="btn btn-icon-action btn-action-reactivate" title="{{t 'customers.reactivateAction'}}">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    </button>
                  </form>
                {{/if}}
              {{/if}}
              {{#if (or ../isSuperAdmin ../currentUser.canDelete)}}
              <form action="/customers/{{this.id}}/delete" method="POST" style="display: inline;" onsubmit="return confirm('{{t 'customers.confirmDelete'}}');">
                <button type="submit" class="btn btn-danger btn-icon-action btn-action-delete" title="{{t 'common.delete'}}">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                </button>
              </form>
              {{/if}}
            </div>
          </div>
        </div>
      {{/each}}
    </div>
  {{else}}
    <div style="text-align: center; padding: 4rem 1rem;">
      <div style="font-size: 3rem; margin-bottom: 1rem;">👥</div>
      <h3 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 0.5rem;">{{t 'customers.noCustomers'}}</h3>
      <p style="color: var(--color-text-muted); margin-bottom: 1.5rem;">{{t 'customers.noCustomersSub'}}</p>
      {{#if (or isSuperAdmin currentUser.canCreate)}}
      <a href="/customers/new" class="btn btn-primary">{{t 'customers.addCustomer'}}</a>
      {{/if}}
    </div>
  {{/if}}
</div>

<!-- Pagination Controls -->
{{#if pagination.totalPages}}
  {{#if (gt pagination.totalPages 1)}}
  <div class="pagination-bar" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; padding: 0.75rem 0; margin-top: 0.5rem;"
       data-page="{{pagination.page}}"
       data-total-pages="{{pagination.totalPages}}"
       data-total-count="{{pagination.totalCount}}"
       data-has-next="{{pagination.hasNext}}"
       data-has-prev="{{pagination.hasPrev}}"
       data-from="{{fromDate}}"
       data-to="{{toDate}}"
       data-garage="{{selectedGarageId}}"
       data-search="{{search}}"
       data-preset="{{preset}}"
       id="customersPagination">
    <div style="font-size: 0.85rem; color: var(--color-text-muted);">
      {{#if isBn}}পৃষ্ঠা {{bnNum pagination.page}} / {{bnNum pagination.totalPages}} · মোট {{bnNum pagination.totalCount}} জন গ্রাহক
      {{else}}Page {{pagination.page}} of {{pagination.totalPages}} · {{pagination.totalCount}} customers{{/if}}
    </div>
    <div id="customersPaginationBtns" style="display: flex; gap: 0.4rem; flex-wrap: wrap;"></div>
  </div>
  <script>
    (function() {
      const bar = document.getElementById('customersPagination');
      if (!bar) return;
      const d = bar.dataset;
      const page = parseInt(d.page, 10);
      const params = new URLSearchParams({
        fromDate: d.from || '',
        toDate: d.to || '',
        garageId: d.garage || '',
        search: d.search || '',
        preset: d.preset || '',
      });
      const btns = document.getElementById('customersPaginationBtns');
      if (d.hasPrev === 'true') {
        params.set('page', page - 1);
        btns.insertAdjacentHTML('beforeend',
          '<a href="?' + params.toString() + '" class="btn btn-secondary btn-sm">&larr; Prev</a>');
      }
      if (d.hasNext === 'true') {
        params.set('page', page + 1);
        btns.insertAdjacentHTML('beforeend',
          '<a href="?' + params.toString() + '" class="btn btn-secondary btn-sm">Next &rarr;</a>');
      }
    })();
  </script>
  {{/if}}
{{/if}}

