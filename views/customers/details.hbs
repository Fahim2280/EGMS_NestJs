<div class="page-header">
  <div class="header-content">
    <a href="/customers" style="color: var(--color-text-muted); text-decoration: none; font-size: 0.875rem; display: inline-flex; align-items: center; gap: 0.25rem; margin-bottom: 0.5rem;">
      &larr; {{t 'customers.subtitle'}}
    </a>
    <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
      <h1 class="page-title" style="margin-bottom: 0;">{{customer.name}}</h1>
      {{#if customer.customerCode}}
      <span class="badge" style="background: rgba(20, 184, 166, 0.15); color: #2dd4bf; border: 1px solid rgba(20,184,166,0.3); font-size: 0.9rem; font-weight: 700; padding: 0.25rem 0.65rem; border-radius: 6px; letter-spacing: 0.04em;">{{customer.customerCode}}</span>
      {{/if}}
      {{#if customer.isActive}}
      <span class="badge" style="background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3); font-size: 0.85rem; font-weight: 600; padding: 0.25rem 0.65rem; border-radius: 6px;">
        ● {{t 'customers.active'}}
      </span>
      {{else}}
      <span class="badge" style="background: rgba(239, 68, 68, 0.15); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.3); font-size: 0.85rem; font-weight: 700; padding: 0.25rem 0.65rem; border-radius: 6px;">
        🚫 {{t 'customers.suspended'}}
      </span>
      {{/if}}
    </div>
    <p class="page-subtitle" style="margin-top: 0.35rem;">
      {{#if customer.customerCode}}
        Customer ID: <strong style="color: #2dd4bf;">{{customer.customerCode}}</strong> &bull;
      {{/if}}
      System #{{#if customer.cId}}{{bnNum customer.cId}}{{else}}{{bnNum customer.id}}{{/if}} &bull; {{t 'common.registered'}}: {{tDate customer.createdDate}}
    </p>
  </div>
  <div class="header-actions">
    {{#if isSuperAdmin}}
      {{#if customer.isActive}}
      <form id="suspendCustomerHeaderForm" action="/customers/{{customer.id}}/toggle-status" method="POST" style="display: inline; margin: 0;">
        <button type="button" class="btn" style="background: rgba(245, 158, 11, 0.15); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.35); font-weight: 600;" onclick="triggerCustomerSuspendModal('suspendCustomerHeaderForm')">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 0.35rem;"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
          {{t 'customers.suspendAction'}}
        </button>
      </form>
      {{else}}
      <form id="reactivateCustomerHeaderForm" action="/customers/{{customer.id}}/toggle-status" method="POST" style="display: inline; margin: 0;">
        <button type="button" class="btn" style="background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.35); font-weight: 600;" onclick="triggerCustomerReactivateModal('reactivateCustomerHeaderForm')">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 0.35rem;"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          {{t 'customers.reactivateAction'}}
        </button>
      </form>
      {{/if}}
    {{/if}}
    {{#if (or isSuperAdmin currentUser.canCreate)}}
      {{#if customer.isActive}}
      <a href="/bills/new?customerId={{customer.id}}" class="btn btn-primary" style="background: #10b981; border-color: #10b981;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="12" y1="5" x2="12" y2="19"/>
          <line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        {{t 'bills.newBill'}}
      </a>
      {{else}}
      <button type="button" class="btn btn-secondary" style="opacity: 0.5; cursor: not-allowed;" title="{{t 'customers.suspendedNoticeShort'}}" disabled>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="12" y1="5" x2="12" y2="19"/>
          <line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        {{t 'bills.newBill'}} ({{t 'customers.suspended'}})
      </button>
      {{/if}}
    {{/if}}
    {{#if (or isSuperAdmin currentUser.canEdit)}}
    <a href="/customers/{{customer.id}}/edit" class="btn btn-secondary">
      {{t 'customers.updateProfile'}}
    </a>
    {{/if}}
  </div>
</div>

{{#unless customer.isActive}}
<div class="card" style="margin-bottom: 1.5rem; background: rgba(239, 68, 68, 0.08); border: 1px solid rgba(239, 68, 68, 0.25); border-left: 4px solid #ef4444; padding: 1rem 1.25rem;">
  <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
    <div style="display: flex; align-items: center; gap: 0.75rem;">
      <div style="font-size: 1.75rem; line-height: 1;">🚫</div>
      <div>
        <div style="font-weight: 700; color: #ef4444; font-size: 1.05rem;">{{t 'customers.suspendedNoticeShort'}}</div>
        <div style="color: var(--color-text-secondary); font-size: 0.9rem; margin-top: 0.15rem;">{{t 'customers.suspendedNotice'}}</div>
      </div>
    </div>
    {{#if isSuperAdmin}}
    <form id="bannerReactivateCustomerForm" action="/customers/{{customer.id}}/toggle-status" method="POST" style="margin: 0;">
      <button type="button" class="btn btn-success" style="background: #10b981; border-color: #10b981; font-weight: 600;" onclick="triggerCustomerReactivateModal('bannerReactivateCustomerForm')">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="margin-right: 0.35rem;"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        {{t 'customers.reactivateAction'}}
      </button>
    </form>
    {{/if}}
  </div>
</div>
{{/unless}}

<!-- Profile Info Grid -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
  <div class="card" style="padding: 1.25rem;">
    <div style="font-size: 0.8rem; text-transform: uppercase; color: var(--color-text-muted); letter-spacing: 0.05em; margin-bottom: 0.5rem;">Customer ID &amp; {{t 'phones.title'}}</div>
    <div style="font-size: 1.05rem; font-weight: 700; color: var(--color-text-primary); margin-bottom: 0.35rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem;">
      {{#if customer.customerCode}}
        <span style="color: #2dd4bf; background: rgba(45, 212, 191, 0.1); padding: 0.15rem 0.5rem; border-radius: 4px; font-size: 0.9rem;">{{customer.customerCode}}</span>
      {{/if}}
      <a href="tel:{{customer.mobileNumber}}" style="color: #38bdf8; text-decoration: none; display: inline-flex; align-items: center; gap: 0.35rem;">
        📞 {{customer.mobileNumber}}
      </a>
      <span class="badge" style="background: rgba(16, 185, 129, 0.15); color: #34d399; font-size: 0.72rem; padding: 2px 6px; border-radius: 12px;">{{t 'phones.primary'}}</span>
    </div>

    {{#if customer.phoneNumbers}}
      {{#if (gt customer.phoneNumbers.length 1)}}
        <div style="display: flex; flex-direction: column; gap: 0.35rem; margin-top: 0.4rem; padding-top: 0.4rem; border-top: 1px solid rgba(255, 255, 255, 0.08);">
          {{#each customer.phoneNumbers}}
            {{#unless this.isPrimary}}
              <div style="display: flex; align-items: center; justify-content: space-between; font-size: 0.82rem; background: rgba(255, 255, 255, 0.03); padding: 0.25rem 0.5rem; border-radius: 4px;">
                <span style="display: flex; align-items: center; gap: 0.35rem;">
                  <a href="tel:{{this.number}}" style="color: var(--color-text-secondary); text-decoration: none;">📞 {{this.number}}</a>
                  <span style="font-size: 0.68rem; color: var(--color-text-muted); background: rgba(255, 255, 255, 0.08); padding: 1px 5px; border-radius: 10px;">{{this.type}}</span>
                </span>
                {{#if (eq this.type 'WHATSAPP')}}
                  <a href="https://wa.me/88{{this.number}}" target="_blank" rel="noopener" style="color: #22c55e; font-size: 0.75rem; text-decoration: none; font-weight: 600;">WhatsApp 💬</a>
                {{/if}}
              </div>
            {{/unless}}
          {{/each}}
        </div>
      {{/if}}
    {{/if}}

    <div style="color: var(--color-text-muted); font-size: 0.85rem; margin-top: 0.5rem;">NID: <code style="color: var(--color-text-secondary);">{{customer.nidNumber}}</code></div>
  </div>

  <div class="card" style="padding: 1.25rem;">
    <div style="font-size: 0.8rem; text-transform: uppercase; color: var(--color-text-muted); letter-spacing: 0.05em; margin-bottom: 0.5rem;">{{t 'customers.fatherName'}} &amp; {{t 'customers.motherName'}}</div>
    <div style="font-size: 0.95rem; color: var(--color-text-primary); margin-bottom: 0.25rem;"><strong>{{t 'customers.fatherName'}}:</strong> {{#if customer.fatherName}}{{customer.fatherName}}{{else}}{{t 'common.na'}}{{/if}}</div>
    <div style="font-size: 0.95rem; color: var(--color-text-primary);"><strong>{{t 'customers.motherName'}}:</strong> {{#if customer.motherName}}{{customer.motherName}}{{else}}{{t 'common.na'}}{{/if}}</div>
  </div>

  <div class="card" style="padding: 1.25rem;">
    <div style="font-size: 0.8rem; text-transform: uppercase; color: var(--color-text-muted); letter-spacing: 0.05em; margin-bottom: 0.5rem;">{{t 'customers.garage'}}</div>
    {{#if customer.garageId}}
      <div style="font-size: 1.1rem; font-weight: 700; color: #60a5fa; margin-bottom: 0.25rem;">
        🏢 {{customer.garageName}}
      </div>
      <div>
        <a href="/garages/{{customer.garageId}}" class="btn btn-secondary btn-sm" style="font-size: 0.75rem; padding: 2px 8px; margin-top: 0.25rem;">
          {{t 'garages.viewDashboard'}} &rarr;
        </a>
      </div>
    {{else}}
      <div style="color: var(--color-text-muted); font-size: 0.95rem;">{{t 'common.na'}}</div>
    {{/if}}
  </div>

  <div class="card" style="padding: 1.25rem;">
    <div style="font-size: 0.8rem; text-transform: uppercase; color: var(--color-text-muted); letter-spacing: 0.05em; margin-bottom: 0.5rem;">{{t 'customers.baselineMeter'}}</div>
    <div style="font-size: 1.25rem; font-weight: 700; color: #38bdf8; margin-bottom: 0.25rem;">{{bnNum customer.previousUnit}} {{t 'common.units'}}</div>
    <div style="color: var(--color-text-muted); font-size: 0.85rem;">{{t 'customers.initialMeter'}}</div>
  </div>

  <div class="card" style="padding: 1.25rem;">
    <div style="font-size: 0.8rem; text-transform: uppercase; color: var(--color-text-muted); letter-spacing: 0.05em; margin-bottom: 0.5rem;">{{t 'customers.advanceMoney'}}</div>
    <div style="font-size: 1.25rem; font-weight: 700; color: #10b981; margin-bottom: 0.25rem;">{{t 'common.currency'}}{{bnNum customer.advanceMoney}}</div>
    <div style="color: var(--color-text-muted); font-size: 0.85rem;">{{t 'customers.presentDues'}}: {{t 'common.currency'}}{{bnNum customer.presentDues}}</div>
  </div>
</div>

<div class="card" style="margin-bottom: 2rem; padding: 1.25rem;">
  <div style="font-size: 0.8rem; text-transform: uppercase; color: var(--color-text-muted); letter-spacing: 0.05em; margin-bottom: 0.25rem;">{{t 'customers.address'}}</div>
  <div style="font-size: 1rem; color: var(--color-text-primary);">{{customer.address}}</div>
</div>

<style>
  .doc-section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 1.15rem 1.4rem;
  }
  .doc-header-info {
    min-width: 0;
    flex: 1 1 auto;
  }
  .doc-header-title {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.35;
  }
  .doc-header-icon {
    font-size: 1.2rem;
    line-height: 1;
    display: inline-flex;
    align-items: center;
  }
  .doc-header-text {
    color: var(--color-text-primary, #ffffff);
  }
  .doc-header-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(99, 102, 241, 0.15);
    border: 1px solid rgba(99, 102, 241, 0.35);
    color: #818cf8;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 1px 7px;
    border-radius: 9999px;
    line-height: 1.2;
  }
  .doc-header-subtitle {
    color: var(--color-text-muted, #94a3b8);
    font-size: 0.82rem;
    margin: 0.25rem 0 0 0;
    line-height: 1.35;
  }
  .doc-header-upload-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    font-weight: 600;
    white-space: nowrap;
    transition: all 0.2s ease;
  }
  .doc-section-body {
    padding: 1.25rem;
    box-sizing: border-box;
  }

  @media (max-width: 576px) {
    .doc-section-header {
      padding: 0.85rem 0.85rem !important;
      flex-direction: column;
      align-items: stretch !important;
      gap: 0.75rem !important;
    }
    .doc-header-title {
      font-size: 0.95rem !important;
    }
    .doc-header-subtitle {
      font-size: 0.76rem !important;
    }
    .doc-header-upload-btn {
      width: 100% !important;
      height: 38px !important;
      font-size: 0.85rem !important;
      border-radius: var(--radius-md) !important;
    }
    .doc-section-body {
      padding: 0.75rem 0.85rem !important;
    }
    .modal-responsive-card {
      padding: 1.15rem 0.85rem !important;
    }
  }

  @media (max-width: 360px) {
    .doc-section-header {
      padding: 0.75rem 0.65rem !important;
    }
    .doc-section-body {
      padding: 0.65rem 0.65rem !important;
    }
    .doc-header-title {
      font-size: 0.88rem !important;
    }
  }

  [data-theme="light"] .doc-header-text {
    color: #0f172a;
  }
  [data-theme="light"] .doc-header-count {
    background: #e0e7ff;
    border-color: #c7d2fe;
    color: #4338ca;
  }
  [data-theme="light"] .doc-header-subtitle {
    color: #64748b;
  }
</style>

<!-- Customer Documents & Attachments Section -->
<div class="card doc-section-card" style="margin-bottom: 2rem;">
  <div class="card-header doc-section-header">
    <div class="doc-header-info">
      <h2 class="card-title doc-header-title">
        <span class="doc-header-icon">📁</span>
        <span class="doc-header-text">{{t 'documents.title'}}</span>
        {{#if customer.documents.length}}
          <span class="doc-header-count">({{bnNum customer.documents.length}})</span>
        {{/if}}
      </h2>
      <p class="doc-header-subtitle">{{t 'documents.subtitle'}}</p>
    </div>
    {{#if (or isSuperAdmin currentUser.canEdit currentUser.canCreate)}}
    <button type="button" class="btn btn-primary btn-sm doc-header-upload-btn" onclick="document.getElementById('uploadCustomerDocModal').style.display='flex'">
      <span>+</span> <span>{{t 'documents.upload'}}</span>
    </button>
    {{/if}}
  </div>

  <div class="card-body doc-section-body">
    {{> document-list documents=customer.documents deleteUrlPrefix=(concat "/customers/" customer.id "/documents") canDelete=(or isSuperAdmin currentUser.canDelete)}}
  </div>
</div>

<!-- Guarantors / জামিনদারবৃন্দ Section -->
<div class="card" style="margin-bottom: 2rem;">
  <div class="card-header doc-section-header">
    <div class="doc-header-info">
      <h2 class="card-title doc-header-title">
        <span class="doc-header-icon">🛡️</span>
        <span class="doc-header-text">{{t 'guarantors.title'}}</span>
        <span class="doc-header-count">({{bnNum customer.guarantors.length}})</span>
      </h2>
      <p class="doc-header-subtitle">{{t 'guarantors.subtitle'}}</p>
    </div>
    {{#if (or isSuperAdmin currentUser.canCreate)}}
    <button type="button" class="btn btn-primary btn-sm doc-header-upload-btn" onclick="document.getElementById('addGuarantorModal').style.display='flex'">
      <span>+</span> <span>{{t 'guarantors.add'}}</span>
    </button>
    {{/if}}
  </div>

  {{#if customer.guarantors.length}}
    <div class="card-body doc-section-body" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 1.25rem;">
      {{#each customer.guarantors}}
        <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 1.25rem; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.75rem;">
              <div>
                <div style="font-size: 1.1rem; font-weight: 700; color: var(--color-text-primary);">{{this.name}}</div>
                {{#if this.relationship}}
                  <span class="badge" style="background: rgba(99, 102, 241, 0.15); color: #818cf8; font-size: 0.75rem; margin-top: 0.25rem;">
                    {{this.relationship}}
                  </span>
                {{/if}}
              </div>
              <div class="table-actions-group">
                {{#if (or ../isSuperAdmin ../currentUser.canEdit)}}
                <a href="/customers/{{../customer.id}}/guarantors/{{this.id}}/edit" class="btn btn-secondary btn-icon-action" title="{{t 'common.edit'}}" aria-label="{{t 'common.edit'}}">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                </a>
                {{/if}}
                {{#if (or ../isSuperAdmin ../currentUser.canDelete)}}
                <form action="/customers/{{../customer.id}}/guarantors/{{this.id}}/delete" method="POST" style="display: inline;" onsubmit="return confirm('Remove this guarantor?');">
                  <button type="submit" class="btn btn-danger btn-icon-action" title="{{t 'common.delete'}}" aria-label="{{t 'common.delete'}}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                  </button>
                </form>
                {{/if}}
              </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 0.75rem; font-size: 0.85rem;">
              <div>
                <div style="color: var(--color-text-muted); font-size: 0.75rem; text-transform: uppercase;">{{t 'phones.title'}}</div>
                <div style="color: var(--color-text-secondary); font-weight: 600; display: flex; align-items: center; gap: 0.35rem; flex-wrap: wrap;">
                  <a href="tel:{{this.mobileNumber}}" style="color: #38bdf8; text-decoration: none;">📞 {{this.mobileNumber}}</a>
                  <span style="font-size: 0.65rem; color: #34d399; background: rgba(16, 185, 129, 0.15); padding: 1px 5px; border-radius: 8px;">{{t 'phones.primary'}}</span>
                </div>
                {{#if this.phoneNumbers}}
                  {{#if (gt this.phoneNumbers.length 1)}}
                    <div style="display: flex; flex-direction: column; gap: 0.2rem; margin-top: 0.35rem;">
                      {{#each this.phoneNumbers}}
                        {{#unless this.isPrimary}}
                          <div style="font-size: 0.75rem; display: flex; align-items: center; gap: 0.3rem;">
                            <a href="tel:{{this.number}}" style="color: var(--color-text-muted); text-decoration: none;">📞 {{this.number}}</a>
                            <span style="font-size: 0.65rem; color: var(--color-text-muted); background: rgba(255, 255, 255, 0.08); padding: 1px 4px; border-radius: 4px;">{{this.type}}</span>
                          </div>
                        {{/unless}}
                      {{/each}}
                    </div>
                  {{/if}}
                {{/if}}
              </div>
              <div>
                <div style="color: var(--color-text-muted); font-size: 0.75rem; text-transform: uppercase;">{{t 'guarantors.nid'}}</div>
                <code style="color: #93c5fd; font-size: 0.8rem;">{{this.nidNumber}}</code>
              </div>
              {{#if this.fatherName}}
              <div>
                <div style="color: var(--color-text-muted); font-size: 0.75rem; text-transform: uppercase;">{{t 'guarantors.fatherName'}}</div>
                <div style="color: var(--color-text-secondary);">{{this.fatherName}}</div>
              </div>
              {{/if}}
              {{#if this.motherName}}
              <div>
                <div style="color: var(--color-text-muted); font-size: 0.75rem; text-transform: uppercase;">{{t 'guarantors.motherName'}}</div>
                <div style="color: var(--color-text-secondary);">{{this.motherName}}</div>
              </div>
              {{/if}}
            </div>

            <div style="font-size: 0.85rem; border-top: 1px solid rgba(255, 255, 255, 0.05); padding-top: 0.5rem;">
              <span style="color: var(--color-text-muted); font-size: 0.75rem; text-transform: uppercase;">{{t 'guarantors.address'}}:</span>
              <span style="color: var(--color-text-secondary);"> {{this.address}}</span>
            </div>

            <div style="margin-top: 0.85rem; padding-top: 0.85rem; border-top: 1px solid rgba(255, 255, 255, 0.08);">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                <span style="color: var(--color-text-muted); font-size: 0.75rem; text-transform: uppercase; font-weight: 600;">
                  📎 {{t 'documents.title'}} {{#if this.documents.length}}({{bnNum this.documents.length}}){{/if}}
                </span>
                {{#if (or ../isSuperAdmin ../currentUser.canEdit)}}
                <button type="button" class="btn btn-secondary btn-sm" style="font-size: 0.72rem; padding: 2px 7px;" onclick="openGuarantorUploadModal('{{this.id}}', '{{this.name}}')">
                  + {{t 'documents.upload'}}
                </button>
                {{/if}}
              </div>
              {{> document-list documents=this.documents deleteUrlPrefix=(concat "/customers/" ../customer.id "/guarantors/" this.id "/documents") canDelete=(or ../isSuperAdmin ../currentUser.canDelete)}}
            </div>
          </div>
        </div>
      {{/each}}
    </div>
  {{else}}
    <div style="text-align: center; padding: 2.5rem 1rem;">
      <div style="font-size: 2rem; margin-bottom: 0.5rem;">🛡️</div>
      <h3 style="color: var(--color-text-primary); font-size: 1rem; font-weight: 600; margin-bottom: 0.25rem;">{{t 'guarantors.noGuarantors'}}</h3>
      <p style="color: var(--color-text-muted); font-size: 0.85rem; margin-bottom: 1rem;">{{t 'guarantors.noGuarantorsSub'}}</p>
      {{#if (or isSuperAdmin currentUser.canCreate)}}
      <button type="button" class="btn btn-primary btn-sm" onclick="document.getElementById('addGuarantorModal').style.display='flex'">
        + {{t 'guarantors.add'}}
      </button>
      {{/if}}
    </div>
  {{/if}}
</div>

<!-- Bills Date Filter Bar -->
<div class="card" style="padding: 1rem 1.25rem; margin-bottom: 1.5rem;" id="bills-filter">
  <!-- Mobile toggle -->
  <div class="dfb-mobile-toggle" onclick="toggleFilterDrawer('customerBillsFilter')">
    <span class="dfb-toggle-icon">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="4" y1="6" x2="20" y2="6"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="10" y1="18" x2="14" y2="18"/></svg>
    </span>
    <span class="dfb-toggle-label">
      {{#if isBn}}ফিল্টার ও তারিখ{{else}}Filter & Date{{/if}}
      {{#if (or fromDate toDate)}}<span class="dfb-active-dot"></span>{{/if}}
    </span>
    <svg class="dfb-toggle-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
  </div>

  <form id="customerBillsFilter" class="dfb-form dfb-collapse"
        method="GET" action="/customers/{{customer.id}}">
    <!-- From date -->
    <div class="dfb-group">
      <label class="dfb-label" for="cbFrom">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        {{#if isBn}}শুরু{{else}}From{{/if}}
      </label>
      <input type="date" id="cbFrom" name="fromDate" class="dfb-input" value="{{fromDate}}" onchange="clearPreset('customerBillsFilter')">
    </div>
    <!-- To date -->
    <div class="dfb-group">
      <label class="dfb-label" for="cbTo">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        {{#if isBn}}শেষ{{else}}To{{/if}}
      </label>
      <input type="date" id="cbTo" name="toDate" class="dfb-input" value="{{toDate}}" onchange="clearPreset('customerBillsFilter')">
    </div>
    <!-- Actions -->
    <div class="dfb-actions">
      <button type="submit" class="btn btn-primary dfb-btn">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        {{#if isBn}}ফিল্টার{{else}}Filter{{/if}}
      </button>
      {{#if (or fromDate toDate)}}
        <a id="cbReset" href="/customers/{{customer.id}}#bills-filter" class="btn btn-secondary dfb-btn" style="color: #ef4444;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          {{#if isBn}}রিসেট{{else}}Reset{{/if}}
        </a>
      {{/if}}
    </div>
    <!-- Preset Pills -->
    <div class="dfb-presets">
      <button type="button" class="dfb-preset-pill {{#if (eq preset 'today')}}dfb-preset-active{{/if}}"
              onclick="setDatePreset('today','customerBillsFilter')">{{#if isBn}}আজ{{else}}Today{{/if}}</button>
      <button type="button" class="dfb-preset-pill {{#if (eq preset 'thisMonth')}}dfb-preset-active{{/if}}"
              onclick="setDatePreset('thisMonth','customerBillsFilter')">{{#if isBn}}এই মাস{{else}}This Month{{/if}}</button>
      <button type="button" class="dfb-preset-pill {{#if (eq preset 'lastMonth')}}dfb-preset-active{{/if}}"
              onclick="setDatePreset('lastMonth','customerBillsFilter')">{{#if isBn}}গত মাস{{else}}Last Month{{/if}}</button>
      <button type="button" class="dfb-preset-pill {{#if (eq preset 'last30')}}dfb-preset-active{{/if}}"
              onclick="setDatePreset('last30','customerBillsFilter')">{{#if isBn}}শেষ ৩০ দিন{{else}}Last 30 Days{{/if}}</button>
      <button type="button" class="dfb-preset-pill {{#if (eq preset 'thisYear')}}dfb-preset-active{{/if}}"
              onclick="setDatePreset('thisYear','customerBillsFilter')">{{#if isBn}}এই বছর{{else}}This Year{{/if}}</button>
      <button type="button" class="dfb-preset-pill {{#if (eq preset 'all')}}dfb-preset-active{{/if}}"
              onclick="setDatePreset('all','customerBillsFilter')">{{#if isBn}}সব{{else}}All Time{{/if}}</button>
    </div>
    <input type="hidden" name="preset" id="customerBillsFilter_preset" value="{{preset}}">
  </form>

  {{#if (or fromDate toDate)}}
    <div style="margin-top: 0.75rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem; font-size: 0.8rem; color: var(--color-text-muted); border-top: 1px solid var(--color-border); padding-top: 0.75rem;">
      <div style="display: flex; align-items: center; gap: 0.5rem;">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span>
          {{#if isBn}}ফিল্টার করা বিল: {{else}}Filtered bills: {{/if}}
          <strong style="color: var(--color-text-primary);">{{bnNum totalFilteredBillsCount}}</strong>
          {{#if fromDate}}&nbsp;·&nbsp;{{#if isBn}}থেকে{{else}}From{{/if}} <strong>{{fromDate}}</strong>{{/if}}
          {{#if toDate}}&nbsp;·&nbsp;{{#if isBn}}পর্যন্ত{{else}}To{{/if}} <strong>{{toDate}}</strong>{{/if}}
        </span>
      </div>
      <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
        <span>{{#if isBn}}ব্যবহৃত ইউনিট: {{else}}Units: {{/if}}<strong style="color: #38bdf8;">{{bnNum periodSummary.units}} {{t 'common.unitShort'}}</strong></span>
        <span>{{#if isBn}}মোট বিল: {{else}}Total Billed: {{/if}}<strong style="color: #818cf8;">{{t 'common.currency'}}{{bnNum periodSummary.billed}}</strong></span>
        <span>{{#if isBn}}পরিশোধিত: {{else}}Paid: {{/if}}<strong style="color: #10b981;">{{t 'common.currency'}}{{bnNum periodSummary.paid}}</strong></span>
      </div>
    </div>
  {{/if}}
</div>

{{#if (or fromDate toDate)}}
<script>
  (function() {
    if (window.location.search && window.location.search.includes('Date')) {
      const el = document.getElementById('bills-filter');
      if (el) {
        setTimeout(function() {
          el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 100);
      }
    }
  })();
</script>
{{/if}}

<!-- Bills Ledger Table -->
<div class="card" id="bills-section">
  <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
    <div style="display: flex; align-items: center; gap: 0.65rem;">
      <h2 class="card-title" style="margin: 0;">{{t 'bills.title'}} ({{bnNum bills.length}})</h2>
      {{#if (or fromDate toDate)}}
        <span class="badge" style="background: rgba(56, 189, 248, 0.15); color: #38bdf8; font-size: 0.75rem; padding: 2px 8px; border-radius: 12px;">
          {{#if isBn}}ফিল্টার সক্রিয়{{else}}Filter Active{{/if}}
        </span>
      {{/if}}
    </div>
    {{#if (or isSuperAdmin currentUser.canCreate)}}
      <a href="/bills/new?customerId={{customer.id}}" class="btn btn-primary btn-sm" style="background: #10b981; border-color: #10b981;">
        + {{t 'bills.newBill'}}
      </a>
    {{/if}}
  </div>

  {{#if bills.length}}
    <div class="table-scroll-hint">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="8 18 2 12 8 6"/><polyline points="16 6 22 12 16 18"/></svg>
      <span>{{#if isBn}}সম্পূর্ণ বিবরণ দেখতে ডানে স্ক্রোল করুন{{else}}Scroll horizontally to view all{{/if}}</span>
    </div>
    <div class="table-responsive">
      <table class="data-table table-dense">
        <thead>
          <tr>
            <th>{{t 'common.date'}}</th>
            <th>{{t 'bills.prevUnit'}}</th>
            <th>{{t 'bills.currUnit'}}</th>
            <th>{{t 'bills.consumed'}}</th>
            <th>{{t 'bills.electricBill'}} ({{t 'common.currency'}})</th>
            <th>{{t 'bills.prevDues'}} ({{t 'common.currency'}})</th>
            <th>{{t 'bills.rent'}} ({{t 'common.currency'}})</th>
            <th>{{t 'bills.loan'}} ({{t 'common.currency'}})</th>
            <th>{{t 'bills.totalBill'}} ({{t 'common.currency'}})</th>
            <th>{{t 'bills.paid'}} ({{t 'common.currency'}})</th>
            <th>{{t 'bills.presentDues'}} ({{t 'common.currency'}})</th>
            <th style="text-align: right;">{{t 'common.actions'}}</th>
          </tr>
        </thead>
        <tbody>
          {{#each bills}}
            <tr>
              <td>{{tDate this.date}}</td>
              <td>{{bnNum this.previousUnit}}</td>
              <td><strong>{{bnNum this.currentUnit}}</strong></td>
              <td><span class="badge" style="background: rgba(56, 189, 248, 0.15); color: #38bdf8;">{{bnNum this.totalUnit}} {{t 'common.unitShort'}}</span></td>
              <td>{{t 'common.currency'}}{{bnNum this.electricBill}}</td>
              <td>{{t 'common.currency'}}{{bnNum this.previousDues}}</td>
              <td>{{t 'common.currency'}}{{bnNum this.rentBill}}</td>
              <td>{{t 'common.currency'}}{{bnNum this.loan}}</td>
              <td><strong>{{t 'common.currency'}}{{bnNum this.totalBill}}</strong></td>
              <td style="color: #10b981; font-weight: 600;">{{t 'common.currency'}}{{bnNum this.clearMoney}}</td>
              <td>
                <span style="font-weight: 700; {{#if (ne this.presentDues 0)}}color: #ef4444;{{else}}color: #10b981;{{/if}}">
                  {{t 'common.currency'}}{{bnNum this.presentDues}}
                </span>
              </td>
              <td style="text-align: right;">
                <div class="table-actions-group">
                  <a href="/bills/{{this.id}}" class="btn btn-secondary btn-icon-action" title="{{t 'bills.receipt'}}" aria-label="{{t 'bills.receipt'}}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                  </a>
                  {{#if (or ../isSuperAdmin ../currentUser.canEdit)}}
                  <a href="/bills/{{this.id}}/edit" class="btn btn-secondary btn-icon-action" title="{{t 'common.edit'}}" aria-label="{{t 'common.edit'}}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                  </a>
                  {{/if}}
                </div>
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  {{else}}
    <div style="text-align: center; padding: 3rem 1rem;">
      <div style="font-size: 2.5rem; margin-bottom: 0.75rem;">⚡</div>
      {{#if (or fromDate toDate)}}
        <h3 style="color: var(--color-text-primary); font-size: 1.15rem; font-weight: 600; margin-bottom: 0.5rem;">
          {{#if isBn}}নির্বাচিত সময়সীমার মধ্যে কোনো বিল পাওয়া যায়নি{{else}}No bills found for the selected date range{{/if}}
        </h3>
        <p style="color: var(--color-text-muted); margin-bottom: 1.5rem;">
          {{#if isBn}}তারিখ পরিবর্তন করুন অথবা ফিল্টার রিসেট করুন।{{else}}Try adjusting the dates or reset the filter.{{/if}}
        </p>
        <a href="/customers/{{customer.id}}#bills-filter" class="btn btn-secondary">
          {{#if isBn}}ফিল্টার রিসেট করুন{{else}}Reset Filter{{/if}}
        </a>
      {{else}}
        <h3 style="color: var(--color-text-primary); font-size: 1.15rem; font-weight: 600; margin-bottom: 0.5rem;">{{t 'bills.noBills'}}</h3>
        <p style="color: var(--color-text-muted); margin-bottom: 1.5rem;">{{t 'bills.noBillsSub'}}</p>
        {{#if (or isSuperAdmin currentUser.canCreate)}}
        <a href="/bills/new?customerId={{customer.id}}" class="btn btn-primary" style="background: #10b981; border-color: #10b981;">{{t 'bills.newBill'}}</a>
        {{/if}}
      {{/if}}
    </div>
  {{/if}}
</div>

<!-- Add Guarantor Modal -->
<style>
  @media (max-width: 576px) {
    #addGuarantorModal {
      padding: 0.5rem !important;
    }
    #addGuarantorModal .guarantor-modal-card {
      padding: 1.15rem 0.85rem !important;
      max-height: 94vh !important;
    }
  }
</style>
<div id="addGuarantorModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.7); backdrop-filter: blur(4px); z-index: 9999; align-items: center; justify-content: center; padding: 1rem;">
  <div class="card guarantor-modal-card" style="max-width: 650px; width: 100%; max-height: 90vh; overflow-y: auto; padding: 1.75rem; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5);">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 1px solid var(--color-border); padding-bottom: 0.75rem;">
      <h3 style="margin: 0; font-size: 1.25rem; font-weight: 700; color: #fff;">+ {{t 'guarantors.add'}}</h3>
      <button type="button" onclick="document.getElementById('addGuarantorModal').style.display='none'" style="background: transparent; border: none; color: var(--color-text-muted); font-size: 1.5rem; cursor: pointer; line-height: 1;">&times;</button>
    </div>
    <form action="/customers/{{customer.id}}/guarantors" method="POST">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1rem;">
        <div class="form-group">
          <label class="form-label" for="gName">{{t 'guarantors.name'}} *</label>
          <input type="text" id="gName" name="name" class="form-input" required placeholder="Full Name">
        </div>
        <div class="form-group">
          <label class="form-label" for="gRelationship">{{t 'guarantors.relationship'}}</label>
          <input type="text" id="gRelationship" name="relationship" class="form-input" placeholder="e.g. Father, Brother, Relative, Friend">
        </div>
        <div class="form-group" style="grid-column: 1 / -1;">
          {{> phone-repeater containerId="guarantorPhonesModal" primaryFieldName="mobileNumber" jsonFieldName="phoneNumbersJson" required=true}}
        </div>
        <div class="form-group">
          <label class="form-label" for="gNid">{{t 'guarantors.nid'}} *</label>
          <input type="text" id="gNid" name="nidNumber" class="form-input" required placeholder="National ID Number">
        </div>
        <div class="form-group">
          <label class="form-label" for="gFather">{{t 'guarantors.fatherName'}}</label>
          <input type="text" id="gFather" name="fatherName" class="form-input" placeholder="Father's Name">
        </div>
        <div class="form-group">
          <label class="form-label" for="gMother">{{t 'guarantors.motherName'}}</label>
          <input type="text" id="gMother" name="motherName" class="form-input" placeholder="Mother's Name">
        </div>
        <div class="form-group" style="grid-column: 1 / -1;">
          <label class="form-label" for="gAddress">{{t 'guarantors.address'}} *</label>
          <textarea id="gAddress" name="address" class="form-input" rows="2" required placeholder="Guarantor residential or business address..."></textarea>
        </div>
      </div>
      <div style="display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 1.5rem;">
        <button type="button" class="btn btn-secondary" onclick="document.getElementById('addGuarantorModal').style.display='none'">{{t 'common.cancel'}}</button>
        <button type="submit" class="btn btn-primary">{{t 'guarantors.save'}}</button>
      </div>
    </form>
  </div>
</div>

<!-- Upload Customer Document Modal -->
<div id="uploadCustomerDocModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.75); backdrop-filter: blur(4px); z-index: 9999; align-items: center; justify-content: center; padding: 1rem;">
  <div class="card modal-responsive-card" style="max-width: 580px; width: 100%; max-height: 90vh; overflow-y: auto; padding: 1.75rem; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5); border-top: 3px solid #38bdf8;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 1px solid var(--color-border); padding-bottom: 0.75rem;">
      <h3 style="margin: 0; font-size: 1.15rem; font-weight: 700; color: #fff; display: flex; align-items: center; gap: 0.5rem;">
        <span>📤</span> {{t 'documents.uploadNew'}}
      </h3>
      <button type="button" onclick="document.getElementById('uploadCustomerDocModal').style.display='none'" style="background: transparent; border: none; color: var(--color-text-muted); font-size: 1.5rem; cursor: pointer; line-height: 1;">&times;</button>
    </div>
