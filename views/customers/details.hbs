  </div>
</div>

<script>
  function openGuarantorUploadModal(guarantorId, guarantorName) {
    const form = document.getElementById('guarantorUploadForm');
    const nameSpan = document.getElementById('guarantorModalTargetName');
    if (form) {
      form.action = '/customers/{{customer.id}}/guarantors/' + guarantorId + '/documents';
    }
    if (nameSpan) {
      nameSpan.textContent = guarantorName || '';
    }
    const modal = document.getElementById('uploadGuarantorDocModal');
    if (modal) {
      modal.style.display = 'flex';
    }
  }

  function triggerCustomerSuspendModal(formId) {
    const targetFormId = formId || 'suspendCustomerHeaderForm';
    const form = document.getElementById(targetFormId);
    if (typeof window.showConfirmModal !== 'function') {
      if (confirm('{{t "customers.confirmSuspend"}}')) {
        if (form) form.submit();
      }
      return;
    }

    window.showConfirmModal({
      title: "{{t 'customers.suspendModalTitle'}}",
      desc: "{{t 'customers.suspendModalDesc'}}",
      type: 'warning',
      icon: '⚠️',
      targetName: {{{json customer.name}}},
      targetSub: "{{#if customer.customerCode}}ID: {{customer.customerCode}} &bull; {{/if}}System #{{#if customer.cId}}{{bnNum customer.cId}}{{else}}{{bnNum customer.id}}{{/if}}",
      targetBadgeText: "{{t 'customers.active'}}",
      targetBadgeClass: "badge-success",
      calloutText: "{{t 'customers.suspendModalWarning'}}",
      calloutIcon: "⚠️",
      cancelText: "{{t 'common.cancel'}}",
      submitText: "{{t 'customers.suspendModalBtn'}}",
      submitBtnClass: "btn-warning",
      onConfirm: function() {
        if (form) form.submit();
      }
    });
  }

  function triggerCustomerReactivateModal(formId) {
    const targetFormId = formId || 'reactivateCustomerHeaderForm';
    const form = document.getElementById(targetFormId);
    if (typeof window.showConfirmModal !== 'function') {
      if (confirm('{{t "customers.confirmReactivate"}}')) {
        if (form) form.submit();
      }
      return;
    }

    window.showConfirmModal({
      title: "{{t 'customers.reactivateModalTitle'}}",
      desc: "{{t 'customers.reactivateModalDesc'}}",
      type: 'success',
      icon: '⚡',
      targetName: {{{json customer.name}}},
      targetSub: "{{#if customer.customerCode}}ID: {{customer.customerCode}} &bull; {{/if}}System #{{#if customer.cId}}{{bnNum customer.cId}}{{else}}{{bnNum customer.id}}{{/if}}",
      targetBadgeText: "{{t 'customers.suspended'}}",
      targetBadgeClass: "badge-danger",
      calloutText: "{{t 'customers.reactivateModalNotice'}}",
      calloutIcon: "✨",
      cancelText: "{{t 'common.cancel'}}",
      submitText: "{{t 'customers.reactivateModalBtn'}}",
      submitBtnClass: "btn-success",
      onConfirm: function() {
        if (form) form.submit();
      }
    });
  }
</script>
