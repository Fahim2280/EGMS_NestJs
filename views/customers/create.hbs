<div class="page-header" style="margin-bottom: 1.5rem;">
  <div class="header-content">
    <a href="/customers" style="color: var(--color-text-muted); text-decoration: none; font-size: 0.85rem; display: inline-flex; align-items: center; gap: 0.35rem; margin-bottom: 0.5rem; transition: color 0.15s ease;">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
      {{t 'common.back'}}
    </a>
    <h1 class="page-title" style="display: flex; align-items: center; gap: 0.65rem;">
      <span style="display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 10px; background: rgba(99, 102, 241, 0.15); color: #818cf8;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
      </span>
      {{t 'customers.createTitle'}}
    </h1>
    <p class="page-subtitle">{{t 'customers.createSubtitle'}}</p>
  </div>
</div>

{{#if error}}
  <div style="background: rgba(239, 68, 68, 0.12); border: 1px solid rgba(239, 68, 68, 0.25); border-radius: 10px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; color: #f87171; font-size: 0.9rem; display: flex; align-items: center; gap: 0.75rem;">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    <span>{{error}}</span>
  </div>
{{/if}}

<div class="customer-create-grid" style="display: grid; grid-template-columns: 1.25fr 0.75fr; gap: 1.75rem; align-items: start; max-width: 1100px; margin: 0 auto;">
  <!-- Form Column -->
  <div class="card" style="padding: 1.75rem; border-top: 3px solid #6366f1; margin-bottom: 0;">
    <form action="/customers" method="POST">
      <!-- Section 1: Facility & Identification -->
      <div style="margin-bottom: 1.75rem;">
        <div class="form-section-title" style="margin-bottom: 1.25rem;">
          <span class="section-icon-badge">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </span>
          Facility &amp; Identity Profile
        </div>

        <div class="form-group" style="margin-bottom: 1.25rem;">
          <label class="form-label" for="garageId">
            <span>{{t 'customers.garage'}} <span style="color: #f43f5e;">*</span></span>
          </label>
          <select id="garageId" name="garageId" class="form-input" required>
            <option value="" disabled {{#unless selectedGarageId}}selected{{/unless}}>{{t 'common.selectGarage'}}</option>
            {{#each garages}}
              <option value="{{this.id}}" data-subtext="{{this.address}}" {{#if (eq this.id ../selectedGarageId)}}selected{{/if}}>
                🏢 {{this.garageName}}
              </option>
            {{/each}}
          </select>
          <span class="form-hint">Assign the client to their physical garage branch for access scoping.</span>
        </div>

        <div class="form-grid-2" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.25rem;">
          <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label" for="name">
              <span>{{t 'customers.name'}} <span style="color: #f43f5e;">*</span></span>
            </label>
            <input type="text" id="name" name="name" class="form-input" required placeholder="e.g. Mohammad Rahim" value="{{formData.name}}">
          </div>

          <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label" for="mobileNumber">
              <span>{{t 'customers.mobile'}} <span style="color: #f43f5e;">*</span></span>
            </label>
            <input type="tel" id="mobileNumber" name="mobileNumber" class="form-input" required placeholder="e.g. 01712345678" value="{{formData.mobileNumber}}">
          </div>
        </div>

        <div class="form-grid-2" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.25rem;">
          <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label" for="fatherName">{{t 'customers.fatherName'}}</label>
            <input type="text" id="fatherName" name="fatherName" class="form-input" placeholder="Father's full name" value="{{formData.fatherName}}">
          </div>

          <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label" for="motherName">{{t 'customers.motherName'}}</label>
            <input type="text" id="motherName" name="motherName" class="form-input" placeholder="Mother's full name" value="{{formData.motherName}}">
          </div>
        </div>

        <div class="form-group" style="margin-bottom: 0;">
          <label class="form-label" for="nidNumber">
            <span>{{t 'customers.nid'}} <span style="color: #f43f5e;">*</span></span>
          </label>
          <input type="text" id="nidNumber" name="nidNumber" class="form-input" required placeholder="e.g. 19901234567890123" value="{{formData.nidNumber}}">
          <span class="form-hint">National identification number (smart NID or 10/17-digit card).</span>
        </div>

        <div class="form-group" style="margin-bottom: 0; margin-top: 1.25rem;">
          <label class="form-label" for="customerCode">
            <span>Customer ID <span style="color: var(--color-text-muted); font-size: 0.8rem; font-weight: 400;">(optional)</span></span>
          </label>
          <div style="display: flex; gap: 0.5rem; align-items: center;">
            <input type="text" id="customerCode" name="customerCode" class="form-input" placeholder="e.g. CUST-001" value="{{#if formData.customerCode}}{{formData.customerCode}}{{else}}{{nextCustomerCode}}{{/if}}" maxlength="50" autocomplete="off">
            <span id="codeStatus" style="font-size: 0.8rem; white-space: nowrap;"></span>
          </div>
          <span class="form-hint">Unique ID you assign (e.g. CUST-001). Deleted customers free up their ID for reuse.</span>
        </div>
      </div>

      <!-- Section 2: Premises & Electricity Setup -->
      <div style="margin-bottom: 1.5rem;">
        <div class="form-section-title" style="margin-bottom: 1.25rem;">
          <span class="section-icon-badge" style="background: rgba(16, 185, 129, 0.15); color: #34d399;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          </span>
          Premises &amp; Electricity Metering
        </div>

        <div class="form-group" style="margin-bottom: 1.25rem;">
          <label class="form-label" for="address">
            <span>{{t 'customers.address'}} <span style="color: #f43f5e;">*</span></span>
          </label>
          <textarea id="address" name="address" class="form-input" rows="2" required placeholder="Full facility, shop, or stall address details...">{{formData.address}}</textarea>
        </div>

        <div class="form-grid-2" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
          <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label" for="previousUnit">
              <span>{{t 'customers.baselineMeter'}} <span style="color: #f43f5e;">*</span></span>
            </label>
            <input type="number" step="0.01" min="0" id="previousUnit" name="previousUnit" class="form-input" required placeholder="0.00" value="{{#if formData.previousUnit}}{{formData.previousUnit}}{{else}}0.00{{/if}}">
            <span class="form-hint">Physical meter reading starting point.</span>
          </div>

          <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label" for="advanceMoney">
              <span>{{t 'customers.advanceMoney'}} (৳) <span style="color: #f43f5e;">*</span></span>
            </label>
            <input type="number" step="0.01" id="advanceMoney" name="advanceMoney" class="form-input" required placeholder="0.00" value="{{#if formData.advanceMoney}}{{formData.advanceMoney}}{{else}}0.00{{/if}}">
            <span class="form-hint">Security deposit or opening balance credit.</span>
          </div>
        </div>
      </div>

      <div class="form-actions" style="margin-top: 2rem; display: flex; gap: 0.75rem; justify-content: flex-end; align-items: center;">
        <a href="/customers" class="btn btn-secondary" style="padding: 0.65rem 1.25rem;">{{t 'common.cancel'}}</a>
        <button type="submit" class="btn btn-primary" style="padding: 0.65rem 1.5rem; display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 700; box-shadow: 0 4px 16px rgba(99, 102, 241, 0.35);">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          {{t 'customers.saveCustomer'}}
        </button>
      </div>
    </form>
  </div>

  <!-- Guidelines & Tips Sidebar -->
  <div class="customer-create-sidebar" style="position: sticky; top: 84px;">
    <div class="card" style="padding: 1.5rem; border-top: 3px solid #38bdf8; background: radial-gradient(circle at top right, rgba(56, 189, 248, 0.08), transparent 70%), rgba(30, 41, 59, 0.85);">
      <h3 style="font-size: 1rem; font-weight: 700; color: #ffffff; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
        Registration Notes
      </h3>

      <div style="display: flex; flex-direction: column; gap: 1rem; font-size: 0.84rem; color: #94a3b8; line-height: 1.5;">
        <div style="display: flex; gap: 0.75rem; align-items: flex-start;">
          <div style="width: 24px; height: 24px; border-radius: 6px; background: rgba(56, 189, 248, 0.15); color: #38bdf8; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 0.75rem; font-weight: 700;">1</div>
          <div>
            <strong style="color: #f1f5f9;">Garage Access Isolation:</strong>
            Employees with permissions only for the selected garage facility will be able to manage this client's bills.
          </div>
        </div>

        <div style="display: flex; gap: 0.75rem; align-items: flex-start;">
          <div style="width: 24px; height: 24px; border-radius: 6px; background: rgba(16, 185, 129, 0.15); color: #34d399; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 0.75rem; font-weight: 700;">2</div>
          <div>
            <strong style="color: #f1f5f9;">Baseline Metering:</strong>
            The baseline unit is non-destructive and establishes the starting point for calculating monthly consumption on the initial bill.
          </div>
        </div>

        <div style="display: flex; gap: 0.75rem; align-items: flex-start;">
          <div style="width: 24px; height: 24px; border-radius: 6px; background: rgba(168, 85, 247, 0.15); color: #c084fc; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 0.75rem; font-weight: 700;">3</div>
          <div>
            <strong style="color: #f1f5f9;">Guarantors (জামিনদার):</strong>
            After registering this client, you can add multiple legal guarantors with full parental and contact credentials directly from their profile page.
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    const input = document.getElementById('customerCode');
    const status = document.getElementById('codeStatus');
    if (!input || !status) return;

    let timer;
    input.addEventListener('input', function() {
      clearTimeout(timer);
      const val = this.value.trim();
      if (!val) {
        status.innerHTML = '';
        return;
      }
      status.innerHTML = '<span style="color: var(--color-text-muted); font-size: 0.75rem;">checking...</span>';
      timer = setTimeout(async () => {
        try {
          const url = `/customers/check-code?code=${encodeURIComponent(val)}`;
          const res = await fetch(url);
          const data = await res.json();
          if (data.available) {
            status.innerHTML = '<span style="color: #10b981; font-weight: 600; font-size: 0.8rem;">✓ Available</span>';
          } else {
            status.innerHTML = '<span style="color: #f43f5e; font-weight: 600; font-size: 0.8rem;">✕ In use</span>';
          }
        } catch (e) {
          status.innerHTML = '';
        }
      }, 350);
    });
  })();
</script>
