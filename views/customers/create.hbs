<div class="page-header">
  <div class="header-content">
    <a href="/customers" style="color: var(--color-text-muted); text-decoration: none; font-size: 0.875rem; display: inline-flex; align-items: center; gap: 0.25rem; margin-bottom: 0.5rem;">
      &larr; {{t 'common.back'}}
    </a>
    <h1 class="page-title">{{t 'customers.createTitle'}}</h1>
    <p class="page-subtitle">{{t 'customers.createSubtitle'}}</p>
  </div>
</div>

<div class="card" style="max-width: 800px; margin: 0 auto;">
  {{#if error}}
    <div style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 8px; padding: 1rem; margin-bottom: 1.5rem; color: #ef4444; font-size: 0.9rem;">
      {{error}}
    </div>
  {{/if}}

  <form action="/customers" method="POST">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
      <div class="form-group" style="grid-column: 1 / -1;">
        <label class="form-label" for="garageId">{{t 'customers.garage'}} *</label>
        <select id="garageId" name="garageId" class="form-input" required>
          <option value="" disabled {{#unless selectedGarageId}}selected{{/unless}}>{{t 'common.selectGarage'}}</option>
          {{#each garages}}
            <option value="{{this.id}}" {{#if (eq this.id ../selectedGarageId)}}selected{{/if}}>
              {{this.garageName}} ({{this.address}})
            </option>
          {{/each}}
        </select>
        <span style="font-size: 0.75rem; color: var(--color-text-muted);">Required: Each customer must be associated with exactly one garage facility.</span>
      </div>

      <div class="form-group">
        <label class="form-label" for="name">{{t 'customers.name'}} *</label>
        <input type="text" id="name" name="name" class="form-input" required placeholder="e.g. Mohammad Rahim" value="{{formData.name}}">
      </div>

      <div class="form-group">
        <label class="form-label" for="mobileNumber">{{t 'customers.mobile'}} *</label>
        <input type="tel" id="mobileNumber" name="mobileNumber" class="form-input" required placeholder="e.g. 01712345678" value="{{formData.mobileNumber}}">
      </div>

      <div class="form-group">
        <label class="form-label" for="fatherName">{{t 'customers.fatherName'}}</label>
        <input type="text" id="fatherName" name="fatherName" class="form-input" placeholder="Father's full name" value="{{formData.fatherName}}">
      </div>

      <div class="form-group">
        <label class="form-label" for="motherName">{{t 'customers.motherName'}}</label>
        <input type="text" id="motherName" name="motherName" class="form-input" placeholder="Mother's full name" value="{{formData.motherName}}">
      </div>

      <div class="form-group" style="grid-column: 1 / -1;">
        <label class="form-label" for="nidNumber">{{t 'customers.nid'}} *</label>
        <input type="text" id="nidNumber" name="nidNumber" class="form-input" required placeholder="e.g. 19901234567890123" value="{{formData.nidNumber}}">
        <span style="font-size: 0.75rem; color: var(--color-text-muted);">Must be unique across your garage client accounts.</span>
      </div>

      <div class="form-group" style="grid-column: 1 / -1;">
        <label class="form-label" for="address">{{t 'customers.address'}} *</label>
        <textarea id="address" name="address" class="form-input" rows="2" required placeholder="Enter full address details...">{{formData.address}}</textarea>
      </div>

      <div class="form-group">
        <label class="form-label" for="previousUnit">{{t 'customers.baselineMeter'}} *</label>
        <input type="number" step="0.01" min="0" id="previousUnit" name="previousUnit" class="form-input" required placeholder="0.00" value="{{#if formData.previousUnit}}{{formData.previousUnit}}{{else}}0.00{{/if}}">
        <span style="font-size: 0.75rem; color: var(--color-text-muted);">Baseline meter reading at customer onboarding.</span>
      </div>

      <div class="form-group">
        <label class="form-label" for="advanceMoney">{{t 'customers.advanceMoney'}} (৳) *</label>
        <input type="number" step="0.01" id="advanceMoney" name="advanceMoney" class="form-input" required placeholder="0.00" value="{{#if formData.advanceMoney}}{{formData.advanceMoney}}{{else}}0.00{{/if}}">
        <span style="font-size: 0.75rem; color: var(--color-text-muted);">Security deposit held or initial previous dues baseline.</span>
      </div>
    </div>

    <div class="form-actions" style="margin-top: 2rem; display: flex; gap: 0.75rem; justify-content: flex-end; flex-wrap: wrap;">
      <a href="/customers" class="btn btn-secondary">{{t 'common.cancel'}}</a>
      <button type="submit" class="btn btn-primary">{{t 'customers.saveCustomer'}}</button>
    </div>
  </form>
</div>
