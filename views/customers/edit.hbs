<div class="page-header" style="margin-bottom: 1.5rem;">
  <div class="header-content">
    <a href="/customers/{{customer.id}}" style="color: var(--color-text-muted); text-decoration: none; font-size: 0.85rem; display: inline-flex; align-items: center; gap: 0.35rem; margin-bottom: 0.5rem; transition: color 0.15s ease;">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
      {{t 'common.back'}}
    </a>
    <h1 class="page-title" style="display: flex; align-items: center; gap: 0.65rem;">
      <span style="display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 10px; background: rgba(99, 102, 241, 0.15); color: #818cf8;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
      </span>
      {{t 'customers.editTitle'}}
    </h1>
    <p class="page-subtitle">{{t 'customers.createSubtitle'}}</p>
  </div>
</div>

<div class="card" style="max-width: 860px; margin: 0 auto; padding: 2rem; border-top: 3px solid #6366f1;">
  {{#if error}}
    <div id="topErrorAlert" {{#if isGarageSuspended}}data-garage-error="true"{{/if}} style="background: rgba(239, 68, 68, 0.12); border: 1px solid rgba(239, 68, 68, 0.25); border-radius: 10px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; color: #f87171; font-size: 0.9rem; display: flex; align-items: center; gap: 0.75rem;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      <span>{{t error}}</span>
    </div>
  {{/if}}

  <form id="customerEditForm" action="/customers/{{customer.id}}/edit" method="POST" enctype="multipart/form-data">
    <!-- Section 1: Facility & Identification -->
    <div style="margin-bottom: 1.75rem;">
      <div class="form-section-title" style="margin-bottom: 1.25rem;">
        <span class="section-icon-badge">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </span>
        {{t 'customers.facilityAndProfile'}}
      </div>

      {{> profile-avatar-uploader avatarId="customerAvatar" fieldName="avatarFile" initialPhotoUrl=(profilePicUrl customer) initialInitials=(firstChar customer.name) title=(t 'profile.picture') hint=(t 'profile.pictureHint')}}

      <div class="form-group" style="margin-bottom: 1.25rem;">
        <label class="form-label" for="garageId">
          <span>{{t 'customers.garage'}} <span style="color: #f43f5e;">*</span></span>
        </label>
        <select id="garageId" name="garageId" class="form-input" required onchange="handleGarageChange()">
          <option value="" disabled>{{t 'common.selectGarage'}}</option>
          {{#each garages}}
            <option value="{{this.id}}" data-subtext="{{this.address}}" data-active="{{this.isActive}}" {{#if (eq this.id ../selectedGarageId)}}selected{{else}}{{#unless this.isActive}}disabled style="color: #ef4444;"{{/unless}}{{/if}}>
              🏢 {{this.garageName}} {{#unless this.isActive}} [🚫 {{t 'garages.suspended'}}]{{/unless}}
            </option>
          {{/each}}
        </select>
        <div id="garageSuspendedWarning" style="display: none; margin-top: 0.75rem; background: rgba(239, 68, 68, 0.12); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 8px; padding: 0.75rem 1rem; color: #f87171; font-size: 0.88rem; align-items: center; gap: 0.5rem;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink: 0;"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
          <div>
            <strong>{{t 'garages.suspendedNoticeShort'}}:</strong> {{t 'msg.garageSuspendedCustomerBlocked'}}
          </div>
        </div>
        <span class="form-hint">{{t 'customers.garageBranchManageHint'}}</span>
      </div>

      <div class="form-group" style="margin-bottom: 1.25rem;">
        <label class="form-label" for="name">
          <span>{{t 'customers.name'}} <span style="color: #f43f5e;">*</span></span>
        </label>
        <input type="text" id="name" name="name" class="form-input" required value="{{customer.name}}">
      </div>

      {{> phone-repeater containerId="customerPhones" primaryFieldName="mobileNumber" primaryValue=customer.mobileNumber jsonFieldName="phoneNumbersJson" initialPhones=(resolvePhones customer.phoneNumbers customer.mobileNumber) required=true}}

      <div class="form-grid-2" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.25rem;">
        <div class="form-group" style="margin-bottom: 0;">
          <label class="form-label" for="fatherName">{{t 'customers.fatherName'}}</label>
          <input type="text" id="fatherName" name="fatherName" class="form-input" value="{{customer.fatherName}}">
        </div>

        <div class="form-group" style="margin-bottom: 0;">
          <label class="form-label" for="motherName">{{t 'customers.motherName'}}</label>
          <input type="text" id="motherName" name="motherName" class="form-input" value="{{customer.motherName}}">
        </div>
      </div>

      <div class="form-group" style="margin-bottom: 0;">
        <label class="form-label" for="nidNumber">
          <span>{{t 'customers.nid'}} <span style="color: #f43f5e;">*</span></span>
        </label>
        <input type="text" id="nidNumber" name="nidNumber" class="form-input" required value="{{customer.nidNumber}}">
      </div>

      <div class="form-group" style="margin-bottom: 0; margin-top: 1.25rem;">
        <label class="form-label" for="customerCode">
          <span>{{t 'customers.code'}} <span style="color: var(--color-text-muted); font-size: 0.8rem; font-weight: 400;">({{#if isBn}}ঐচ্ছিক{{else}}optional{{/if}})</span></span>
        </label>
        <div style="display: flex; gap: 0.5rem; align-items: center;">
          <input type="text" id="customerCode" name="customerCode" class="form-input" placeholder="e.g. CUST-001" value="{{customer.customerCode}}" maxlength="50" autocomplete="off" data-exclude="{{customer.id}}">
          <span id="codeStatus" style="font-size: 0.8rem; white-space: nowrap;"></span>
        </div>
        <span class="form-hint">{{#if isBn}}গ্রাহকের জন্য নির্ধারিত আইডি। খালি রাখতে পারেন। কোডটি অন্য গ্রাহকের না হলে পরিবর্তনযোগ্য।{{else}}Unique ID you assign. Leave blank to skip. Changing it is allowed as long as the new code is not taken.{{/if}}</span>
      </div>
    </div>

    <!-- Section 2: Address & Metering -->
    <div style="margin-bottom: 1.5rem;">
      <div class="form-section-title" style="margin-bottom: 1.25rem;">
        <span class="section-icon-badge" style="background: rgba(16, 185, 129, 0.15); color: #34d399;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
        </span>
        {{t 'customers.premisesAndMeter'}}
      </div>

      <div class="form-group" style="margin-bottom: 1.25rem;">
        <label class="form-label" for="address">
          <span>{{t 'customers.address'}} <span style="color: #f43f5e;">*</span></span>
        </label>
        <textarea id="address" name="address" class="form-input" rows="2" required>{{customer.address}}</textarea>
      </div>

      <div class="form-grid-2" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <div class="form-group" style="margin-bottom: 0;">
          <label class="form-label" for="previousUnit">
            <span>{{t 'customers.baselineMeter'}} <span style="color: #f43f5e;">*</span></span>
          </label>
          <input type="number" step="0.01" min="0" id="previousUnit" name="previousUnit" class="form-input" required value="{{customer.previousUnit}}">
        </div>

        <div class="form-group" style="margin-bottom: 0;">
          <label class="form-label" for="advanceMoney">
            <span>{{t 'customers.advanceMoney'}} (৳) <span style="color: #f43f5e;">*</span></span>
          </label>
          <input type="number" step="0.01" id="advanceMoney" name="advanceMoney" class="form-input" required value="{{customer.advanceMoney}}">
        </div>
      </div>
    </div>

    <!-- Section 3: Documents & Attachments -->
    <div style="margin-bottom: 1.5rem;">
      <div class="form-section-title" style="margin-bottom: 1.25rem;">
        <span class="section-icon-badge" style="background: rgba(56, 189, 248, 0.15); color: #38bdf8;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
        </span>
        {{t 'documents.title'}}
      </div>

      {{#if customer.documents.length}}
        <div style="margin-bottom: 1.25rem;">
          <div style="font-size: 0.8rem; text-transform: uppercase; color: var(--color-text-muted); margin-bottom: 0.5rem; font-weight: 600;">
            {{t 'documents.title'}} ({{bnNum customer.documents.length}})
          </div>
          {{> document-list documents=customer.documents deleteUrlPrefix=(concat "/customers/" customer.id "/documents") canDelete=true}}
        </div>
      {{/if}}

      <div class="form-group" style="margin-bottom: 1rem;">
        <label class="form-label" for="editCustDocType">{{t 'documents.documentType'}}</label>
        <select id="editCustDocType" name="documentType" class="form-input">
          <option value="GENERAL">{{t 'documents.typeGeneral'}}</option>
          <option value="NID">{{t 'documents.typeNid'}}</option>
          <option value="PASSPORT">{{t 'documents.typePassport'}}</option>
          <option value="AGREEMENT">{{t 'documents.typeAgreement'}}</option>
          <option value="ELECTRICITY_BILL">{{t 'documents.typeElectricityBill'}}</option>
          <option value="TRADE_LICENSE">{{t 'documents.typeTradeLicense'}}</option>
          <option value="PHOTO">{{t 'documents.typePhoto'}}</option>
          <option value="OTHER">{{t 'documents.typeOther'}}</option>
        </select>
      </div>

      {{> file-uploader uploaderId="custEditDocs" fieldName="files" maxFiles=10 label=(t 'documents.uploadNew')}}
    </div>

    <div class="form-actions" style="margin-top: 2rem; display: flex; gap: 0.75rem; justify-content: flex-end; align-items: center;">
      <a href="/customers/{{customer.id}}" class="btn btn-secondary" style="padding: 0.65rem 1.25rem;">{{t 'common.cancel'}}</a>
      <button type="submit" id="updateCustomerBtn" form="customerEditForm" class="btn btn-primary" style="padding: 0.65rem 1.5rem; display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 700; box-shadow: 0 4px 16px rgba(99, 102, 241, 0.35);">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        {{t 'customers.updateProfile'}}
      </button>
    </div>
  </form>
</div>

<script>
  const originalGarageId = "{{customer.garageId}}";

  function handleGarageChange() {
    const select = document.getElementById('garageId');
    const warning = document.getElementById('garageSuspendedWarning');
    const topAlert = document.getElementById('topErrorAlert');
    const submitBtn = document.getElementById('updateCustomerBtn');
    if (!select) return;
    const selectedOption = select.options[select.selectedIndex];
    const isSuspended = selectedOption && (selectedOption.getAttribute('data-active') === 'false' || selectedOption.disabled);

    // If changing to a different garage and that garage is suspended, block update
    if (isSuspended && select.value !== originalGarageId) {
      if (warning) warning.style.display = 'flex';
      if (topAlert && topAlert.getAttribute('data-garage-error') === 'true') {
        topAlert.style.display = 'flex';
      }
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.style.opacity = '0.5';
        submitBtn.style.cursor = 'not-allowed';
        submitBtn.title = "{{t 'msg.garageSuspendedCustomerBlocked'}}";
      }
    } else {
      if (warning) warning.style.display = 'none';
      if (topAlert && topAlert.getAttribute('data-garage-error') === 'true') {
        topAlert.style.display = 'none';
      }
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.style.opacity = '1';
        submitBtn.style.cursor = 'pointer';
        submitBtn.title = '';
      }
    }
  }

  document.addEventListener('DOMContentLoaded', function() {
    handleGarageChange();
  });

  (function() {
    const input = document.getElementById('customerCode');
    const status = document.getElementById('codeStatus');
    if (!input || !status) return;

    let timer;
    const exclude = input.dataset.exclude || '';

    input.addEventListener('input', function() {
      clearTimeout(timer);
      const val = this.value.trim();
      if (!val) {
        status.innerHTML = '';
        return;
      }
      status.innerHTML = '<span style="color: var(--color-text-muted); font-size: 0.75rem;">{{t "customers.checking"}}</span>';
      timer = setTimeout(async () => {
        try {
          const url = `/customers/check-code?code=${encodeURIComponent(val)}${exclude ? '&exclude=' + encodeURIComponent(exclude) : ''}`;
          const res = await fetch(url);
          const data = await res.json();
          if (data.available) {
            status.innerHTML = '<span style="color: #10b981; font-weight: 600; font-size: 0.8rem;">{{t "customers.codeAvailable"}}</span>';
          } else {
            status.innerHTML = '<span style="color: #f43f5e; font-weight: 600; font-size: 0.8rem;">{{t "customers.codeInUse"}}</span>';
          }
        } catch (e) {
          status.innerHTML = '';
        }
      }, 350);
    });
  })();
</script>
